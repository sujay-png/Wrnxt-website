<script>
  function p() {
    document.querySelectorAll<HTMLElement>("[data-reel-nav]").forEach((e) => {
      if (e.dataset.reelNavBound) return;
      e.dataset.reelNavBound = "1";
      const c = e.dataset.reelId;
      if (!c) return;
      const t = document.getElementById(c);
      const n = e.querySelector<HTMLButtonElement>("[data-reel-prev]");
      const o = e.querySelector<HTMLButtonElement>("[data-reel-next]");
      if (!t || !n || !o) return;

      const d = () => {
        const s = t.firstElementChild as HTMLElement;
        return s
          ? s.offsetWidth + (parseFloat(getComputedStyle(t).gap) || 0)
          : t.clientWidth;
      };

      const i = () => {
        n.disabled = t.scrollLeft <= 0;
        o.disabled = t.scrollLeft >= t.scrollWidth - t.clientWidth - 1;
        const s = t.scrollWidth - t.clientWidth;
        const a = s > 0 ? (t.scrollLeft / s) * 100 : 0;
        if ((e as any)._x_dataStack) {
          (e as any)._x_dataStack[0].progress = Math.min(100, Math.max(0, a));
        }
      };

      let r: number | undefined;
      const m = (s: number) => {
        const a = t.scrollLeft;
        const S = t.scrollWidth - t.clientWidth;
        const f = Math.min(Math.max(s, 0), S) - a;
        if (f === 0) return;
        if (r !== undefined) cancelAnimationFrame(r);
        t.classList.add("is-animating");
        const g = 250;
        let l: number | undefined;
        const u = (h: number) => {
          if (l === undefined) l = h;
          const L = Math.min((h - l) / g, 1);
          const v = 1 - Math.pow(1 - L, 1.5);
          t.scrollLeft = a + f * v;
          i();
          if (L < 1) {
            r = requestAnimationFrame(u);
          } else {
            t.classList.remove("is-animating");
            r = undefined;
          }
        };
        r = requestAnimationFrame(u);
      };

      n.addEventListener("click", () => m(t.scrollLeft - d()));
      o.addEventListener("click", () => m(t.scrollLeft + d()));
      t.addEventListener("scroll", i);
      setTimeout(i, 100);
    });
  }

  p();
  document.addEventListener("astro:page-load", p);

  function unlockScroll() {
    document.documentElement.style.overflow = "";
  }
  document.addEventListener("astro:page-load", unlockScroll);
  if (
    document.readyState === "complete" ||
    document.readyState === "interactive"
  ) {
    unlockScroll();
  } else {
    document.addEventListener("DOMContentLoaded", unlockScroll);
  }
</script>

<style lang="scss">
  main {
    position: relative;
    z-index: 1;
  }

  // Dark card theme, scoped to this block only. Overriding the design
  // tokens locally means every rule below that already reads
  // var(--color-bg) / var(--color-border) / var(--color-foreground)
  // picks up the dark palette automatically, without needing a global
  // theme change.
  .ProjectCarouselBlock {
    --color-bg: #0d0d0d;
    --color-foreground: #f5f5f3;
    --color-border: rgba(255, 255, 255, 0.14);
    --color-muted: #a8a7a1;
    --card-bg: #17181a;
    --card-bg-hover: #1e2022;
    --accent-start: #e2792e;
    --accent-end: #f2c14e;

    padding-top: calc(var(--space-3xl) + 5rem);
    padding-bottom: var(--space-2xl);
    background-color: var(--color-bg);
    color: var(--color-foreground);
    overflow: hidden;
  }

  .carousel-header {
    margin-bottom: var(--space-2xl);
  }

  .carousel-header .heading {
    font-family: var(--font-family-heading);
    font-weight: 300;
    letter-spacing: -0.01em;
  }

  .progress-bar {
    position: relative;
    width: 200px;
    height: 3px;
    background: var(--color-border);
    border-radius: 999px;
    overflow: hidden;

    @media (max-width: 767px) {
      width: 100%;
    }
  }

  .progress-fill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    background: linear-gradient(90deg, var(--accent-start), var(--accent-end));
    box-shadow: 0 0 8px rgba(226, 121, 46, 0.5);
    border-radius: 999px;
    transition: width 0.1s ease-out;
  }

  .carousel-nav {
    display: flex;
    align-items: center;
    gap: var(--space-md);

    @media (max-width: 767px) {
      width: 100%;
      display: grid;
      grid-template-columns: auto 1fr auto;
    }

    .btn.icon-only {
      border-radius: 999px;
      border: 1px solid var(--color-border);
      background: transparent;
      color: var(--color-foreground);
      transition:
        background 0.2s ease,
        border-color 0.2s ease;

      &:hover:not(:disabled) {
        background: rgba(255, 255, 255, 0.08);
        border-color: rgba(255, 255, 255, 0.3);
      }

      &:disabled {
        opacity: 0.35;
        cursor: default;
      }
    }
  }

  .reel {
    --_offset: calc(
      (
          (
              100% -
                (
                  min(var(--container-max-width, 110rem), 100%) +
                    (var(--container-padding, var(--space-md-lg)) * 2)
                )
            ) /
            2
        ) +
        (var(--container-padding, var(--space-md-lg)) * 2)
    );
    display: flex;
    flex-wrap: nowrap;
    gap: var(--space-3xl);
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-inline: var(--_offset);
    scroll-padding-inline-start: var(--_offset);

    @media (max-width: 767px) {
      gap: var(--space-lg);
    }

    &::-webkit-scrollbar {
      display: none;
    }

    &.is-animating {
      scroll-snap-type: none !important;
    }
  }

  .item {
    flex: 0 0 auto;
    scroll-snap-align: start;
    scroll-snap-stop: always;

    @media (max-width: 767px) {
      max-width: 90%;
      gap: var(--space-lg);
    }

    .logo {
      max-width: clamp(6.25rem, 4.3321vw + 5.2347rem, 10rem) !important;
    }

    .logoCard {
      margin-bottom: var(--space-sm);
    }

    .content {
      width: 35ch;
      flex-shrink: 0;
      background: var(--card-bg);
      border-radius: 1.25em;
      transition:
        background 0.2s ease,
        transform 0.2s ease;

      &:hover {
        background: var(--card-bg-hover);
        transform: translateY(-2px);
      }

      @media (max-width: 767px) {
        flex-basis: 60%;
        flex-grow: 1;
