  <script type="module">
    document.addEventListener("alpine:init", () => {
      Alpine.data("reactiveDivider", ({ orientation: i, unit: t }) => ({
        dimension: 0,
        orientation: i,
        resizeObserver: null,
        init() {
          (this.measure(),
            (this.resizeObserver = new ResizeObserver((e) => {
              for (const s of e) {
                const n = s.contentRect;
                this.updateDimension(n);
              }
            })),
            this.resizeObserver.observe(this.$refs.dividerLine));
        },
        measure() {
          const e = this.$refs.dividerLine.getBoundingClientRect();
          this.updateDimension(e);
        },
        updateDimension(e) {
          this.dimension =
            this.orientation === "horizontal" ? e.width : e.height;
        },
        get formattedWidth() {
          return `${Math.round(this.dimension)}${t}`;
        },
        destroy() {
          this.resizeObserver && this.resizeObserver.disconnect();
        },
      }));
      Alpine.data("buttonHover", () => ({
        bgX: 50,
        bgY: 50,
        isHovering: false,
        handleMouseMove(event) {
          const rect = event.currentTarget.getBoundingClientRect();
          this.bgX = ((event.clientX - rect.left) / rect.width) * 100;
          this.bgY = ((event.clientY - rect.top) / rect.height) * 100;
        },
        handleMouseEnter() {
          this.isHovering = true;
        },
        handleMouseLeave() {
          this.isHovering = false;
        },
      }));
    });
