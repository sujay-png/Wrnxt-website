---
import { ClientRouter } from 'astro:transitions';
import "../styles/globals.scss";
import "lenis/dist/lenis.css";

interface Props {
	title?: string;
	description?: string;
}

const { 
  title = "Web and brand design agency • Creative Digital Agency • Akshara Digital",
  description = "Affordable & Quality IT Solutions Guaranteed. We provide logical & beautiful design capabilities with value by seamlessly integrating as your creative team."
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
    
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" />
		<meta name="apple-mobile-web-app-title" content="Akshara Digital Creative" />
		<meta name="generator" content={Astro.generator} />
		
		<title>{title}</title>
		<meta name="description" content={description} />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://salo.uk/" />
		<meta property="og:title" content="Web and brand design agency • Creative Digital Agency" />
		<meta property="og:description" content={description} />
		
		<!-- Twitter -->
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content="Web and brand design agency • Creative Digital Agency" />
		<meta name="twitter:description" content={description} />
    
   <script is:inline>
  const isMobile = window.matchMedia(
    "(max-width: 768px)"
  ).matches;

  if (!isMobile) {
    document.documentElement.style.overflow = "hidden";
  } else {
    document.documentElement.style.overflow = "auto";
  }

  window.addEventListener("pageshow", function (event) {
    if (event.persisted) {
      document.documentElement.style.overflow =
        isMobile ? "auto" : "hidden";
    }
  });
</script>
    <ClientRouter />
	</head>
	<body data-color-scheme="dark">
		<div id="mobile-menu-portal" transition:persist="mobile-menu-portal"></div>
		
		<slot />

  <script>
  import Alpine from "alpinejs";
  import Lenis from "lenis";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import gsap from "gsap";

  declare global {
    interface Window {
      __alpineInitialized?: boolean;
      __lenisInitialized?: boolean;
      __lenis?: any;
      Alpine?: any;
    }
  }

  gsap.registerPlugin(ScrollTrigger);

  // Alpine
  if (!window.__alpineInitialized) {
    window.__alpineInitialized = true;

    Alpine.data("buttonHover", () => ({
      isHovering: false,
      mouseX: 0,
      mouseY: 0,
      bgX: 75,
      bgY: 75,
      raf: null as number | null,

      handleMouseMove(e: MouseEvent) {
        if (!this.isHovering) return;

        const target = e.currentTarget as HTMLElement;
        const rect = target.getBoundingClientRect();

        this.mouseX =
          ((e.clientX - rect.left) / rect.width) * 100;

        this.mouseY =
          ((e.clientY - rect.top) / rect.height) * 100;

        if (this.raf) cancelAnimationFrame(this.raf);

        this.raf = requestAnimationFrame(() => {
          this.bgX = this.mouseX;
          this.bgY = this.mouseY;
        });
      },

      handleMouseEnter() {
        this.isHovering = true;
      },

      handleMouseLeave() {
        this.isHovering = false;
      },
    }));

    // Page-specific components are registered here rather than in their own component scripts:
    // alpine:init only fires once, and after a ClientRouter navigation a component's script runs
    // after Alpine has already initialised the new markup, leaving these x-data names undefined.
    Alpine.data("reactiveDivider", ({ orientation, unit }: { orientation: string; unit: string }) => ({
      dimension: 0,
      orientation: orientation,
      resizeObserver: null as ResizeObserver | null,
      init() {
        this.measure();
        this.resizeObserver = new ResizeObserver((entries) => {
          for (const entry of entries) {
            this.updateDimension(entry.contentRect);
          }
        });
        if ((this as any).$refs.dividerLine) {
          this.resizeObserver.observe((this as any).$refs.dividerLine);
        }
      },
      measure() {
        if ((this as any).$refs.dividerLine) {
          this.updateDimension((this as any).$refs.dividerLine.getBoundingClientRect());
        }
      },
      updateDimension(rect: DOMRectReadOnly) {
        this.dimension =
          this.orientation === "horizontal" ? rect.width : rect.height;
      },
      get formattedWidth() {
        return `${Math.round(this.dimension)}${unit}`;
      },
      destroy() {
        this.resizeObserver?.disconnect();
      },
    }));

    Alpine.data("teamSpotlight", (team: any[]) => ({
      team,
      active: 0,
      switching: false,
      get current() {
        return this.team[this.active];
      },
      select(idx: number) {
        if (idx === this.active) return;
        // A plain CSS-transitioned class (toggled via `switching`, see the
        // .AboutTeamGrid__spotlight.is-switching rule in AboutTeam.astro) instead of a GSAP tween —
        // GSAP's onComplete on this opacity/filter combo wasn't reliably firing, which left the
        // active-state update never running. A plain setTimeout guarantees the swap always happens.
        this.switching = true;
        setTimeout(() => {
          this.active = idx;
          this.switching = false;
        }, 220);

        // Keep the spotlight panel in view when picking someone further down the grid on smaller
        // viewports where the two columns stack.
        const panel = document.querySelector('.AboutTeamGrid__spotlight');
        if (panel && window.matchMedia('(max-width: 1023px)').matches) {
          panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      },
    }));

    window.Alpine = Alpine;
    Alpine.start();
  }

  // Mobile check
  const isMobile = window.matchMedia("(max-width: 768px)").matches;

  // Enable Lenis only on desktop
  if (!isMobile && !window.__lenisInitialized) {
    window.__lenisInitialized = true;

    const lenis = new Lenis({
      duration: 1.2,
      easing: (t) =>
        Math.min(1, 1.001 - Math.pow(2, -10 * t)),
    });

    window.__lenis = lenis;

    lenis.on("scroll", ScrollTrigger.update);

    gsap.ticker.add((time) => {
      lenis.raf(time * 1000);
    });

    gsap.ticker.lagSmoothing(0);
  }

  // Restore normal mobile scrolling
  if (isMobile) {
    document.documentElement.style.overflow = "auto";
    document.body.style.overflow = "auto";
    document.documentElement.style.scrollBehavior = "auto";
  }

  document.addEventListener("astro:after-swap", () => {
    if (window.__lenis && !isMobile) {
      window.__lenis.scrollTo(0, {
        immediate: true,
      });
    }
  });

  document.addEventListener("astro:page-load", () => {
    if (window.Alpine) {
      try {
        if (typeof window.Alpine.discover === 'function') {
          window.Alpine.discover();
        } else if (typeof window.Alpine.initTree === 'function') {
          window.Alpine.initTree(document.body);
        }
      } catch (e) {
        console.warn("Alpine re-init error:", e);
      }
    }

    if (window.__lenis && !isMobile) {
      window.__lenis.scrollTo(0, {
        immediate: true,
      });
    }

    document.documentElement.style.overflow = "auto";
    document.body.style.overflow = "auto";

    ScrollTrigger.refresh();

    // Fix for mobile: recalculate ScrollTrigger when images load and change body height
    const ro = new ResizeObserver(() => {
      ScrollTrigger.refresh();
    });
    ro.observe(document.body);

    // Clean up observer on page transition
    document.addEventListener("astro:before-preparation", () => {
      ro.disconnect();
    }, { once: true });

    window.dispatchEvent(
      new CustomEvent("lenis:ready")
    );
  });
</script>
	</body>
</html>
