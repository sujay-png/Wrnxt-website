 ---
const stacks = [
  {
    category: "Frontend",
    icon: "◆",
    tools: ["Next.js", "Astro", "Tailwind CSS", "TypeScript", "UI/UX Design"],
  },
  {
    category: "Mobile",
    icon: "◈",
    tools: ["Flutter", "React Native", "Swift", "Kotlin", "Expo", "Firebase"],
  },
  {
    category: "Backend",
    icon: "◇",
    tools: ["Node.js", "PostgreSQL", "MongoDB"],
  },
  {
    category: "Cloud & DevOps",
    icon: "◉",
    tools: ["AWS", "Vercel", "Docker", "GitHub Actions", "Nginx", "Cloudflare"],
  },
];
---
<section class="tech-section" aria-labelledby="technology-heading">
  <div class="tech-section__inner">
    <header class="tech-intro">
      <div>
        <p class="tech-eyebrow">Technology</p>
        <h2 id="technology-heading" class="tech-heading">The right tool<br />for the work.</h2>
      </div>
      <p class="tech-body">
        We choose established technology that keeps products dependable, maintainable, and ready to grow with your business.
      </p>
    </header>

    <ol class="tech-ledger">
      {stacks.map((stack, index) => (
        <li class="tech-ledger__row">
          <span class="tech-ledger__number">{String(index + 1).padStart(2, '0')}</span>
          <h3>{stack.category}</h3>
          <ul class="tech-ledger__tools" aria-label={`${stack.category} tools`}>
            {stack.tools.map((tool) => <li>{tool}</li>)}
          </ul>
        </li>
      ))}
    </ol>
  </div>
</section>

<style lang="scss">
.tech-section {
  border-top: 1px solid var(--color-border);
  border-bottom: 1px solid var(--color-border);
  background: var(--color-bg);
  position: relative;
  overflow: hidden;
}

.tech-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(100px);
  pointer-events: none;
  z-index: 0;
}

.tech-glow--1 {
  width: 420px;
  height: 420px;
  top: -140px;
  left: -80px;
  background: radial-gradient(circle, rgba(156, 8, 39, 0.12), transparent 70%);
}

.tech-glow--2 {
  width: 380px;
  height: 380px;
  bottom: -160px;
  right: -60px;
  background: radial-gradient(circle, rgba(107, 3, 24, 0.1), transparent 70%);
}

.tech-section__inner {
  position: relative;
  z-index: 1;
  padding: 100px 80px;
  max-width: 1200px;
  margin: 0 auto;



  @media (max-width: 900px) {
    padding: 60px var(--space-md);
  }
}

.tech-section__header {
  max-width: 480px;
  margin-bottom: 56px;
}

.tech-eyebrow {
  font-size: var(--font-size--1);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-foreground-secondary);
  margin-bottom: 12px;
  display: flex;
  align-items: center;
  gap: 8px;

  &::before {
    content: '';
    width: 24px;
    height: 1px;
    background: linear-gradient(90deg, #9c0827, rgba(156, 8, 39, 0.3));
  }
}

.tech-heading {
  font-size: clamp(2rem, 3.5vw, 3rem);
  font-weight: var(--font-weight-normal);
  line-height: 1.08;
  letter-spacing: var(--letter-spacing-tight);
  color: var(--color-foreground);
  margin-bottom: 16px;

  .highlight {
    background: linear-gradient(120deg, #e0163f, #9c0827 60%, #e0163f);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
}

.tech-body {
  font-size: var(--font-size--1);
  line-height: 1.7;
  color: var(--color-foreground-secondary);
  max-width: 42ch;
}

.tech-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;

  @media (max-width: 900px) {
    grid-template-columns: repeat(2, 1fr);
  }

  @media (max-width: 500px) {
    grid-template-columns: 1fr;
  }
}
.tech-card {
  position: relative;
  padding: 36px 32px;
  border-radius: 16px;
  border: 1px solid rgba(255, 255, 255, 0.04);
  background: rgba(255, 255, 255, 0.015);
  transition: all 0.4s ease;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.tech-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(156, 8, 39, 0), transparent);
  transition: all 0.4s ease;
}

.tech-card:hover {
  background: rgba(255, 255, 255, 0.03);
  border-color: rgba(156, 8, 39, 0.15);
  transform: translateY(-4px);
  box-shadow: 0 12px 40px -12px rgba(0, 0, 0, 0.6);
}

.tech-card:hover::before {
  background: linear-gradient(90deg, transparent, rgba(224, 22, 63, 0.8), transparent);
}

.tech-card__border {
  display: none;
}

.tech-card__head {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 28px;
}

.tech-card__icon {
  width: 34px;
  height: 34px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  font-size: 14px;
  background: rgba(156, 8, 39, 0.08);
  color: #e0163f;
  transition: background 0.3s ease, color 0.3s ease;
}

.tech-card:hover .tech-card__icon {
  background: rgba(156, 8, 39, 0.15);
  color: #ff2a55;
}

.tech-card__category {
  font-size: 13px;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.9);
  margin: 0;
}

.tech-card__tools {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.tech-card__tool {
  font-size: 12px;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.5);
  padding: 6px 12px;
  border-radius: 6px;
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid rgba(255, 255, 255, 0.04);
  transition: all 0.3s ease;
}

.tech-card:hover .tech-card__tool {
  color: rgba(255, 255, 255, 0.7);
  background: rgba(255, 255, 255, 0.04);
  border-color: rgba(255, 255, 255, 0.08);
}

.tech-card__tool:hover {
  background: rgba(156, 8, 39, 0.15) !important;
  border-color: rgba(156, 8, 39, 0.4) !important;
  color: #fff !important;
}

/* The technology section is intentionally restrained: it reads as a capability list,
   rather than a collection of dashboard cards. */
.tech-section {
  background: linear-gradient(110deg, #111 0%, #0d0d0d 58%, #120d0f 100%);
}

.tech-section__inner {
  max-width: 1120px;
  padding: clamp(4.5rem, 9vw, 8rem) clamp(1.25rem, 5vw, 5rem);
}

.tech-intro {
  display: grid;
  grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.9fr);
  gap: clamp(2rem, 8vw, 8rem);
  align-items: end;
  margin-bottom: clamp(3rem, 6vw, 5rem);
}

.tech-eyebrow {
  display: block;
  margin: 0 0 1.25rem;
  color: var(--color-burgundy);
  font-size: .72rem;
  font-weight: 600;
  letter-spacing: .16em;
}

.tech-eyebrow::before { display: none; }

.tech-heading {
  max-width: 12ch;
  margin: 0;
  font-size: clamp(2.4rem, 5vw, 4.6rem);
  font-weight: 400;
  line-height: .98;
}

.tech-body {
  max-width: 38ch;
  margin: 0 0 .35rem;
  font-size: clamp(1rem, 1.4vw, 1.15rem);
  line-height: 1.65;
}

.tech-ledger {
  list-style: none;
  padding: 0;
  margin: 0;
  border-top: 1px solid var(--color-border);
}

.tech-ledger__row {
  display: grid;
  grid-template-columns: 4rem minmax(9rem, .7fr) minmax(0, 1.7fr);
  gap: 1.5rem;
  align-items: baseline;
  padding: clamp(1.5rem, 3vw, 2.25rem) 0;
  border-bottom: 1px solid var(--color-border);
  transition: background-color .2s ease, padding-inline .2s ease;
}

.tech-ledger__row:hover {
  background: rgba(156, 8, 39, .06);
  padding-inline: 1rem;
}

.tech-ledger__number {
  color: var(--color-burgundy);
  font-family: var(--font-family-alt);
  font-size: .78rem;
  letter-spacing: .08em;
}

.tech-ledger h3 {
  margin: 0;
  color: var(--color-foreground);
  font-family: var(--font-family-heading);
  font-size: clamp(1.25rem, 2vw, 1.65rem);
  font-weight: 400;
}

.tech-ledger__tools {
  display: flex;
  flex-wrap: wrap;
  gap: .55rem 1.2rem;
  list-style: none;
  padding: 0;
  margin: 0;
}

.tech-ledger__tools li {
  color: var(--color-foreground-secondary);
  font-size: .95rem;
  line-height: 1.5;
}

.tech-ledger__tools li:not(:last-child)::after {
  content: '·';
  position: relative;
  left: .65rem;
  color: var(--color-burgundy);
}

@media (max-width: 700px) {
  .tech-intro { grid-template-columns: 1fr; gap: 1.25rem; }
  .tech-ledger__row { grid-template-columns: 2.5rem 1fr; gap: .5rem 1rem; }
  .tech-ledger__tools { grid-column: 2; margin-top: .5rem; }
  .tech-ledger__row:hover { padding-inline: .5rem; }
}
</style>
