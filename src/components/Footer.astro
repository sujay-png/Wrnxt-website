---
const accreditations = [
  {
    name: "Agency Hackers",
    url: "https://salo.uk/_astro/accreditation-agency-hackers.CskRe8_T.png",
  },
  {
    name: "BIMA",
    url: "https://salo.uk/_astro/accreditation-bima.DOjLsDfZ.png",
  },
  { name: "Net", url: "https://salo.uk/_astro/accreditation-net.De0nr0fC.png" },
  {
    name: "Alliance of Independent Agencies",
    url: "https://salo.uk/_astro/accreditation-aia.B3ALZq9Y.png",
  },
];
---

<footer class="section footer" data-pt="lg">
  <div class="container" data-size="full">
    <div class="stack" data-gap="3xl">
      <!-- Top Section: Logo & Direct Contacts -->
      <div class="footer__top">
        <div class="start">
          <a href="/" title="Go home.">
            <img
              class="footer__topLogo salo-logo"
              transition:name="salo-logo"
              src="/images/wrnxt_logo-removebg-preview.png"
              alt="WRNXT Logo"
            />
          </a>
          <span class="eyebrow"
            >Exceptional design, seamless collaboration.</span
          >
        </div>

        <div class="end footer__contact">
          <a href="mailto:md@wrnxt.com">md@wrnxt.com</a>
          <a href="tel:+91 8123455500">+91 8123455500</a>
        </div>
      </div>

      <!-- Middle Section: Link Lists & Accreditations -->
      <div class="stack footer__middle" data-gap="xl">
        <div
          class="cluster"
          data-gap="lg"
          data-justify="between"
          data-align="start"
        >
          <div class="grid start" style="--grid-min:20rem;">
            <div class="column">
              <ul class="stack footer-menu" data-gap="xs">
                <li class="eyebrow">Our services</li>
                <li class="footer-menu-item">
                  <a class="footer-menu-link" href="/services/ITServices"
                    >IT Service</a
                  >
                </li>
                <li class="footer-menu-item">
                  <a class="footer-menu-link" href="/services/website"
                    >Media House</a
                  >
                </li>
                <li class="footer-menu-item">
                  <a class="footer-menu-link" href="/services/branding"
                    >Markerting</a
                  >
                </li>
                <li class="footer-menu-item">
                  <a class="footer-menu-link" href="/services/flexi-design
                  "
                    >Hardware</a
                  >
                </li>
              </ul>
            </div>

            <nav class="column">
              <ul class="stack footer-menu" data-gap="xs">
                <li class="eyebrow">Useful links</li>
                <li class="footer-menu-item">
                  <a class="footer-menu-link" href="/projects/"
                    >Latest case studies</a
                  >
                </li>
                <li class="footer-menu-item">
                  <a class="footer-menu-link" href="/contact">Contact us</a>
                </li>
              </ul>
            </nav>
          </div>

          <!-- Accreditations Badges -->
          <div class="end">
            <div class="accreditations">
              {
                accreditations.map((badge) => (
                  <div class="accreditation">
                    <img
                      src={badge.url}
                      alt={badge.name}
                      loading="lazy"
                      width="120"
                      height="80"
                      class="accreditation-image"
                    />
                  </div>
                ))
              }
            </div>
          </div>
        </div>

        <!-- Copyright Row -->
        <div class="copyright">
          <div
            class="cluster"
            data-gap-x="lg"
            data-gap-y="sm"
            data-justify="start"
            data-align="center"
          >
            <span>© 2026 Wrnxt. All rights reserved.</span>
            <a href="/environmental-sustainability/"
              >Environmental Sustainability</a
            >
            <a href="/privacy">Privacy Policy</a>
            <a href="/ai-policy">AI Policy</a>
          </div>
        </div>
      </div>

      <!-- Section Divider -->
      <div
        class="reactive-divider horizontal"
        x-data="reactiveDivider({ orientation: 'horizontal', unit: 'px' })"
      >
        <div class="anchor start-anchor"><div class="anchor-circle"></div></div>
        <div class="divider-line" x-ref="dividerLine">
          <div class="width-display" x-text="formattedWidth" x-cloak>0px</div>
        </div>
        <div class="anchor end-anchor"><div class="anchor-circle"></div></div>
      </div>
    </div>
  </div>

  <!-- Bottom Cropped Logo watermark moved outside container so S is not cut off by padding -->
  <!-- <div class="footer__bottom" id="footer-bottom-logo">
  <svg class="footer__bottomLogo salo-logo" viewBox="0 0 800 100" xmlns="http://www.w3.org/2000/svg" aria-label="WRNXT Logo.">
    <text x="0" y="80" font-family="var(--font-family-alt)" font-weight="700" font-size="100" fill="white">WRNXT</text>
  </svg>
</div> -->
</footer>

<style lang="scss">
  .footer {
    position: relative;
    z-index: 2;
    border-top: 1px solid var(--color-border);
    background-color: var(--color-bg);
    color: var(--color-foreground-secondary);
    padding-block-start: var(--space-xl);

    /*
      SPACING FIX: The container uses data-size="full" which removes padding-inline.
      We restore it directly on the footer's inner stack so all content is
      properly inset from the viewport edges — matching salo.uk's layout.
    */
    > .container > .stack {
      padding-inline: var(--container-padding, var(--space-md-2xl));
    }

    a {
      transition: color 0.3s var(--ease);

      &:hover {
        color: var(--color-foreground);
      }
    }

    &__top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: var(--space-lg);
      border-bottom: 1px solid var(--color-border);
      padding-bottom: var(--space-md);

      @media (max-width: 1023px) {
        align-items: flex-end;
      }

      @media (max-width: 767px) {
        flex-direction: column;
        align-items: flex-start;
      }

      .start {
        display: flex;
        align-items: center;
        gap: var(--space-md);

        @media (max-width: 1023px) {
          flex-direction: column;
          align-items: flex-start;
          gap: var(--space-xs);
        }
      }
    }

    &__topLogo {
      height: 70px;
      width: auto;
      object-fit: contain;
      display: block;
    }

    &__contact {
      text-align: right;
      display: flex;
      flex-direction: column;
      gap: var(--space-4xs);
      font-family: var(--font-family-alt);
      font-size: var(--font-size-0);

      @media (max-width: 767px) {
        text-align: left;
        margin-top: var(--space-xs);
      }
    }

    &__middle {
      flex-grow: 1;
      padding-top: var(--space-md);

      .start {
        flex-grow: 1;
      }
    }

    .footer-menu {
      list-style: none;
      padding: 0;

      .eyebrow {
        font-size: var(--font-size--2);
        text-transform: uppercase;
        letter-spacing: var(--letter-spacing-looser);
        margin-bottom: var(--space-sm);
      }
    }

    .footer-menu-link {
      padding-block: var(--space-xs);
      display: inline-block;
      position: relative;
      font-family: var(--font-family-body);
      font-size: var(--font-size--1);

      &::after {
        content: "";
        position: absolute;
        bottom: calc(var(--space-xs) - 2px);
        left: 0;
        width: 100%;
        height: 1px;
        background-color: currentColor;
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.3s ease;
      }

      &:hover::after {
        transform: scaleX(1);
        transform-origin: left;
      }

      &:not(:hover)::after {
        transform: scaleX(0);
        transform-origin: right;
      }
    }

    .copyright {
      font-size: var(--font-size--1);
      opacity: 0.8;
      border-top: 1px solid var(--color-border);
      padding-top: var(--space-md);

      .cluster {
        display: flex !important;
        flex-wrap: wrap !important;
        align-items: center !important;
        gap: 1.5rem !important;
      }

      a {
        color: inherit;
        text-decoration: none;
      }
    }

    &__bottom {
      overflow: hidden;
      padding-block-start: 4vh;
      margin-block-start: -4vh;
      width: 100%;
      display: flex;
      justify-content: center;
      align-items: center;
      box-sizing: border-box;
    }

    &__bottomLogo {
      width: 50%;
      max-width: 50%;
      margin: 0 auto;
      height: auto;
      margin-bottom: -3svh;
      display: block;
      will-change: transform;
      opacity: 0.88;

      path {
        fill: #ffffff !important;
      }
    }
  }
</style>
