---
import type { services as Services } from '../data/services';

interface Props {
  services: typeof Services;
}

const { services } = Astro.props;
---

<section class="cards-section">
  <div class="ambient-glow ambient-glow--1" aria-hidden="true"></div>
  <div class="ambient-glow ambient-glow--2" aria-hidden="true"></div>

  <div class="cards-section__inner">

    <div class="cards-section__left">
      <p class="eyebrow">What we do</p>
      <h2 class="cards-section__heading">
        From IT development to media production,<br/>
        <span class="highlight">marketing strategies</span> to hardware installations.
      </h2>
      <p class="cards-section__body">
        Every service we offer is designed to move the needle — whether
        that's more traffic, more conversions, or a product your users love.
      </p>
      <a href="/contact" class="cta-btn">
        <span class="cta-btn__shine"></span>
        <span class="cta-btn__label">Start a project</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
        </svg>
      </a>
    </div>

    <div class="cards-section__grid">
      {services.map((svc, i) => (
        <article class="svc-card" style={`--card-bg: url('${svc.image}'); --delay: ${i * 80}ms`}>

          <span class="svc-card__border" aria-hidden="true"></span>
          <span class="svc-card__index">{String(i + 1).padStart(2, '0')}</span>

          <div class="svc-card__face">
            <span class="svc-card__icon">{svc.icon}</span>
            <div>
              <p class="svc-card__eyebrow">{svc.eyebrow}</p>
              <h3 class="svc-card__title">{svc.title}</h3>
            </div>
            <span class="svc-card__hint">
              <span class="svc-card__hint-dot"></span>
              Hover to explore
            </span>
          </div>

          <div class="svc-card__back">
            <p class="svc-card__eyebrow">{svc.eyebrow}</p>
            <h3 class="svc-card__title">{svc.title}</h3>
            <p class="svc-card__desc">{svc.desc}</p>
            <ul class="svc-card__chips">
              {svc.chips.map((chip) => (
                <li class="svc-chip">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                  {chip}
                </li>
              ))}
            </ul>
          </div>

        </article>
      ))}
    </div>

  </div>
</section>

<style lang="scss">
.cards-section {
  position: relative;
  border-top: 1px solid var(--color-border);
  background-color: var(--color-bg);
  overflow: hidden;
}

/* ── Ambient background glows ── */
.ambient-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(90px);
  pointer-events: none;
  z-index: 0;
}

.ambient-glow--1 {
  width: 480px;
  height: 480px;
  top: -120px;
  right: 10%;
  background: radial-gradient(circle, rgba(127,252,255,0.14), transparent 70%);
}

.ambient-glow--2 {
  width: 380px;
  height: 380px;
  bottom: -100px;
  left: 5%;
  background: radial-gradient(circle, rgba(168,127,255,0.1), transparent 70%);
}

.cards-section__inner {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: start;
  padding: 100px 72px 100px 80px;
  gap: 0;

  @media (max-width: 900px) {
    grid-template-columns: 1fr;
    padding: 60px var(--space-md);
    gap: var(--space-xl);
  }
}

/* ── Left ── */
.cards-section__left {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  max-width: 540px;
  padding-right: var(--space-xl);
  position: sticky;
  top: 100px;

  @media (max-width: 900px) {
    position: static;
    max-width: 100%;
    padding-right: 0;
  }
}

.eyebrow {
  font-size: var(--font-size--1);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-foreground-secondary);
  display: flex;
  align-items: center;
  gap: 8px;

  &::before {
    content: '';
    width: 24px;
    height: 1px;
    background: linear-gradient(90deg, rgba(127,252,255,0.9), rgba(168,127,255,0.3));
  }
}

.cards-section__heading {
  font-size: clamp(2.4rem, 4vw, 3.6rem);
  font-weight: var(--font-weight-normal);
  line-height: 1.05;
  letter-spacing: var(--letter-spacing-tight);
  color: var(--color-foreground);
  margin: 0;

  .highlight {
    background: linear-gradient(120deg, #7ffcff, #a87fff 60%, #7ffcff);
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shimmer 6s linear infinite;
  }
}

@keyframes shimmer {
  to { background-position: 200% center; }
}

.cards-section__body {
  font-size: var(--font-size--1);
  line-height: 1.7;
  color: var(--color-foreground-secondary);
  max-width: 38ch;
}

.cta-btn {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: var(--space-xs);
  background: var(--color-foreground);
  color: var(--color-bg);
  font-size: var(--font-size--1);
  font-weight: 500;
  padding: 14px 28px;
  border-radius: 999px;
  text-decoration: none;
  width: fit-content;
  overflow: hidden;
  transition: transform 0.2s ease, box-shadow 0.3s ease;

  svg { transition: transform 0.2s ease; position: relative; z-index: 1; }
  &__label { position: relative; z-index: 1; }

  &__shine {
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, transparent 20%, rgba(255,255,255,0.5) 50%, transparent 80%);
    transform: translateX(-120%);
  }

  &:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(127,252,255,0.18);

    svg { transform: translateX(3px); }
    .cta-btn__shine { transform: translateX(120%); transition: transform 0.7s ease; }
  }
}

/* ── Cards grid ── */
.cards-section__grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
  border-left: 1px solid var(--color-border);
  padding-left: 48px;

  @media (max-width: 900px) {
    border-left: none;
    border-top: 1px solid var(--color-border);
    padding-left: 0;
    padding-top: 40px;
  }

  @media (max-width: 500px) {
    grid-template-columns: 1fr;
  }
}

@keyframes fade-in-up {
  from { opacity: 0; transform: translateY(24px); }
  to { opacity: 1; transform: translateY(0); }
}

/* ── Card ── */
.svc-card {
  position: relative;
  min-height: 420px;
  border-radius: var(--radius-md);
  overflow: hidden;
  cursor: pointer;
  background: linear-gradient(160deg, rgba(255,255,255,0.05), rgba(255,255,255,0.015));
  border: 1px solid rgba(255,255,255,0.08);
  transition: transform 0.45s cubic-bezier(0.16,1,0.3,1),
              border-color 0.45s ease,
              box-shadow 0.45s ease;
  animation: fade-in-up 0.6s cubic-bezier(0.16,1,0.3,1) both;
  animation-delay: var(--delay);

  &:hover {
    transform: translateY(-6px);
    border-color: transparent;
    box-shadow:
      0 24px 60px rgba(0,0,0,0.55),
      0 0 40px rgba(127,252,255,0.1);
  }

  /* animated conic-gradient border on hover */
  &__border {
    position: absolute;
    inset: 0;
    z-index: 5;
    border-radius: inherit;
    padding: 1px;
    background: conic-gradient(from 0deg, #7ffcff, #a87fff, #7ffcff, #a87fff, #7ffcff);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.4s ease;

    pointer-events: none;
  }

  &:hover .svc-card__border { opacity: 1; }

  /* subtle glow blob + image */
  &::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 100% at 15% 0%, rgba(127,252,255,0.12), transparent 55%),
      var(--card-bg);
    background-size: cover, cover;
    background-position: center, center;
    opacity: 0;
    transform: scale(1.06);
    transition: opacity 0.55s ease, transform 0.55s ease;
  }

  /* dark overlay */
  &::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top,
      rgba(0,0,0,0.94) 0%,
      rgba(0,0,0,0.65) 45%,
      rgba(0,0,0,0.25) 100%);
    opacity: 0;
    transition: opacity 0.45s ease;
    z-index: 1;
  }

  &:hover::before { opacity: 1; transform: scale(1); }
  &:hover::after  { opacity: 1; }
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.svc-card__index {
  position: absolute;
  top: 20px;
  right: 24px;
  z-index: 4;
  font-size: 12px;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.05em;
  color: rgba(255,255,255,0.35);
  transition: color 0.4s ease;

  .svc-card:hover & {
    color: rgba(127,252,255,0.8);
  }
}

/* default face */
.svc-card__face {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 20px;
  padding: 32px;
  text-align: center;
  transition: opacity 0.3s ease, transform 0.3s ease;

  .svc-card:hover & {
    opacity: 0;
    transform: translateY(-16px) scale(0.97);
    pointer-events: none;
  }
}

.svc-card__icon {
  font-size: 3.5rem;
  line-height: 1;
  width: 100px;
  height: 100px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24px;
  background: linear-gradient(160deg, rgba(255,255,255,0.09), rgba(255,255,255,0.02));
  border: 1px solid rgba(255,255,255,0.12);
  backdrop-filter: blur(10px);
  transition: transform 0.4s cubic-bezier(0.16,1,0.3,1), border-color 0.4s ease;

  .svc-card:hover & {
    transform: scale(1.05) rotate(-4deg);
    border-color: rgba(127,252,255,0.3);
  }
}

.svc-card__hint {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.32);
}

.svc-card__hint-dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: rgba(127,252,255,0.7);
  animation: pulse 1.8s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 0.4; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.4); }
}

/* hover back */
.svc-card__back {
  position: absolute;
  inset: 0;
  z-index: 3;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 28px;
  gap: 10px;
  opacity: 0;
  transform: translateY(20px);
  transition: opacity 0.45s cubic-bezier(0.16,1,0.3,1),
              transform 0.45s cubic-bezier(0.16,1,0.3,1);

  .svc-card:hover & {
    opacity: 1;
    transform: translateY(0);
  }
}

.svc-card__eyebrow {
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  background: linear-gradient(90deg, #7ffcff, #a87fff);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  margin: 0;
}

.svc-card__title {
  font-size: clamp(1.1rem, 1.8vw, 1.3rem);
  font-weight: 600;
  letter-spacing: -0.02em;
  color: #fff;
  margin: 0;
  text-align: center;

  .svc-card__back & {
    text-align: left;
    font-size: 1.15rem;
  }
}

.svc-card__desc {
  font-size: 0.9rem;
  line-height: 1.7;
  color: rgba(255,255,255,0.78);
  margin: 0 0 6px;
  max-width: 32ch;
}

.svc-card__chips {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.svc-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 12px;
  border-radius: 999px;
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.15);
  color: #fff;
  font-size: 12px;
  font-weight: 500;
  backdrop-filter: blur(8px);
  transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;

  svg { color: #7ffcff; flex-shrink: 0; }

  &:hover {
    background: rgba(127,252,255,0.14);
    border-color: rgba(127,252,255,0.3);
    transform: translateY(-1px);
  }
}

@media (max-width: 768px) {
  .svc-card { min-height: 340px; }
  .svc-card__icon { width: 80px; height: 80px; font-size: 2.8rem; }
  .svc-card__back { padding: 20px; }
}

@media (prefers-reduced-motion: reduce) {
  .svc-card, .svc-card__border, .svc-card__hint-dot, .highlight {
    animation: none !important;
  }
}
</style>