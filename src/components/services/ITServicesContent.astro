---
const offerings = [
  {
    title: 'Web applications',
    summary: 'Purpose-built systems that simplify operations and create better customer experiences.',
    services: ['Custom web applications', 'Enterprise and cloud solutions', 'CRM and workflow tools', 'E-commerce, B2B, and B2C platforms', 'Payments and third-party integrations', 'Ongoing support'],
  },
  {
    title: 'Mobile applications',
    summary: 'Reliable mobile experiences designed to earn a place in your customers’ everyday routines.',
    services: ['iOS and Android development', 'UX-led interface design', 'Secure application architecture', 'API and backend integration', 'Pre-launch testing', 'App Store and Google Play publishing'],
  },
  {
    title: 'Websites',
    summary: 'Fast, search-ready websites that make a clear case for your business and convert attention into action.',
    services: ['Custom design and development', 'Responsive, mobile-first builds', 'SEO-ready architecture', 'CMS integration', 'E-commerce websites', 'Landing pages and analytics', 'Maintenance and support'],
  },
] as const;

const audiences = [
  {
    index: '01',
    title: 'Startups & MVPs',
    description: 'Launch fast without compromising on engineering quality, scalable architecture, or security standards.',
  },
  {
    index: '02',
    title: 'E-Commerce Brands',
    description: 'High-availability storefronts engineered for peak traffic, sub-second load times, and frictionless checkout.',
  },
  {
    index: '03',
    title: 'Service-Based Businesses',
    description: 'Custom booking engines, secure client portals, and streamlined internal operations tools.',
  },
  {
    index: '04',
    title: 'Growing Enterprises',
    description: 'Complex, high-traffic systems and multi-tier platforms managed seamlessly across teams.',
  },
  {
    index: '05',
    title: 'Educational Institutions',
    description: 'Interactive learning portals and digital content delivery tailored to mobile-first audiences.',
  },
  {
    index: '06',
    title: 'Healthcare Providers',
    description: 'Secure, reliable, and compliant patient-facing systems built for critical dependability.',
  },
  {
    index: '07',
    title: 'Scaling Companies',
    description: 'Modernize legacy systems and scale infrastructure to effortlessly keep pace with surging demand.',
  },
] as const;
---

<section class="section ITServicesContent" data-padding="xl">
  <div class="container" data-size="lg">
    <!-- Intro text -->
    <div class="stack" data-gap="xl" style="margin-bottom: var(--space-2xl);">
      <p class="eyebrow">What we do</p>
      <h2 class="heading" data-font-size="5">We build IT solutions that solve real business problems.</h2>
      <p class="prose prose--lg" style="max-width: 80ch;">
        Whether you need a customer-facing app, an internal system, or a complete website rebuild, we bring the same discipline to every project: careful planning, clean execution, and support that doesn't disappear after launch. You get technology that drives growth, not technology you have to manage around.
      </p>
      <p class="prose prose--lg" style="max-width: 80ch;">
        Every business runs on technology now. The only question is whether yours is working for you or against you. A slow website costs you customers. A clunky internal tool wastes your team's time. A mobile app nobody opens is a sunk investment, not an asset.
      </p>
    </div>

    <!-- The 3 Cards -->
    <div class="cards-grid">
      <!-- Web App Development -->
      <article class="service-detail-card">
        <h3 class="heading" data-font-size="3">Web App Development</h3>
        <p class="prose">We build web applications that simplify how your customers interact with your business — scalable, secure, and designed to perform across every device.</p>
        <ul class="bullets stack" data-gap="xs">
          <li>Custom web application development</li>
          <li>Enterprise and cloud-based solutions</li>
          <li>CRM and business process tools</li>
          <li>E-commerce, B2B, and B2C platforms</li>
          <li>Payment gateway and third-party integrations</li>
          <li>Ongoing maintenance and support</li>
        </ul>
      </article>
      
      <!-- Mobile App Development -->
      <article class="service-detail-card">
        <h3 class="heading" data-font-size="3">Mobile App Development</h3>
        <p class="prose">We design and build mobile apps that turn downloads into daily users — fast, secure, and built to keep your customers coming back.</p>
        <ul class="bullets stack" data-gap="xs">
          <li>iOS and Android app development</li>
          <li>UX-first interface design</li>
          <li>Secure, encrypted architecture</li>
          <li>API and backend integration</li>
          <li>Thorough pre-launch testing</li>
          <li>App Store and Google Play publishing</li>
        </ul>
      </article>

      <!-- Website Development -->
      <article class="service-detail-card">
        <h3 class="heading" data-font-size="3">Website Development</h3>
        <p class="prose">We build websites that do more than look good — they load fast, rank well, and turn visitors into customers.</p>
        <ul class="bullets stack" data-gap="xs">
          <li>Custom website design and development</li>
          <li>Responsive, mobile-optimised builds</li>
          <li>SEO-ready architecture</li>
          <li>CMS integration for easy content updates</li>
          <li>E-commerce-ready websites</li>
          <li>Targeted Landing page with performance tracking</li>
          <li>Website maintenance and support</li>
        </ul>
      </article>
    </div>
  </div>
</section>

<section class="section WhoNeeds" data-padding="xl">
  <div class="container" data-size="lg">
    <header class="who-needs-header">
      <span class="service-kicker">Who We Help</span>
      <h2 class="heading" data-font-size="5">Who Needs IT Services</h2>
      <p class="prose prose--lg who-needs-intro">
        Any business that depends on technology to reach customers, manage operations, or stay competitive needs the right IT partner behind it.
      </p>
    </header>

    <div class="who-needs-layout">
      <div class="audience-list">
        {audiences.map((item) => (
          <article class="audience-card">
            <span class="audience-index">{item.index}</span>
            <div class="audience-body">
              <h3 class="audience-title">{item.title}</h3>
              <p class="audience-desc">{item.description}</p>
            </div>
            <span class="audience-arrow" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
            </span>
          </article>
        ))}
      </div>

      <div class="image-col">
        <div class="anchor-card anchor-card--rounded who-needs-frame">
          <svg class="anchor-border" width="100%" height="100%" preserveAspectRatio="none">
            <rect x="3.5" y="3.5" width="calc(100% - 7px)" height="calc(100% - 7px)" rx="16" ry="16" fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="1"></rect>
            <circle cx="19.5" cy="3.5" r="3" fill="var(--color-bg)" stroke="rgba(255,255,255,0.5)" stroke-width="1"></circle>
            <circle cx="calc(100% - 19.5px)" cy="3.5" r="3" fill="var(--color-bg)" stroke="rgba(255,255,255,0.5)" stroke-width="1"></circle>
            <circle cx="19.5" cy="calc(100% - 3.5px)" r="3" fill="var(--color-bg)" stroke="rgba(255,255,255,0.5)" stroke-width="1"></circle>
            <circle cx="calc(100% - 19.5px)" cy="calc(100% - 3.5px)" r="3" fill="var(--color-bg)" stroke="rgba(255,255,255,0.5)" stroke-width="1"></circle>
          </svg>
          <div class="anchor-content">
            <img 
              src="/images/it-services-audience.jpg" 
              alt="Engineering team collaborating on IT software, cloud systems, and web architecture" 
              loading="lazy" 
              decoding="async" 
            />
          </div>
          <div class="frame-tag">
            <span class="tag-pulse"></span>
            <span class="tag-text">Built to scale with your business</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-xl);
    
    @media (max-width: 768px) {
      grid-template-columns: 1fr;
    }
  }

  .service-detail-card {
    background: linear-gradient(160deg, rgba(255,255,255,0.03), rgba(255,255,255,0.01));
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    transition: transform 0.3s ease, border-color 0.3s ease;

    &:hover {
      transform: translateY(-4px);
      border-color: rgba(156,8,39,0.5);
    }
    
    h3 {
      color: var(--color-foreground);
    }
    
    .prose {
      color: var(--color-foreground-secondary);
      line-height: 1.6;
    }
  }

  .bullets {
    list-style: none;
    padding: 0;
    margin: 0;
    
    li {
      position: relative;
      padding-left: 1.5rem;
      color: var(--color-foreground-secondary);
      line-height: 1.5;
      
      &::before {
        content: '→';
        position: absolute;
        left: 0;
        top: 0;
        color: var(--color-burgundy);
      }
    }
  }

  .WhoNeeds {
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    position: relative;
    z-index: 1;
  }

  .service-kicker {
    color: var(--color-burgundy);
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.4rem;
  }

  .who-needs-header {
    margin-bottom: clamp(2rem, 3.5vw, 3rem);
    max-width: 820px;

    h2 {
      margin: 0 0 0.85rem;
    }
  }

  .who-needs-intro {
    color: var(--color-foreground-secondary);
    line-height: 1.65;
    max-width: 68ch;
  }

  .who-needs-layout {
    display: grid;
    grid-template-columns: 1.18fr 0.82fr;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: start;

    @media (max-width: 980px) {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  .audience-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .audience-card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.15rem;
    padding: 1.1rem 1.35rem;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.03) 0%, rgba(255, 255, 255, 0.01) 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.25s ease,
                background 0.25s ease,
                box-shadow 0.25s ease;
    position: relative;
    overflow: hidden;

    &:hover {
      transform: translateX(6px);
      border-color: rgba(156, 8, 39, 0.45);
      background: linear-gradient(135deg, rgba(156, 8, 39, 0.07) 0%, rgba(255, 255, 255, 0.02) 100%);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);

      .audience-index {
        background: var(--color-burgundy);
        color: #ffffff;
        border-color: transparent;
      }

      .audience-arrow {
        color: var(--color-burgundy);
        transform: translateX(3px);
      }
    }
  }

  .audience-index {
    font-family: var(--font-family-mono, monospace);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-burgundy);
    background: rgba(156, 8, 39, 0.12);
    border: 1px solid rgba(156, 8, 39, 0.25);
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 8px;
    display: grid;
    place-items: center;
    transition: all 0.25s ease;
    flex-shrink: 0;
  }

  .audience-body {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .audience-title {
    color: var(--color-foreground);
    font-size: 1.02rem;
    font-weight: 600;
    margin: 0;
    line-height: 1.3;
  }

  .audience-desc {
    color: var(--color-foreground-secondary);
    font-size: 0.88rem;
    line-height: 1.5;
    margin: 0;
  }

  .audience-arrow {
    color: rgba(255, 255, 255, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.25s ease;
    flex-shrink: 0;
  }

  .image-col {
    position: sticky;
    top: 100px;
    align-self: start;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;

    @media (max-width: 980px) {
      position: static;
      margin-top: 1rem;
    }
  }

  .who-needs-frame {
    position: relative;
    width: 100%;
    min-height: 480px;
    aspect-ratio: 4 / 3.6;

    .anchor-border {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 2;
      pointer-events: none;
    }

    .anchor-content {
      padding: 12px;
      border-radius: 16px;
      height: 100%;
      width: 100%;
      display: flex;
      position: relative;
      z-index: 1;

      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 12px;
        box-shadow: 0 12px 36px rgba(0, 0, 0, 0.45);
      }
    }

    .frame-tag {
      position: absolute;
      bottom: 22px;
      left: 22px;
      z-index: 3;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 14px;
      border-radius: 999px;
      background: rgba(10, 10, 10, 0.78);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.15);

      .tag-pulse {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #22c55e;
        box-shadow: 0 0 8px #22c55e;
      }

      .tag-text {
        font-size: 0.78rem;
        font-weight: 550;
        color: rgba(255, 255, 255, 0.9);
        letter-spacing: 0.02em;
      }
    }

    @media (max-width: 980px) {
      min-height: 320px;
      aspect-ratio: 16 / 10;
      max-width: 580px;
    }
  }
</style>
