---
import type { heroImages as HeroImages } from '../data/services';
import Button from './ui/Button.astro';

// interface CTA { label: string; href: string; }

interface Props {
  eyebrow: string;
  title: string;
  desc: string;
  // ctaPrimary: CTA;
  // ctaSecondary?: CTA;
  images: typeof HeroImages;
  text?: string;
}

const { eyebrow, title, desc, images } = Astro.props;
const{text ="Get Started"} = Astro.props;
---

<section class="hero">
  <div class="hero__left">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="hero__heading">{title}</h1>

    <div class="divider" aria-hidden="true">
      <span class="dot"></span>
      <span class="line"></span>
      <span class="dot"></span>
    </div>

    <p class="hero__body">{desc}</p>

    <div class="cta-group">
      <Button variant="secondary" href="/contact">
        Talk to Our IT Team
        <span class="icon" aria-hidden="true" role="img" style="margin-left: 8px; display: inline-flex; align-items: center;">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right">
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </span>
      </Button>
    </div>
  </div>
 

  <aside class="hero__image" aria-label="IT Services Image">
    <div class="anchor-card anchor-card--rounded" style="width: 100%; height: 100%; min-height: 400px; position: relative;">
      <svg class="anchor-border" width="100%" height="100%" preserveAspectRatio="none" style="position: absolute; top: 0; left: 0; z-index: 1;">
        <rect x="3.5" y="3.5" width="calc(100% - 7px)" height="calc(100% - 7px)" rx="16" ry="16" fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="1"></rect>
        <circle cx="19.5" cy="3.5" r="3" fill="var(--color-bg)" stroke="rgba(255,255,255,0.5)" stroke-width="1"></circle>
        <circle cx="calc(100% - 19.5px)" cy="3.5" r="3" fill="var(--color-bg)" stroke="rgba(255,255,255,0.5)" stroke-width="1"></circle>
        <circle cx="19.5" cy="calc(100% - 3.5px)" r="3" fill="var(--color-bg)" stroke="rgba(255,255,255,0.5)" stroke-width="1"></circle>
        <circle cx="calc(100% - 19.5px)" cy="calc(100% - 3.5px)" r="3" fill="var(--color-bg)" stroke="rgba(255,255,255,0.5)" stroke-width="1"></circle>
      </svg>
      <div class="anchor-content" style="padding: 12px; border-radius: 16px; height: 100%; display: flex; position: relative; z-index: 2;">
        <img src="/images/it-services.png" alt="IT Services Concept" style="width: 100%; height: 100%; object-fit: cover; border-radius: 12px;" loading="lazy" decoding="async" />
      </div>
    </div>
  </aside>
</section>

<script>
  const buttons =document.querySelectorAll("[data-animated-button]");
    buttons.forEach((button) => {
    button.addEventListener('click', () => {
     
      button.classList.add('is-clicked');
      
      // Remove it after the animation finishes
      setTimeout(() => {
        button.classList.remove('is-clicked');
      }, 200);
    });
  });
</script>

<style lang="scss">
.hero {
  position: relative;
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  min-height: 100vh;
  padding: 120px 72px 80px 80px;
  gap: 0;

  @media (max-width: 900px) {
    grid-template-columns: 1fr;
    padding: 100px var(--space-md) var(--space-xl);
    gap: var(--space-xl);
  }
}

.hero__left {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  max-width: 580px;
  padding-right: var(--space-xl);
  margin: 0 auto;
  justify-content: center;

  @media (max-width: 900px) {
    max-width: 100%;
    padding-right: 0;
  }
}

.eyebrow {
  font-size: var(--font-size--1);
  letter-spacing: 0.35em;
  text-transform: uppercase;
  color: var(--color-foreground-secondary);
}

.hero__heading {
  font-size: clamp(2.75rem, 5.5vw, 4.5rem);
  font-weight: var(--font-weight-normal);
  line-height: 1.1;
  letter-spacing: var(--letter-spacing-tight);
  color: var(--color-foreground);
  margin: 0;
  white-space: pre-line;
}

.divider {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  max-width: 586px;

  .line {
    flex: 1;
    height: 1px;
    background: rgba(255,255,255,0.15);
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.35);
    flex-shrink: 0;
  }
}

.hero__body {
  font-size: var(--font-size--1);
  line-height: 1.7;
  color: var(--color-foreground-secondary);
  max-width: 42ch;
}

.cta-group {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.cta-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: var(--font-size--1);
  font-weight: 500;
  padding: 14px 22px;
  border-radius: 10px;
  text-decoration: none;
  width: fit-content;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.1);
  color: var(--color-foreground);
  transition: background 0.2s ease, transform 0.2s ease, border-color 0.2s ease;

  svg { transition: transform 0.2s ease; }

  &:hover {
    background: rgba(255,255,255,0.08);
    border-color: rgba(255,255,255,0.2);
    transform: translateY(-1px);
    svg { transform: translateX(3px); }
  }
}

/* ── Hero Image ── */
.hero__image {
  height: 70vh;
  max-height: 520px;
  width: 90%;
  margin-left: auto;

  @media (max-width: 900px) {
    height: 400px;
    max-height: 400px;
    width: 100%;
    margin-left: 0;
    padding-top: 24px;
  }
}

.animated-btn {
    --btn-bg: #4f46e5;
    --btn-hover-bg: #4338ca;
    --btn-text-color: #ffffff;
    
    position: relative;
    padding: 0.75rem 1.5rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--btn-text-color);
    background-color: var(--btn-bg);
    border: none;
    border-radius: 0.5rem;
    cursor: pointer;
    overflow: hidden;
    outline: none;
    
    /* Hardware acceleration and transition for smooth hover */
    transform: translateZ(0);
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.2s ease;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  }

  /* Hover micro-interaction */
  .animated-btn:hover {
    background-color: var(--btn-hover-bg);
    transform: scale(1.05);
    box-shadow: 0 10px 15px -3px rgba(79, 70, 229, 0.3), 0 4px 6px -4px rgba(79, 70, 229, 0.3);
  }

  /* Active/Click pop animation via CSS Keyframes */
  .animated-btn.is-clicked {
    animation: pop 0.2s ease-out forwards;
  }

  @keyframes pop {
    0% {
      transform: scale(1.05);
    }
    50% {
      transform: scale(0.92);
    }
    100% {
      transform: scale(1.05);
    }
  }

  /* Accessibility feature: respects user's system preferences */
  @media (prefers-reduced-motion: reduce) {
    .animated-btn {
      transition: none;
      animation: none;
    }
    .animated-btn:hover {
      transform: none;
    }
  }
</style>