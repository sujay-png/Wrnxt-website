---
const accreditations = [
  { name: "Agency Hackers", url: "https://salo.uk/_astro/accreditation-agency-hackers.CskRe8_T.png" },
  { name: "BIMA", url: "https://salo.uk/_astro/accreditation-bima.DOjLsDfZ.png" },
  { name: "Net", url: "https://salo.uk/_astro/accreditation-net.De0nr0fC.png" },
  { name: "Alliance of Independent Agencies", url: "https://salo.uk/_astro/accreditation-aia.B3ALZq9Y.png" }
];
---

<footer class="section footer" data-pt="lg">
  <div class="container" data-size="full">
    <div class="stack" data-gap="3xl">
      <!-- Top Section: Logo & Direct Contacts -->
      <div class="footer__top">
        <div class="start">
          <a href="/" title="Go home.">
            <svg class="footer__topLogo salo-logo" viewBox="0 0 104 30" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Salo Logo.">
              <path class="salo-logo__0" d="M101.813 9.07487C98.1337 1.20259 88.7695 -2.19519 80.8963 1.48374L80.208 0.00968382C72.3348 3.68862 68.9357 13.0518 72.6151 20.9241C76.2944 28.7964 85.6587 32.1942 93.5319 28.5152L94.2202 29.9884C102.093 26.3095 105.492 16.9463 101.813 9.07398V9.07487ZM90.7839 22.6376C86.1581 24.799 80.6568 22.8017 78.4951 18.1773C76.3335 13.552 78.331 8.05137 82.956 5.88995L83.6443 7.36223C88.2701 5.20081 93.7714 7.19815 95.933 11.8225C98.0947 16.4478 96.0971 21.9485 91.4722 24.1099L90.7839 22.6376Z" fill="white"></path>
