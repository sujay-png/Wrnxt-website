---
const galleryColumns = [
  [
    { src: "public/images/image1.jpeg", alt: "The team at indoor skydiving.", tag: null, },
    { src: "public/images/Grp_image-boys.jpg", alt: "Agency Grand Prix.", tag: null }
  ],
  [
    { src: "public/images/image3.jpeg", alt: "Carl on a racing simulator.", tag: null },
    { src: "public/images/image4.jpg", alt: "Agency Grand Prix.", tag: null },
  
  ]
];
---

<section class="section AboutHero" data-padding="xl">
  <!-- Text lives inside the container for proper left inset -->
  <div class="container">
    <div class="stack AboutHero__intro" data-gap="lg" data-align="start">
      <span class="heading eyebrow">About us</span>
      <h1 class="heading" data-font-size="4" data-weight="regular">Transforming Businesses Through Innovation</h1>

      <div class="reactive-divider horizontal" x-data="reactiveDivider({ orientation: 'horizontal', unit: 'px' })">
        <div class="anchor start-anchor"><div class="anchor-circle"></div></div>
        <div class="divider-line" x-ref="dividerLine">
          <div class="width-display" x-text="formattedWidth" x-cloak>0px</div>
        </div>
        <div class="anchor end-anchor"><div class="anchor-circle"></div></div>
      </div>

      <div class="prose">
        <p>WRNXT is more than just an IT company—we’re your strategic partner in digital transformation. We bring together cutting-edge technology, creative excellence, and marketing expertise to deliver solutions that matter.

Our integrated approach spans IT development, media production, digital marketing, and hardware installations, allowing us to provide seamless end-to-end solutions that address every aspect of your business needs.

With a passionate team of 50+ professionals and a proven track record of 500+ successful projects, we’ve earned the trust of businesses across industries. We don’t just deliver services—we build lasting partnerships.</p>
      </div>

      <div class="cluster actions" data-gap="sm" data-justify="start" data-align="center">
        <a href="#team" class="btn size-md secondary">
          <span class="btn-content">
            Meet the team
            <span class="icon" aria-hidden="true" role="img">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
            </span>
          </span>
        </a>
      </div>
    </div>
  </div>

  <!-- Gallery is absolutely positioned so section height is driven by the text column,
       not by the number/size of photos. Photos bleed to the section card's top/bottom/right
       edges and are clipped by overflow:clip + border-radius on .AboutHero. -->
  <div class="AboutHero__gallery">
    {galleryColumns.map((column, colIdx) => (
      <div class={`AboutHero__galleryCol AboutHero__galleryCol--${colIdx + 1}`}>
        {column.map((img) => (
          <div class="anchor-card anchor-card--rounded AboutHero__galleryItem">
            <svg class="anchor-border" width="100%" height="100%" preserveAspectRatio="none">
              <rect x="3.5" y="3.5" width="calc(100% - 7px)" height="calc(100% - 7px)" rx="16" ry="16"></rect>
              <circle cx="19.5" cy="3.5" r="3"></circle>
              <circle cx="calc(100% - 19.5px)" cy="3.5" r="3"></circle>
              <circle cx="19.5" cy="calc(100% - 3.5px)" r="3"></circle>
              <circle cx="calc(100% - 19.5px)" cy="calc(100% - 3.5px)" r="3"></circle>
            </svg>
            <div class="anchor-content">
              <div class="frame" style="--frame-ratio:3/4;">
                <img src={img.src} alt={img.alt} loading="lazy" decoding="async" width="420" height="560" />
              </div>
            </div>
            {img.tag && (
              <div class="AboutHero__photoTag">
                <span class="AboutHero__photoTagAvatar" style={`background-image:url(${img.src})`}></span>
                <span class="AboutHero__photoTagName">{img.tag}</span>
              </div>
            )}
          </div>
        ))}
      </div>
    ))}
  </div>
</section>

<script>
  import Alpine from 'alpinejs';

  if (!window.__dividerAlpineRegistered) {
    window.__dividerAlpineRegistered = true;

    document.addEventListener("alpine:init", () => {
      Alpine.data("reactiveDivider", ({ orientation, unit }) => ({
        dimension: 0,
        orientation: orientation,
        resizeObserver: null,
        init() {
          this.measure();
          this.resizeObserver = new ResizeObserver((entries) => {
            for (const entry of entries) {
              const rect = entry.contentRect;
              this.updateDimension(rect);
            }
          });
          if (this.$refs.dividerLine) {
            this.resizeObserver.observe(this.$refs.dividerLine);
          }
        },
        measure() {
          if (this.$refs.dividerLine) {
            const rect = this.$refs.dividerLine.getBoundingClientRect();
            this.updateDimension(rect);
          }
        },
        updateDimension(rect) {
          this.dimension = this.orientation === "horizontal" ? rect.width : rect.height;
        },
        get formattedWidth() {
          return `${Math.round(this.dimension)}${unit}`;
        },
        destroy() {
          if (this.resizeObserver) {
            this.resizeObserver.disconnect();
          }
        }
      }));
    });
  }
</script>

<style lang="scss">
  .AboutHero {
    position: relative;
    width: auto;

    margin-block-start: var(--header-height);
    margin-inline: var(--space-sm);

    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-bg-alt);

    overflow: hidden;

    --section-pb: var(--space-xl);

    em {
      font-style: italic;
      color: var(--color-foreground-secondary);
    }
  }

  .AboutHero > .container {
    position: relative;
    z-index: 2;
  }

  .AboutHero__intro {
    width: 100%;
    max-width: min(65%, 48rem);

    h1 {
      margin: 0;
      text-wrap: balance;
    }

    .prose {
      width: 100%;
      max-width: 48rem;

      p {
        margin: 0;
        white-space: pre-line;
        text-wrap: pretty;
      }
    }
  }

  .AboutHero__gallery {
    position: absolute;
    top: -2rem;
    right: 0;
    bottom: -2rem;

    width: clamp(21rem, 34%, 34rem);

    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: var(--space-md);

    padding-inline-end: var(--space-md);

    z-index: 1;
  }

  .AboutHero__galleryCol {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);

    min-width: 0;

    &--2 {
      padding-top: var(--space-md);
    }
  }

  .AboutHero__galleryItem {
    position: relative;
    width: 100%;
    height: auto;
    min-width: 0;

    overflow: hidden;
    border-radius: 16px;

    will-change: transform;

    .anchor-content {
      width: 100%;
      height: auto;
    }

    .frame {
      position: relative;
      width: 100%;
      aspect-ratio: 3 / 4;
      overflow: hidden;
      border-radius: 13px;
    }

    img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }
  }

  .AboutHero__photoTag {
    position: absolute;
    left: var(--space-sm);
    bottom: var(--space-sm);
    z-index: 3;

    display: flex;
    align-items: center;
    gap: var(--space-3xs);

    padding:
      var(--space-4xs)
      var(--space-2xs)
      var(--space-4xs)
      var(--space-4xs);

    border-radius: var(--radius-full);

    background: rgba(16, 16, 16, 0.65);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .AboutHero__photoTagAvatar {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;

    border-radius: var(--radius-full);

    background-size: cover;
    background-position: center;
  }

  .AboutHero__photoTagName {
    font-family: var(--font-family-alt);
    font-size: var(--font-size--2);
    color: var(--color-white, #fff);
  }

  /*
   * Small desktop and tablet
   */
  @media (max-width: 1100px) {
    .AboutHero__intro {
      max-width: 58%;
    }

    .AboutHero__gallery {
      width: 38%;
      gap: var(--space-sm);
      padding-inline-end: var(--space-sm);
    }

    .AboutHero__galleryCol {
      gap: var(--space-sm);
    }
  }

  /*
   * Tablet
   */
  @media (max-width: 1023px) {
    .AboutHero {
      margin-inline: var(--space-sm);
      overflow: hidden;
    }

    .AboutHero > .container {
      width: 100%;
    }

    .AboutHero__intro {
      max-width: 100%;

      h1 {
        font-size: clamp(2.4rem, 7vw, 4.5rem);
        line-height: 1.05;
      }

      .prose {
        max-width: 44rem;

        p {
          font-size: clamp(1rem, 2vw, 1.12rem);
          line-height: 1.7;
        }
      }
    }

    .AboutHero__gallery {
      position: relative;
      inset: auto;

      width: 100%;
      margin-top: clamp(2.5rem, 6vw, 4rem);
      padding: 0;

      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(1rem, 3vw, 1.5rem);
    }

    .AboutHero__galleryCol {
      gap: clamp(1rem, 3vw, 1.5rem);

      &--2 {
        padding-top: clamp(1rem, 3vw, 2rem);
      }
    }

    .AboutHero__galleryItem {
      width: 100%;

      .frame {
        aspect-ratio: 4 / 5;
      }
    }
  }

  /*
   * Mobile
   */
  @media (max-width: 639px) {
    .AboutHero {
      margin-inline: 0.75rem;
      border-radius: 18px;

      --section-pb: 1.5rem;
    }

    .AboutHero > .container {
      padding-inline: 1rem;
    }

    .AboutHero__intro {
      gap: 1.25rem;

      h1 {
        font-size: clamp(2rem, 10vw, 3.1rem);
        line-height: 1.05;
      }

      .prose p {
        font-size: 0.98rem;
        line-height: 1.65;
      }
    }

    .AboutHero__intro .actions {
      width: 100%;
    }

    .AboutHero__intro .btn {
      width: 100%;
      justify-content: center;
    }

    .AboutHero__gallery {
      display: flex;
      flex-direction: column;

      width: 100%;
      margin-top: 2rem;
      gap: 1rem;
    }

    .AboutHero__galleryCol {
      display: contents;
    }

    .AboutHero__galleryCol--2 {
      padding-top: 0;
    }

    .AboutHero__galleryItem {
      width: 100%;
      height: auto;

      .anchor-content {
        width: 100%;
        height: auto;
      }

      .frame {
        width: 100%;
        height: auto;
        aspect-ratio: auto;
        overflow: hidden;
      }

      img {
        display: block;
        width: 100%;
        height: auto;
        max-height: none;
        object-fit: contain;
        object-position: center;
      }
    }

    .AboutHero__photoTag {
      left: 0.75rem;
      bottom: 0.75rem;
    }

    .reactive-divider {
      width: 100%;
      max-width: 100%;
    }
  }

  /*
   * Very small phones
   */
  @media (max-width: 380px) {
    .AboutHero {
      margin-inline: 0.5rem;
    }

    .AboutHero > .container {
      padding-inline: 0.75rem;
    }

    .AboutHero__intro h1 {
      font-size: 1.9rem;
    }

    .AboutHero__gallery {
      gap: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .AboutHero__galleryItem {
      will-change: auto;
    }
  }
</style>
