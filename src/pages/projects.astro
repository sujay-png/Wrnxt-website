---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTA from '../components/CTA.astro';
---

<Layout title="Projects | Salo">
  <Header />

  <main>
    <div data-block-type="projectCarousel" data-first="true">
      <section class="section ProjectCarouselBlock" data-index="0" data-padding="xl">
        <div class="stack" data-gap="xl">
          <div class="container">
            <div class="cluster carousel-header" data-align="center" data-gap="sm" data-justify="between">
              <h2 class="heading" data-color="foreground" data-font-size="4" data-trim="normal" data-weight="regular">
                Projects
              </h2>
              <div class="cluster reel-nav carousel-nav" data-align="center" data-gap="lg" data-justify="start" data-reel-id="carousel-0" data-reel-nav="true" x-data="{ progress: 0 }">
                <button aria-label="Previous project" class="btn size-md ghost icon-only" data-reel-prev="true" type="button">
                  <span class="btn-content">
                    <span aria-hidden="true" class="icon" role="img" style="--icon-size:1em;">
                      <svg aria-hidden="true" class="lucide lucide-arrow-left" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg">
                        <path d="m12 19-7-7 7-7"></path>
                        <path d="M19 12H5"></path>
                      </svg>
                    </span>
                  </span>
                </button>
                <div class="progress-bar">
                  <div class="progress-fill" x-bind:style="`width: ${progress}%`"></div>
                </div>
                <button aria-label="Next project" class="btn size-md ghost icon-only" data-reel-next="true" type="button">
                  <span class="btn-content">
                    <span aria-hidden="true" class="icon" role="img" style="--icon-size:1em;">
                      <svg aria-hidden="true" class="lucide lucide-arrow-right" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M5 12h14"></path>
                        <path d="m12 5 7 7-7 7"></path>
                      </svg>
                    </span>
                  </span>
                </button>
              </div>
            </div>
          </div>
          
          <ul class="reel carousel" data-gap="xl-4xl" id="carousel-0">
            <!-- Slide 1: Wilderness -->
            <li class="cluster item" data-align="start" data-gap="2xl" data-justify="start" data-nowrap="">
              <a class="gradient-border content" href="/projects/wilderness">
                <div class="stack inner" data-align="start">
                  <div class="frame mobile-image" style="--frame-ratio:4/3;--frame-pos:center;">
                    <img alt="Simpson Travel Website design." decoding="async" fetchpriority="auto" height="1629" loading="lazy" src="https://media.salo.uk/salo-website-prod/simpson-travel-desktop-1.jpg" width="2160"/>
                  </div>
                  <div class="anchor-card anchor-card--simple logoCard">
                    <div class="anchor-content">
                      <div data-color-scheme="dark">
                        <img alt="Wilderness logo." class="logo" decoding="async" fetchpriority="auto" height="120" loading="lazy" src="https://media.salo.uk/salo-website-prod/wilderness.svg" width="160"/>
                      </div>
                    </div>
                  </div>
                  <div class="cluster categories" data-align="center" data-gap-x="md" data-justify="start">
                    <span class="Tag" style="--tag-color:var(--color-purple)">
                      High-Performing Website
                    </span>
                  </div>
                  <h3 class="heading" data-color="foreground" data-font-size="1" data-trim="normal" data-weight="regular">
                    Optimising conversion without compromising luxury
                  </h3>
                  <div class="prose prose--md">
                    <p>
                      We redesigned user journeys across the site to make them smoother and more intuitive.
                    </p>
                  </div>
                  <span class="btn size-md secondary">
                    <span class="btn-content">
                      View Project
                      <span aria-hidden="true" class="icon" role="img" style="--icon-size:1em;">
                        <svg aria-hidden="true" class="lucide lucide-arrow-right" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg">
                          <path d="M5 12h14"></path>
                          <path d="m12 5 7 7-7 7"></path>
                        </svg>
                      </span>
                    </span>
                  </span>
                </div>
              </a>
              <a class="anchor-card anchor-card--rounded image" href="/projects/wilderness">
                <svg class="anchor-border" height="100%" preserveAspectRatio="none" width="100%">
                  <rect height="calc(100% - 7px)" rx="16" ry="16" width="calc(100% - 7px)" x="3.5" y="3.5"></rect>
                  <circle cx="19.5" cy="3.5" r="3"></circle>
                  <circle cx="calc(100% - 19.5px)" cy="3.5" r="3"></circle>
                  <circle cx="19.5" cy="calc(100% - 3.5px)" r="3"></circle>
                  <circle cx="calc(100% - 19.5px)" cy="calc(100% - 3.5px)" r="3"></circle>
                  <circle cx="3.5" cy="19.5" r="3"></circle>
                  <circle cx="3.5" cy="calc(100% - 19.5px)" r="3"></circle>
                  <circle cx="calc(100% - 3.5px)" cy="19.5" r="3"></circle>
                  <circle cx="calc(100% - 3.5px)" cy="calc(100% - 19.5px)" r="3"></circle>
                </svg>
                <div class="anchor-content">
                  <div class="frame" style="--frame-ratio:250/543;--frame-pos:center;">
                    <img alt="Simpson Travel Website design." decoding="async" fetchpriority="auto" height="1629" loading="lazy" src="https://media.salo.uk/salo-website-prod/simpson-travel-mobile-2.jpg" width="750"/>
                  </div>
                </div>
