---
const services = [
  {
    category: "Brand Strategy",
    icon: "◆",
    tools: ["Positioning", "Messaging", "Visual Identity"],
  },
  {
    category: "Content Marketing",
    icon: "◈",
    tools: ["Blog", "Video", "Social", "Copywriting"],
  },
  {
    category: "Paid Media",
    icon: "◇",
    tools: ["Google Ads", "Meta Ads", "Programmatic"],
  },
  {
    category: "SEO & Organic Growth",
    icon: "◉",
    tools: ["Technical SEO", "Content Optimization", "Link Building"],
  },
  {
    category: "Email & CRM",
    icon: "◐",
    tools: ["Lifecycle Campaigns", "Automation", "Segmentation"],
  },
  {
    category: "Analytics & Reporting",
    icon: "◭",
    tools: ["Attribution", "Dashboards", "A/B Testing"],
  },
];
---

<section class="marketing-section">
  <div class="marketing-glow marketing-glow--1" aria-hidden="true"></div>
  <div class="marketing-glow marketing-glow--2" aria-hidden="true"></div>

  <div class="marketing-section__inner">

    <div class="marketing-section__header">
      <p class="marketing-eyebrow">Our marketing services</p>
      <h2 class="marketing-heading">Strategy that<br>drives <span class="highlight">growth</span></h2>
      <p class="marketing-body">
        From brand positioning to performance reporting, every service is
        built to turn attention into measurable results.
      </p>
    </div>

    <div class="marketing-grid">
      {services.map((service) => (
        <div class="marketing-card">
          <span class="marketing-card__border" aria-hidden="true"></span>

          <div class="marketing-card__head">
            <span class="marketing-card__icon">{service.icon}</span>
            <p class="marketing-card__category">{service.category}</p>
          </div>

          <ul class="marketing-card__tools">
            {service.tools.map((tool) => (
              <li class="marketing-card__tool">{tool}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>

  </div>
</section>

<style lang="scss">
.marketing-section {
  border-top: 1px solid var(--color-border);
  background: var(--color-bg);
  position: relative;
  overflow: hidden;
}

.marketing-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(100px);
  pointer-events: none;
  z-index: 0;
}

.marketing-glow--1 {
  width: 420px;
  height: 420px;
  top: -140px;
  left: -80px;
  background: radial-gradient(circle, rgba(127, 252, 255, 0.12), transparent 70%);
}

.marketing-glow--2 {
  width: 380px;
  height: 380px;
  bottom: -160px;
  right: -60px;
  background: radial-gradient(circle, rgba(168, 127, 255, 0.1), transparent 70%);
}

.marketing-section__inner {
  position: relative;
  z-index: 1;
  padding: 100px 80px;
  max-width: 1200px;
  margin: 0 auto;

  @media (max-width: 900px) {
    padding: 60px var(--space-md);
  }
}

.marketing-section__header {
  max-width: 480px;
  margin-bottom: 56px;
}

.marketing-eyebrow {
  font-size: var(--font-size--1);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-foreground-secondary);
  margin-bottom: 12px;
  display: flex;
  align-items: center;
  gap: 8px;

  &::before {
    content: '';
    width: 24px;
    height: 1px;
    background: linear-gradient(90deg, #7ffcff, rgba(168, 127, 255, 0.3));
  }
}

.marketing-heading {
  font-size: clamp(2rem, 3.5vw, 3rem);
  font-weight: var(--font-weight-normal);
  line-height: 1.08;
  letter-spacing: var(--letter-spacing-tight);
  color: var(--color-foreground);
  margin-bottom: 16px;

  .highlight {
    background: linear-gradient(120deg, #7ffcff, #a87fff 60%, #7ffcff);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
}

.marketing-body {
  font-size: var(--font-size--1);
  line-height: 1.7;
  color: var(--color-foreground-secondary);
  max-width: 42ch;
}

.marketing-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;

  @media (max-width: 900px) {
    grid-template-columns: repeat(2, 1fr);
  }

  @media (max-width: 560px) {
    grid-template-columns: 1fr;
  }
}

.marketing-card {
  position: relative;
  padding: 32px 26px;
  border-radius: var(--radius-md);
  border: 1px solid var(--color-border);
  background: linear-gradient(160deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.01));
}

.marketing-card__border {
  position: absolute;
  inset: 0;
  border-radius: inherit;
  padding: 1px;
  background: conic-gradient(from 0deg, #7ffcff, #a87fff, #7ffcff, #a87fff, #7ffcff);
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  opacity: 0;
  pointer-events: none;
}

.marketing-card:hover .marketing-card__border {
  opacity: 1;
}

.marketing-card__head {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 22px;
}

.marketing-card__icon {
  width: 38px;
  height: 38px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
  font-size: 15px;
  background: linear-gradient(160deg, rgba(127, 252, 255, 0.14), rgba(168, 127, 255, 0.08));
  border: 1px solid rgba(127, 252, 255, 0.2);
  color: #7ffcff;
}

.marketing-card__category {
  font-size: 13px;
  letter-spacing: 0.04em;
  font-weight: 600;
  color: var(--color-foreground);
  margin: 0;
}

.marketing-card__tools {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.marketing-card__tool {
  font-size: 12.5px;
  font-weight: 500;
  color: var(--color-foreground-secondary);
  padding: 7px 13px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.09);
}

.marketing-card:hover .marketing-card__tool {
  color: var(--color-foreground);
}

.marketing-card__tool:hover {
  background: rgba(127, 252, 255, 0.12);
  border-color: rgba(127, 252, 255, 0.3);
}
</style>