---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ServiceHero from '../../components/servicehero.astro';
import ServiceCards from '../../components/servicescard.astro';
import StatsBar from '../../components/StatsBar.astro';
import TechStack from '../../components/TechStack.astro';
import Testimonials from '../../components/Testimonials.astro';
import CTABanner from '../../components/CTABanner.astro';
import { heroImages, services } from '../../data/website';
import Websitecard from '../../components/Websitecard.astro';
---

<Layout title="IT Services — Akshara Digital">
  <Header />

  <div class="bg-dots" aria-hidden="true"></div>

 
   <ServiceHero
  eyebrow="Our services"
  title="Media House Service.
Stronger Business."
  desc="Professional media production services to bring your creative vision to life with excellence"
  images={heroImages}
/>

  <StatsBar />
  <Websitecard services={services} />
  <TechStack />
  <!-- <Testimonials /> -->
  <CTABanner />
  <Footer />
</Layout>

<style>
  .bg-dots {
    position: fixed;
    inset: 0;
    background-image: radial-gradient(var(--color-border) 1px, transparent 1px);
    background-size: 24px 24px;
    opacity: 0.12;
    pointer-events: none;
    z-index: 0;
  }
</style>
