---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import CTA from "../../components/CTA.astro";
import postsData from "../../data/posts.json";

export async function getStaticPaths() {
  const blogPosts = [
    {
      title: "Elevating Brands in Mangalore: The Akshara Digital Approach",
      slug: "elevating-brands-mangalore",
      subtitle: "How we combine strategic thinking with stunning visual design to help local and global businesses stand out.",
      excerpt: "At Akshara Digital, we believe that a brand is more than just a logo. It's the entire experience your customers have with your company. From our base in Mangalore, we are helping businesses redefine their digital presence with cohesive branding and cutting-edge web design.",
      image: "https://images.unsplash.com/photo-1542744173-8e7e53415bb0?q=80&w=1200&auto=format&fit=crop",
      author: "By Team Akshara",
      date: "18 Aug 2026",
      tags: ["Branding", "Visual Identity"],
      ratio: "16/9",
      framePos: "center",
    },
    {
      title: "Why Staff Augmentation is the Secret Weapon for Tech Growth",
      slug: "staff-augmentation-tech-growth",
      subtitle: "Scaling your IT capabilities without the overhead of traditional hiring.",
      excerpt: "In today's fast-paced tech landscape, agility is everything. Our Staff Augmentation services at Wrnxt allow companies to seamlessly integrate top-tier talent into their existing teams, filling skill gaps and accelerating project timelines without long-term commitments.",
      image: "https://images.unsplash.com/photo-1522071820081-009f0129c71c?q=80&w=1200&auto=format&fit=crop",
      author: "By Team Wrnxt",
      date: "12 Aug 2026",
      tags: ["IT Services", "Tech Growth"],
      ratio: "16/9",
      framePos: "center",
    },
    {
      title: "The Future of Web Design: Blending Aesthetics with Performance",
      slug: "future-web-design-performance",
      subtitle: "Why a beautiful website must also be lightning-fast and accessible.",
      excerpt: "A visually stunning website is useless if it takes too long to load or frustrates users. We explore how the team at Akshara Digital balances rich aesthetics—like dark modes and micro-animations—with uncompromising performance and UX best practices.",
      image: "https://images.unsplash.com/photo-1498050108023-c5249f4df085?q=80&w=1200&auto=format&fit=crop",
      author: "By Team Akshara",
      date: "05 Aug 2026",
      tags: ["UI / UX", "High-Performing Website"],
      ratio: "16/9",
      framePos: "center",
    },
    {
      title: "Transforming Hardware & IT Services for Modern Businesses",
      slug: "transforming-hardware-it-services",
      subtitle: "Reliable infrastructure is the backbone of any successful digital transformation.",
      excerpt: "From setting up robust hardware networks to providing ongoing IT support, Wrnxt ensures that businesses have the reliable infrastructure they need to operate smoothly. Discover how our comprehensive IT solutions are empowering companies in Mangalore and beyond.",
      image: "https://images.unsplash.com/photo-1518770660439-4636190af475?q=80&w=1200&auto=format&fit=crop",
      author: "By Team Wrnxt",
      date: "28 Jul 2026",
      tags: ["Hardware", "IT Services"],
      ratio: "16/9",
      framePos: "center",
    }
  ];

  return blogPosts.map((post, idx) => {
    // Select the next 2 posts as related ones
    const related1 = blogPosts[(idx + 1) % blogPosts.length];
    const related2 = blogPosts[(idx + 2) % blogPosts.length];

    return {
      params: { slug: post.slug },
      props: {
        post,
        related: [related1, related2],
      },
    };
  });
}

const { post, related } = Astro.props;
const { slug } = Astro.params;
const postBody = postsData[slug as keyof typeof postsData] || { prose_html: "<p>Content loading...</p>" };
---

<Layout
  title={`${post.title} | Blog | Akshara Digital`}
  description={post.subtitle || post.excerpt}
>
  <Header />

  <main class="page--blog-post">
    <!-- Header Block -->
    <section class="section BlogPostHeader" data-pb="0" data-pt="lg">
      <div class="container" data-size="wide">
        <div class="stack" data-gap="lg">
          <div class="stack" data-gap="sm">
            <h1
              class="heading"
              data-color="foreground"
              data-font-size="5"
              data-trim="normal"
              data-weight="regular"
            >
              {post.title}
            </h1>

            {post.subtitle && <p class="subtitle">{post.subtitle}</p>}

            <div class="meta">
              <span class="author">{post.author}</span>
              <span aria-hidden="true" class="separator">&middot;</span>
              <time>{post.date}</time>
            </div>
          </div>

          <div
            class="frame featured-image"
            style={`--frame-ratio:${post.ratio || "16/9"}; --frame-pos:${post.framePos || "center"};`}
          >
            <img
              src={post.image}
              alt={post.title}
              transition:name={`blog-img-${post.slug}`}
              decoding="async"
              fetchpriority="high"
              loading="eager"
              width="1200"
              height="900"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Main Prose Body Section -->
    <section class="section" data-padding="md">
      <div class="container content-container" data-size="wide">
        <div class="prose">
          <Fragment set:html={postBody.prose_html} />
        </div>
      </div>
    </section>

    <!-- Related Posts Section -->
    <section class="section RelatedPostsSection" data-padding="lg">
      <div class="container" data-size="wide">
        <div class="stack" data-gap="lg">
          <h2 class="heading" data-font-size="3" data-weight="regular">
            Related posts
          </h2>

          <div class="related-grid">
            {
              related.map((rel) => (
                <article class="related-card">
                  <a href={`/blog/${rel.slug}`} class="related-link">
                    <div class="anchor-card anchor-card--rounded image">
                      <svg
                        class="anchor-border"
                        width="100%"
                        height="100%"
                        preserveAspectRatio="none"
                      >
                        <rect
                          x="3.5"
                          y="3.5"
                          width="calc(100% - 7px)"
                          height="calc(100% - 7px)"
                          rx="16"
                          ry="16"
                        />
                        <circle cx="19.5" cy="3.5" r="3" />
                        <circle cx="calc(100% - 19.5px)" cy="3.5" r="3" />
                        <circle cx="19.5" cy="calc(100% - 3.5px)" r="3" />
                        <circle
                          cx="calc(100% - 19.5px)"
                          cy="calc(100% - 3.5px)"
                          r="3"
                        />
                        <circle cx="3.5" cy="19.5" r="3" />
                        <circle cx="3.5" cy="calc(100% - 19.5px)" r="3" />
                        <circle cx="calc(100% - 3.5px)" cy="19.5" r="3" />
                        <circle
                          cx="calc(100% - 3.5px)"
                          cy="calc(100% - 19.5px)"
                          r="3"
                        />
                      </svg>
                      <div class="anchor-content">
                        <div
                          class="frame"
                          style="--frame-ratio:4/3; --frame-pos:center;"
                        >
                          <img
                            src={rel.image}
                            alt={rel.title}
                            transition:name={`blog-img-${rel.slug}`}
                            loading="lazy"
                            decoding="async"
                          />
                        </div>
                      </div>
                    </div>

                    <div class="stack content" data-gap="2xs">
                      {rel.tags && rel.tags.length > 0 && (
                        <div class="related-tags">
                          {rel.tags.map((tag) => {
                            const tagColor =
                              tag === "UI / UX" || tag === "Design System"
                                ? "var(--color-blue, #0d99ff)"
                                : tag === "Branding" ||
                                    tag === "Visual Identity"
                                  ? "var(--color-pink, #ff24bd)"
                                  : tag === "High-Performing Website"
                                    ? "var(--color-green, #b9ff36)"
                                    : tag === "Web/Email Graphics"
                                      ? "var(--color-yellow, #ffcd29)"
                                      : "var(--color-foreground-secondary)";
                            return (
                              <span
                                class="Tag"
                                style={`--tag-color: ${tagColor}`}
                              >
                                {tag}
                              </span>
                            );
                          })}
                        </div>
                      )}

                      <h3 class="heading" data-font-size="1">
                        {rel.title}
                      </h3>
                      <span class="read-more-link">Read more &rarr;</span>
                    </div>
                  </a>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <CTA />
  </main>

  <Footer />
</Layout>

<script>
  function unlockScroll() {
    document.documentElement.style.overflow = "";
  }
  document.addEventListener("astro:page-load", unlockScroll);
  if (
    document.readyState === "complete" ||
    document.readyState === "interactive"
  ) {
    unlockScroll();
  } else {
    document.addEventListener('astro:page-load', unlockScroll);
  }
</script>
