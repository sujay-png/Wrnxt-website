---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ServiceHero from '../../components/servicehero.astro';
import ServiceCards from '../../components/servicescard.astro';
import StatsBar from '../../components/StatsBar.astro';
import Marketingstack from '../../components/Marketingstack.astro';
import Testimonials from '../../components/Testimonials.astro';
import CTABanner from '../../components/CTABanner.astro';
import { heroImages, services } from '../../data/branding';
import Websitecard from '../../components/Websitecard.astro';
import BrandingCard from '../../components/BrandingCards.astro';
import MarketingApproach from '../../components/Marketingapproch.astro';
---

<Layout title="IT Services — WRNXT">
  <Header />

  <div class="bg-dots" aria-hidden="true"></div>
<ServiceHero
  eyebrow="Our services"
  title="Marketing."
  desc="Strategic marketing solutions to elevate your brand and reach your target audience effectively"
 
  images={heroImages}
/>
 

  <StatsBar />
  <BrandingCard services={services} />
  <Marketingstack />
  <MarketingApproach />
  <CTABanner />
  <Footer />
</Layout>

<style>
  .bg-dots {
    position: fixed;
    inset: 0;
    background-image: radial-gradient(var(--color-border) 1px, transparent 1px);
    background-size: 24px 24px;
    opacity: 0.12;
    pointer-events: none;
    z-index: 0;
  }
</style>

