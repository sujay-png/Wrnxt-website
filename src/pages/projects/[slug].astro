---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTA from '../../components/CTA.astro';
import projectsData from '../../data/projects.json';

export async function getStaticPaths() {
  const projectsList = [
    {
      slug: "wilderness",
      title: "Optimising conversion without compromising luxury",
      client: "Wilderness Safaris",
      logo: "https://media.salo.uk/salo-website-prod/wilderness.svg",
      category: "High-Performing Website",
      tagColor: "var(--color-purple)"
    },
    {
      slug: "BBD-Boom",
      title: "Fully integrated design support for a high-volume Hubspot agency",
      client: "BBD Boom",
      logo: "https://media.salo.uk/salo-website-prod/bbd-boom.svg",
      category: "High-Performing Website",
      tagColor: "var(--color-purple)"
    },
    {
      slug: "roswell",
      title: "A bold new identity for a Shopify Platinum Partner",
      client: "Roswell NYC",
      logo: "https://media.salo.uk/salo-website-prod/roswell.svg",
      category: "UI / UX",
      tagColor: "var(--color-green)"
    },
    {
      slug: "solent-rib-charter",
      title: "Modernising a group of sites for a marine services provider",
      client: "Solent Rib Charter",
      logo: "https://media.salo.uk/salo-website-prod/src.svg",
      category: "High-Performing Website",
      tagColor: "var(--color-purple)"
    }
  ];

  return projectsList.map((proj, idx) => {
    const nextProj = projectsList[(idx + 1) % projectsList.length];
    return {
      params: { slug: proj.slug },
      props: { project: proj, nextProject: nextProj }
    };
  });
}

const { project, nextProject } = Astro.props;
const { slug } = Astro.params;
const projectBody = projectsData[slug as keyof typeof projectsData] || { prose_html: "<p>Case study content loading...</p>" };
---

<Layout title={`${project.title} | Projects | Salo`} description={project.title}>
  <Header />

  <main class="page--project-post">
    <!-- Project Header -->
    <section class="section BlogPostHeader" data-pb="0" data-pt="lg">
      <div class="container" data-size="wide">
        <div class="stack" data-gap="lg">
          <div class="stack" data-gap="sm">
            <h1 class="heading" data-color="foreground" data-font-size="5" data-trim="normal" data-weight="regular">
              {project.title}
            </h1>
            <div class="cluster" data-gap="md" data-align="center">
              <span class="Tag" style={`--tag-color: ${project.tagColor}`}>{project.category}</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Main Scraped Case Study Sections -->
    <div class="project-sections-wrapper">
      <Fragment set:html={projectBody.prose_html} />
    </div>

    <!-- Next Project Navigation -->
    <section class="section NextProjectSection" data-padding="lg">
      <div class="container" data-size="wide">
        <div class="stack" data-gap="lg">
          <h2 class="heading" data-font-size="3" data-weight="regular">Next project</h2>
          
          <article class="related-card ShowcaseCard">
            <a href={`/projects/${nextProject.slug}`} class="related-link" style="display: block; text-decoration: none; color: inherit;">
              <div class="stack content" data-gap="sm">
                <span class="Tag" style={`--tag-color: ${nextProject.tagColor}`}>{nextProject.category}</span>
                <h3 class="heading" data-font-size="2">{nextProject.title}</h3>
                <span class="read-more-link" style="color: var(--color-pink); font-size: var(--font-size-1);">View Case Study &rarr;</span>
              </div>
            </a>
          </article>
        </div>
      </div>
    </section>

    <CTA />
  </main>

  <Footer />
</Layout>

<style lang="scss" is:global>
  .page--project-post {
    .BlogPostHeader {
      padding-top: calc(var(--header-height) + var(--space-md));
      
      @media (max-width: 767px) {
        padding-top: calc(var(--header-height) + var(--space-lg));
      }
    }

    .project-sections-wrapper {
      .MediaBlock {
        padding-block: var(--space-md);
        
        .frame {
          border-radius: var(--radius-md);
          overflow: hidden;
          background-color: var(--color-bg-alt);
        }
      }

      .TextBlock {
        padding-block: var(--space-md);

        h2, h3 {
          margin-bottom: var(--space-xs);
        }
        
        p {
          color: var(--color-foreground-secondary);
        }
      }

      .lexical-stats, .lexical-callout {
        background: var(--color-bg-alt);
        border-radius: var(--radius-md);
        margin-block: var(--space-md);

        .inner {
          padding: var(--space-md);
        }
      }

      .lexical-stats {
        .inner {
          display: flex;
          flex-direction: column;
          gap: var(--space-md);
        }

        &__item {
          padding: 0;
          gap: 4px;
        }

        &__value {
          font-weight: 500;
        }
      }

      .lexical-testimonial {
        background: var(--color-bg-alt);
        border-radius: var(--radius-md);
        padding: var(--space-lg);
        margin-block: var(--space-xl);

        p {
          font-style: italic;
          font-size: var(--font-size-1);
          color: var(--color-foreground);
        }

        &__attribution {
          margin-top: var(--space-md);
          cite {
            font-size: var(--font-size--1);
          }
        }
      }

      .LexicalTeamBlock {
        margin-block: var(--space-xl);

        .Avatar {
          width: 3rem;
          height: 3rem;
          border-radius: 50%;
          overflow: hidden;
        }

        p {
          color: var(--color-foreground);
          font-weight: 500;
        }
      }
    }

    .NextProjectSection {
      .ShowcaseCard {
        background: var(--color-bg-alt);
        border-radius: var(--radius-md);
        border: 1px solid var(--color-border);
        padding: var(--space-lg);
      }
    }
  }
</style>
