<script>
  import Alpine from 'alpinejs';

  if (!(window as any).__showcaseAlpineRegistered) {
    (window as any).__showcaseAlpineRegistered = true;
    
    // Custom cursor hover/move logic for desktop showcase
    document.addEventListener("alpine:init", () => {
      Alpine.data("showcaseCursor", () => ({
        cursorVisible: false,
        init() {
          const wrapper = this.$el;
          const cursor = this.$refs.cursor;
          
          if (!wrapper || !cursor) return;
          
          const onMouseMove = (e: MouseEvent) => {
            const rect = wrapper.getBoundingClientRect();
            // Check if mouse is inside bounding box
            if (
              e.clientX >= rect.left &&
              e.clientX <= rect.right &&
              e.clientY >= rect.top &&
              e.clientY <= rect.bottom
            ) {
              this.cursorVisible = true;
              cursor.style.left = `${e.clientX}px`;
              cursor.style.top = `${e.clientY}px`;
            } else {
              this.cursorVisible = false;
            }
          };

          const onMouseLeave = () => {
            this.cursorVisible = false;
          };

          const isHoverAvailable = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
          if (isHoverAvailable) {
            window.addEventListener("mousemove", onMouseMove);
            wrapper.addEventListener("mouseleave", onMouseLeave);
          }
        }
      }));

      // Mobile carousel navigation
      Alpine.data("showcaseCarousel", () => ({
        prevDisabled: true,
        nextDisabled: false,
        progressWidth: 0,
        updateStates() {
          const carousel = this.$refs.carousel;
          if (!carousel) return;
          const scrollLeft = carousel.scrollLeft;
          const maxScroll = carousel.scrollWidth - carousel.clientWidth;
          
          this.prevDisabled = scrollLeft <= 5;
          this.nextDisabled = scrollLeft >= maxScroll - 5;
          this.progressWidth = maxScroll > 0 ? (scrollLeft / maxScroll) * 100 : 0;
        },
        scrollNext() {
          const carousel = this.$refs.carousel;
          if (!carousel) return;
          const distance = carousel.clientWidth * 0.8;
          carousel.scrollBy({ left: distance, behavior: 'smooth' });
        },
        scrollPrev() {
          const carousel = this.$refs.carousel;
          if (!carousel) return;
          const distance = carousel.clientWidth * 0.8;
          carousel.scrollBy({ left: -distance, behavior: 'smooth' });
        }
      }));
    });
  }
</script>

<style lang="scss">
  // Desktop Horizontal Showcase Layout
  .HomeShowcase {
    --details-width: var(--measure-sm);
    --details-arrow-offset: var(--space-3xl);
    --border-inset: 24px;
    --border-radius: 16px;
    --border-opacity: 1;
    height: 100vh;
    position: relative;
    overflow: hidden;
    background-color: var(--color-bg);
    
    @media (max-width: 1023px) {
      height: auto;
      border-bottom: 1px solid var(--color-border);
    }
    
    &::after {
      content: "";
      position: absolute;
      inset: var(--border-inset);
      border: 1px solid rgba(110, 110, 110, var(--border-opacity));
      border-radius: var(--border-radius);
      pointer-events: none;
      z-index: 10;
      transition: border-color 0.3s var(--ease);
      
      @media (max-width: 1023px) {
        display: none;
      }
    }
    
    &__outerFrame {
      width: 100%;
      height: 100%;
      display: flex;
      overflow: hidden;
      position: relative;
      background: var(--color-neutral-950);
      
      @media (max-width: 1023px) {
        display: none !important;
      }
    }
    
    &__inner {
      cursor: none;
      display: grid;
      grid-template-columns: 100vw auto 100vw;
      height: 100%;
      position: absolute;
      top: 0;
      left: 0;
      bottom: 0;
      will-change: transform;
      
      > * {
        flex-shrink: 0;
      }
    }
    
    &__intro, &__ender {
      width: 100vw;
      height: 100%;
      flex-shrink: 0;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      align-items: center;
      justify-content: center;
      position: relative;
      padding: var(--space-xl);
      text-align: center;
      
      .introText {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        width: 100%;
      }
      
      .eyebrow {
        font-size: var(--font-size-1);
      }
    }
    
    &__middle {
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100%;
      flex-shrink: 0;
      padding-inline-end: 50ch;
      padding-inline-start: 20ch;
      
      .imageCard {
        position: relative !important;
        min-width: 500px;
      }
      
      .imageCard--desktop {
        position: relative !important;
        aspect-ratio: 4 / 3;
        max-width: 800px;
        width: 40vw;
        height: auto;
      }
      
      .arrow {
        transform: rotate(90deg) scaleY(-1) translateY(13px);
        margin-block-end: 0;
        margin-block-start: 3px;
        z-index: 8;
        position: relative;
      }
      
      .imageCardWrapper {
        width: 100%;
        align-items: center;
        justify-content: center;
      }
      
      .ShowcaseCard {
