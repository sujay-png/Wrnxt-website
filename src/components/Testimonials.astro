---
interface Testimonial {
  quote: string;
  name: string;
  role: string;
  avatar: string;
  rating: number;
}

const testimonials: Testimonial[] = [
  {
    quote: "CoreTech revolutionized our business with top-tier IT solutions, including cloud, AI, and cybersecurity. Truly a game-changer!",
    name: "Alex",
    role: "CTO of Global Retail Hub",
    avatar: "https://i.pravatar.cc/100?img=13",
    rating: 5.0,
  },
  {
    quote: "Their cloud migration services were seamless, boosting efficiency and security. CoreTech is a trusted IT partner!",
    name: "Emily",
    role: "COO of SmartLogix",
    avatar: "https://i.pravatar.cc/100?img=47",
    rating: 5.0,
  },
  {
    quote: "We trust CoreTech for cloud security. Their expertise keeps our business data safe and accessible analytics.",
    name: "Brian",
    role: "Managing Director",
    avatar: "https://i.pravatar.cc/100?img=14",
    rating: 5.0,
  },
];
---

<section class="testimonials">
  <div class="testimonials__inner">

    <div class="testimonials__header">
      <p class="eyebrow">Testimonials</p>
      <h2 class="heading">What our clients say</h2>
    </div>

    <div class="testimonials__carousel">
      <button class="carousel-arrow carousel-arrow--prev" aria-label="Previous testimonial">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      </button>

      <div class="testimonial-grid">
        {testimonials.map((t) => (
          <article class="t-card">
            <div class="t-card__head">
              <img src={t.avatar} alt={t.name} class="t-card__avatar" loading="lazy" />
              <div>
                <p class="t-card__name">{t.name}</p>
                <p class="t-card__role">{t.role}</p>
              </div>
            </div>

            <div class="t-card__divider"></div>

            <blockquote>
              <p>{t.quote}</p>
            </blockquote>

           
          </article>
        ))}
      </div>

      <button class="carousel-arrow carousel-arrow--next" aria-label="Next testimonial">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>

  </div>
</section>

<style lang="scss">
.testimonials {
  border-top: 1px solid var(--color-border);
  background: var(--color-bg);
}

.testimonials__inner {
  padding: 100px 80px;
  max-width: 1200px;
  margin: 0 auto;

  @media (max-width: 900px) {
    padding: 60px var(--space-md);
  }
}

.testimonials__header {
  margin-bottom: 40px;
}

.eyebrow {
  font-size: var(--font-size--1);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-foreground-secondary);
  margin-bottom: 10px;
}

.heading {
  font-size: clamp(1.8rem, 3vw, 2.5rem);
  font-weight: var(--font-weight-normal);
  letter-spacing: var(--letter-spacing-tight);
  color: var(--color-foreground);
  margin: 0;
}

/* ── Carousel row ── */
.testimonials__carousel {
  display: flex;
  align-items: center;
  gap: 16px;
}

.carousel-arrow {
  flex-shrink: 0;
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 1px solid var(--color-border);
  background: rgba(255, 255, 255, 0.03);
  color: var(--color-foreground-secondary);
  cursor: pointer;
  transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;

  &:hover {
    background: rgba(127, 252, 255, 0.1);
    border-color: rgba(127, 252, 255, 0.3);
    color: #7ffcff;
  }

  @media (max-width: 640px) {
    display: none;
  }
}

/* ── Grid ── */
.testimonial-grid {
  flex: 1;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;

  @media (max-width: 900px) {
    grid-template-columns: repeat(2, 1fr);
  }

  @media (max-width: 640px) {
    grid-template-columns: 1fr;
  }
}

/* ── Card ── */
.t-card {
  padding: 28px 26px;
  border-radius: var(--radius-md);
  border: 1px solid var(--color-border);
  background: rgba(255, 255, 255, 0.025);
  transition: transform 0.3s ease, border-color 0.3s ease, background 0.3s ease;

  &:hover {
    transform: translateY(-3px);
    border-color: rgba(127, 252, 255, 0.25);
    background: rgba(255, 255, 255, 0.04);
  }

  &__head {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  &__avatar {
    width: 52px;
    height: 52px;
    border-radius: 12px;
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  &__name {
    font-size: 15px;
    font-weight: 600;
    color: var(--color-foreground);
    margin: 0 0 3px;
  }

  &__role {
    font-size: 12.5px;
    color: var(--color-foreground-secondary);
    margin: 0;
  }

  &__divider {
    height: 1px;
    background: var(--color-border);
    margin: 20px 0;
  }

  blockquote {
    margin: 0 0 22px;

    p {
      font-size: 14px;
      font-style: italic;
      line-height: 1.7;
      color: var(--color-foreground-secondary);
      margin: 0;
    }
  }

  &__rating {
    display: flex;
    align-items: center;
    gap: 3px;
    color: #6d8bff;

    svg { flex-shrink: 0; }
  }

  &__rating-label {
    margin-left: 8px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #6d8bff;
  }
}
</style>

<script>
  const grid = document.querySelector<HTMLElement>('.testimonial-grid');
  const prevBtn = document.querySelector<HTMLButtonElement>('.carousel-arrow--prev');
  const nextBtn = document.querySelector<HTMLButtonElement>('.carousel-arrow--next');

  const scrollAmount = () => grid?.clientWidth ? grid.clientWidth * 0.9 : 300;

  prevBtn?.addEventListener('click', () => {
    grid?.scrollBy({ left: -scrollAmount(), behavior: 'smooth' });
  });

  nextBtn?.addEventListener('click', () => {
    grid?.scrollBy({ left: scrollAmount(), behavior: 'smooth' });
  });
</script>