---
interface Step {
  number: string;
  title: string;
  items: string[];
}

const steps: Step[] = [
  {
    number: "01",
    title: "Discover",
    items: ["Audience research", "Competitor analysis"],
  },
  {
    number: "02",
    title: "Strategize",
    items: ["Positioning", "Channel mix", "KPIs"],
  },
  {
    number: "03",
    title: "Execute",
    items: ["Campaigns", "Content", "Creative"],
  },
  {
    number: "04",
    title: "Optimize",
    items: ["Testing", "Iteration", "Reporting"],
  },
];
---

<section class="process">
  <div class="process__inner">

    <div class="process__header">
      <p class="eyebrow">Our process</p>
      <h2 class="heading">How we get you there</h2>
    </div>

    <div class="process-grid">
      {steps.map((step, i) => (
        <article class="p-card">
          <span class="p-card__number">{step.number}</span>

          <h3 class="p-card__title">{step.title}</h3>

          <div class="p-card__divider"></div>

          <ul class="p-card__items">
            {step.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>

          {i < steps.length - 1 && (
            <span class="p-card__connector" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
            </span>
          )}
        </article>
      ))}
    </div>

  </div>
</section>

<style lang="scss">
.process {
  border-top: 1px solid var(--color-border);
  background: var(--color-bg);
}

.process__inner {
  padding: 100px 80px;
  max-width: 1200px;
  margin: 0 auto;

  @media (max-width: 900px) {
    padding: 60px var(--space-md);
  }
}

.process__header {
  margin-bottom: 40px;
}

.eyebrow {
  font-size: var(--font-size--1);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-foreground-secondary);
  margin-bottom: 10px;
}

.heading {
  font-size: clamp(1.8rem, 3vw, 2.5rem);
  font-weight: var(--font-weight-normal);
  letter-spacing: var(--letter-spacing-tight);
  color: var(--color-foreground);
  margin: 0;
}

/* ── Grid ── */
.process-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;

  @media (max-width: 900px) {
    grid-template-columns: repeat(2, 1fr);
  }

  @media (max-width: 560px) {
    grid-template-columns: 1fr;
  }
}

/* ── Card ── */
.p-card {
  position: relative;
  padding: 28px 26px;
  border-radius: var(--radius-md);
  border: 1px solid var(--color-border);
  background: rgba(255, 255, 255, 0.025);
  transition: transform 0.3s ease, border-color 0.3s ease, background 0.3s ease;

  &:hover {
    transform: translateY(-3px);
    border-color: rgba(127, 252, 255, 0.25);
    background: rgba(255, 255, 255, 0.04);
  }

  &__number {
    display: block;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
    color: #7ffcff;
    margin-bottom: 14px;
  }

  &__title {
    font-size: 18px;
    font-weight: 600;
    color: var(--color-foreground);
    margin: 0;
  }

  &__divider {
    height: 1px;
    background: var(--color-border);
    margin: 18px 0;
  }

  &__items {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;

    li {
      font-size: 13.5px;
      line-height: 1.5;
      color: var(--color-foreground-secondary);
      padding-left: 14px;
      position: relative;

      &::before {
        content: '';
        position: absolute;
        left: 0;
        top: 8px;
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: rgba(127, 252, 255, 0.6);
      }
    }
  }

  &__connector {
    display: none;

    @media (min-width: 901px) {
      display: flex;
      align-items: center;
      justify-content: center;
      position: absolute;
      top: 50%;
      right: -30px;
      transform: translateY(-50%);
      width: 20px;
      height: 20px;
      color: var(--color-foreground-secondary);
      z-index: 2;
    }
  }
}
</style>