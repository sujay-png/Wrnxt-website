<!--
  FIX 3 — HERO SPACING:
  The .cover primitive in globals.scss is a flex column with
  gap: var(--cover-space, var(--space-md)).

  The original Hero passed --cover-space:var(--space-lg) via inline style.
  That gap applied between ALL three flex children:
    [empty div] [cover-center] [HomeHero__bottom]
  
  So both spacers above and below the content PLUS the gap before the marquee
  all used --space-lg — making everything feel cramped and the marquee too far
  from the content.

  The fix: remove --cover-space from the inline style entirely, and let the
  .cover grid layout (overridden in scoped styles below) control spacing
  instead. The Hero uses grid-template-rows: 1fr auto 1fr so the 1fr rows
  push the content to centre and the marquee sits flush at the bottom inside
  its own auto row. No gap needed.
-->
<section class="section HomeHero">
  <div class="cover" style="--cover-min-height:var(--hero-height);">
    <div></div>

    <div class="cover-center">
      <!-- Adi Ambient Cursor -->
