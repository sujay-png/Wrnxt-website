---
const cultureImages = [
  { src: "public/images/Group mine .jpg.jpeg", alt: "A group of seven colleagues smiling for a photo in front of a decorative wall with bookshelf motifs.", ratio: "1090/680", rotate: -4 },
  { src: "public/images/WhatsApp Image 2026-07-08 at 3.14.36 PM.jpeg", alt: "A person in a red fleece standing in a forest, aiming a recurve bow at two archery targets.", ratio: "1/1", rotate: -8 },
  { src: "public/images/IMG_1146.jpeg", alt: "Four men standing outside in front of a chain-link fence, one wearing a high-visibility event jacket and another in a red flight suit.", ratio: "680/934", rotate: -6 },
  { src: "public/images/IMG_1006.jpeg", alt: "Three smiling young men taking a selfie in the stands at a crowded stadium with red seats.", ratio: "932/680", rotate: 4 },
  { src: "public/images/image3.jpeg", alt: "A smiling man in a green shirt stands in front of a green Aston Martin Formula 1 safety car at a trackside display.", ratio: "444/922", rotate: 7 },
  { src: "public/images/Group 111.jpg.jpeg", alt: "Group of people posing for a photo at South Coast Karting under checkered flags.", ratio: "1060/680", rotate: -5 },
  { src: "public/images/Alisha 2.png", alt: "A young woman and man smiling in a university cafe setting, both wearing name tags.", ratio: "1/1", rotate: -8 },
  { src: "public/images/WhatsApp Image 2026-07-08 at 2.54.04 PM.jpeg", alt: "A group of five colleagues posing for a selfie during a scenic ocean sunset.", ratio: "752/558", rotate: 6 },
  { src: "public/images/WhatsApp Image 2026-07-08 at 2.54.04 PM (1).jpeg", alt: "Four people smiling for a selfie in front of a green sign, outdoors on a sunny day.", ratio: "1/1", rotate: 3 }
];
---

<section class="section AboutCulture" data-padding="xl">
  <div class="AboutCulture__collage">
    <div class="AboutCulture__photos">
      {cultureImages.map((img, idx) => (
        <div
          class={`anchor-card  anchor-card--rounded AboutCulture__item AboutCulture__item--${idx + 1}`}
          data-rotate={img.rotate}
          style={`--rotate:${img.rotate}deg;`}
        >
          <svg class="anchor-border" width="100%" height="100%" preserveAspectRatio="none">
            <rect x="3.5" y="3.5" width="calc(100% - 7px)" height="calc(100% - 7px)" rx="16" ry="16"></rect>
            <circle cx="19.5" cy="3.5" r="3"></circle>
            <circle cx="calc(100% - 19.5px)" cy="3.5" r="3"></circle>
            <circle cx="19.5" cy="calc(100% - 3.5px)" r="3"></circle>
            <circle cx="calc(100% - 19.5px)" cy="calc(100% - 3.5px)" r="3"></circle>
          </svg>
          <div class="anchor-content">
            <div class="frame" style={`--frame-ratio:${img.ratio};`}>
              <img src={img.src} alt={img.alt} loading="lazy" decoding="async" width="932" height="680" />
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="container" data-size="prose">
      <div class="stack AboutCulture__text" data-gap="lg" data-align="center">
        <span class="heading eyebrow">Our culture</span>
        <h2 class="heading" data-font-size="4">We're a fully remote team, but always connected.</h2>

        <div class="prose">
          <p>Regular socials and events sit at the heart of what we do, helping us stay close and collaborative. Great outcomes come from seamless teamwork, which is why our culture matters so much to us.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  .AboutCulture {
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-bg);
    overflow: clip;
  }

  .AboutCulture__collage {
    position: relative;
    height: 280rem;

    @media (max-width: 1023px) {
      height: auto;
      display: flex;
      flex-direction: column;
      gap: var(--space-xl);
      padding-block: var(--space-lg);
    }

    @media (max-width: 599px) {
      gap: var(--space-lg);
    }

    > .container {
      height: 100%;

      @media (max-width: 1023px) {
        height: auto;
        // Show the heading/copy ABOVE the photo grid on mobile, even though
        // it's the second element in the DOM (keeps source order sane for
        // screen readers while flipping the visual order).
        order: -1;
      }
    }
  }

  .AboutCulture__text {
    position: sticky;
    top: 28vh;
    z-index: 1;
    text-align: center;
    margin-inline: auto;
    pointer-events: none;

    .btn,
    a {
      pointer-events: auto;
    }

    @media (max-width: 1023px) {
      position: static;
      top: auto;
      pointer-events: auto;
      max-width: 32rem;
    }
  }

  .AboutCulture__photos {
    position: absolute;
    inset: 0;
    z-index: 2;

    @media (max-width: 1023px) {
      position: static;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 9rem;
      gap: var(--space-sm);
      padding-inline: var(--container-padding, var(--space-md-2xl));
    }

    // Narrow phones: two columns start feeling cramped, especially for
    // portrait-oriented shots — drop to a single column so each photo
    // gets full width and a taller, more natural crop.
    @media (max-width: 599px) {
      grid-template-columns: 1fr;
      grid-auto-rows: 11rem;
      gap: var(--space-sm);
    }
  }

  .AboutCulture__item {
    position: absolute;
    width: 14%;
    height: auto;
    box-shadow: 0 1.5rem 3rem -1rem rgba(0, 0, 0, 0.45);
    border-radius: 16px;
    transform: rotate(var(--rotate, 0deg));

    @media (max-width: 1023px) {
      position: static;
      width: 100%;
      height: auto;
      grid-row: span 2;
      transform: none !important;

      .anchor-content,
      .frame {
        height: 100%;
      }

      // Forcing a fixed grid height means .frame's own aspect-ratio can no
      // longer drive sizing here — the image needs to cover its box or it
      // will stretch/distort to fill the forced rectangle.
      img {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }
    }

    // On a single-column phone layout, give portrait shots (444/922,
    // 680/934) a taller box than the square/landscape ones so they don't
    // get squashed into the same short rectangle as everything else.
    @media (max-width: 599px) {
      &--2,
      &--3 {
        grid-row: span 3;
      }
    }

    &--1 { top: 1%; left: 8%; width: 22%; }
    &--2 { top: 10%; left: 68%; width: 13%; }
    &--3 { top: 23%; left: 34%; width: 16%; }
    &--4 { top: 34%; left: 56%; width: 24%; }
    &--5 { top: 43%; left: 10%; width: 12%; }
    &--6 { top: 55%; left: 64%; width: 25%; }
    &--7 { top: 65%; left: 38%; width: 16%; }
    &--8 { top: 74%; left: 6%; width: 21%; }
    &--9 { top: 83%; left: 60%; width: 14%; }
  }
</style>
