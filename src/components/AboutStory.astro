---
---

<section class="section AboutStory" data-padding="xl">
  <div class="container">
    <div class="sidebar AboutStory__sidebar" data-side="right" data-gap="md-2xl">
      <div class="anchor-card anchor-card--rounded AboutStory__image">
        <svg class="anchor-border" width="100%" height="100%" preserveAspectRatio="none">
          <rect x="3.5" y="3.5" width="calc(100% - 7px)" height="calc(100% - 7px)" rx="16" ry="16"></rect>
          <circle cx="19.5" cy="3.5" r="3"></circle>
          <circle cx="calc(100% - 19.5px)" cy="3.5" r="3"></circle>
          <circle cx="19.5" cy="calc(100% - 3.5px)" r="3"></circle>
          <circle cx="calc(100% - 19.5px)" cy="calc(100% - 3.5px)" r="3"></circle>
        </svg>
        <div class="anchor-content">
          <div class="frame" style="--frame-ratio:1080/814;">
            <img src="https://media.salo.uk/salo-website-prod/Salo Team_Main Image.png" alt="Photo of 7 team members Spring 2026" loading="lazy" decoding="async" width="1080" height="814" />
          </div>
        </div>
      </div>

      <div class="stack AboutStory__content" data-gap="lg">
        <span class="heading eyebrow">The Salo story</span>
        <h2 class="heading" data-font-size="4">From small beginnings on the south coast to international reach</h2>

        <div class="reactive-divider horizontal" x-data="reactiveDivider({ orientation: 'horizontal', unit: 'px' })">
          <div class="anchor start-anchor"><div class="anchor-circle"></div></div>
          <div class="divider-line" x-ref="dividerLine">
            <div class="width-display" x-text="formattedWidth" x-cloak>0px</div>
          </div>
          <div class="anchor end-anchor"><div class="anchor-circle"></div></div>
        </div>

        <div class="prose">
          <p>Salo was founded by award-winning creative Carl in his hometown of Wareham, Dorset. Since then, the business has gone from strength to strength, growing consistently while maintaining a close-knit culture. Our reach has expanded significantly, allowing us to support clients across the globe with complex design requirements.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  .AboutStory {
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-bg);
  }

  .AboutStory__sidebar {
    --sidebar-width: clamp(22rem, 44%, 45rem);
    align-items: center;

    @media (max-width: 1023px) {
      flex-direction: column-reverse;
    }
  }

  .AboutStory__image {
    flex-basis: var(--content-min, 55%);
  }

  .AboutStory__content {
    flex-basis: var(--sidebar-width);
  }
</style>
