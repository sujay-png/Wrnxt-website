---
import Button from '../components/ui/Button.astro';
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CTA from "../components/CTA.astro";
---

<Layout title="Projects | Akshara Digital">
  <Header />

  <main>
    <div data-block-type="projectCarousel" data-first="true">
      <section
        class="section ProjectCarouselBlock"
        data-index="0"
        data-padding="xl"
      >
        <div class="stack" data-gap="xl">
          <div class="container">
            <div
              class="cluster carousel-header"
              data-align="center"
              data-gap="lg"
              data-justify="between"
            >
              <h2
                class="heading"
                data-color="foreground"
                data-font-size="4"
                data-trim="normal"
                data-weight="regular"
              >
                Projects
              </h2>
              <div
                class="cluster reel-nav carousel-nav"
                data-align="center"
                data-gap="lg"
                data-justify="start"
                data-reel-id="carousel-0"
                data-reel-nav="true"
                x-data="{ progress: 0 }"
              >
                <button
                  aria-label="Previous project"
                  class="btn size-md ghost icon-only"
                  data-reel-prev="true"
                  type="button"
                >
                  <span class="btn-content">
                    <span
                      aria-hidden="true"
                      class="icon"
                      role="img"
                      style="--icon-size:1em;"
                    >
                      <svg
                        aria-hidden="true"
                        class="lucide lucide-arrow-left"
                        fill="none"
                        height="24"
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        viewBox="0 0 24 24"
                        width="24"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <path d="m12 19-7-7 7-7"></path>
                        <path d="M19 12H5"></path>
                      </svg>
                    </span>
                  </span>
                </button>
                <div class="progress-bar">
                  <div
                    class="progress-fill"
                    x-bind:style="`width: ${progress}%`"
                  >
                  </div>
                </div>
                <button
                  aria-label="Next project"
                  class="btn size-md ghost icon-only"
                  data-reel-next="true"
                  type="button"
                >
                  <span class="btn-content">
