---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import AboutHero from '../components/about/AboutHero.astro';
import AboutStory from '../components/about/AboutStory.astro';
import AboutVideo from '../components/about/AboutVideo.astro';
import AboutCulture from '../components/about/AboutCulture.astro';
import AboutTeam from '../components/about/AboutTeam.astro';
import Footer from '../components/layout/Footer.astro';
---

<Layout title="About • Akshara Digital" description="A hand-picked team of passionate creatives. Meet the people behind Akshara Digital Creative.">
  <Header />

  <main class="page--about">
    <AboutHero />
    <AboutStory />
    <AboutVideo />
    <AboutCulture />
    <AboutTeam />
  </main>

  <Footer />
</Layout>

<script>
  import { initAboutAnimations } from '../scripts/about-animations.js';

  // Astro's ClientRouter keeps document-level listeners alive across navigations, so this
  // handler also fires on every other page — only run when the About page is actually mounted,
  // and only once per mounted page (initial load can trigger both paths below).
  function runInit() {
    const page = document.querySelector<HTMLElement>('.page--about');
    if (!page || page.dataset.animInit) return;
    page.dataset.animInit = 'true';
    requestAnimationFrame(() => initAboutAnimations());
  }

  document.addEventListener('astro:page-load', runInit);

  // Tear down this page's ScrollTriggers before navigating away so they don't leak into the next page.
  document.addEventListener('astro:before-swap', () => {
    (window as any).__saloAboutCleanup?.();
  });

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    runInit();
  }
</script>

<style>
  main {
    position: relative;
    z-index: 1;
  }
</style>
