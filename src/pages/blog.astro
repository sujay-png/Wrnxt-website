---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';

const blogPosts = [
  {
    title: "Elevating Brands in Mangalore: The Akshara Digital Approach",
    slug: "/blog/elevating-brands-mangalore",
    subtitle: "How we combine strategic thinking with stunning visual design to help local and global businesses stand out.",
    excerpt: "At Akshara Digital, we believe that a brand is more than just a logo. It's the entire experience your customers have with your company. From our base in Mangalore, we are helping businesses redefine their digital presence with cohesive branding and cutting-edge web design.",
    image: "https://images.unsplash.com/photo-1542744173-8e7e53415bb0?q=80&w=1200&auto=format&fit=crop",
    author: "By Team Akshara",
    date: "18 Aug 2026",
    tags: ["Branding", "Visual Identity"],
    ratio: "16/9"
  },
  {
    title: "Why Staff Augmentation is the Secret Weapon for Tech Growth",
    slug: "/blog/staff-augmentation-tech-growth",
    subtitle: "Scaling your IT capabilities without the overhead of traditional hiring.",
    excerpt: "In today's fast-paced tech landscape, agility is everything. Our Staff Augmentation services at Wrnxt allow companies to seamlessly integrate top-tier talent into their existing teams, filling skill gaps and accelerating project timelines without long-term commitments.",
    image: "https://images.unsplash.com/photo-1522071820081-009f0129c71c?q=80&w=1200&auto=format&fit=crop",
    author: "By Team Wrnxt",
    date: "12 Aug 2026",
    tags: ["IT Services", "Tech Growth"],
    ratio: "16/9"
  },
  {
    title: "The Future of Web Design: Blending Aesthetics with Performance",
    slug: "/blog/future-web-design-performance",
    subtitle: "Why a beautiful website must also be lightning-fast and accessible.",
    excerpt: "A visually stunning website is useless if it takes too long to load or frustrates users. We explore how the team at Akshara Digital balances rich aesthetics—like dark modes and micro-animations—with uncompromising performance and UX best practices.",
    image: "https://images.unsplash.com/photo-1498050108023-c5249f4df085?q=80&w=1200&auto=format&fit=crop",
    author: "By Team Akshara",
    date: "05 Aug 2026",
    tags: ["UI / UX", "High-Performing Website"],
    ratio: "16/9"
  },
  {
    title: "Transforming Hardware & IT Services for Modern Businesses",
    slug: "/blog/transforming-hardware-it-services",
    subtitle: "Reliable infrastructure is the backbone of any successful digital transformation.",
    excerpt: "From setting up robust hardware networks to providing ongoing IT support, Wrnxt ensures that businesses have the reliable infrastructure they need to operate smoothly. Discover how our comprehensive IT solutions are empowering companies in Mangalore and beyond.",
    image: "https://images.unsplash.com/photo-1518770660439-4636190af475?q=80&w=1200&auto=format&fit=crop",
    author: "By Team Wrnxt",
    date: "28 Jul 2026",
    tags: ["Hardware", "IT Services"],
    ratio: "16/9"
  }
];
---

<Layout title="Blog • Akshara Digital" description="Insights, thinking, and perspectives from the Akshara Digital team on design, branding, and building great digital products.">
  <Header />

  <main class="page--blog">
    <!-- Header Section -->
    <section class="section BlogHeader" data-padding="lg">
      <div class="container">
        <div class="stack" data-gap="md">
          <h1 class="heading" data-font-size="5">Blog</h1>
        </div>
      </div>
    </section>

    <!-- Blog Posts List -->
    <section class="section BlogList" data-padding="none">
      <div class="container">
        <div class="stack blog-posts" data-gap="none">
          {blogPosts.map((post, index) => (
            <article class="BlogListItem">
              <a href={post.slug} class="link">
                <div style="--sidebar-width: clamp(15.625rem, 21.6606vw + 10.5483rem, 34.375rem); --content-min: 50%; --gutter: var(--space-lg-2xl);" data-side="left" data-gap="lg-2xl" class="sidebar items-start">
                  <!-- Image -->
                  <div class="anchor-card anchor-card--rounded image">
                    <svg class="anchor-border" width="100%" height="100%" preserveAspectRatio="none">
                      <rect x="3.5" y="3.5" width="calc(100% - 7px)" height="calc(100% - 7px)" rx="16" ry="16"></rect>
                      <circle cx="19.5" cy="3.5" r="3"></circle>
                      <circle cx="calc(100% - 19.5px)" cy="3.5" r="3"></circle>
                      <circle cx="19.5" cy="calc(100% - 3.5px)" r="3"></circle>
                      <circle cx="calc(100% - 19.5px)" cy="calc(100% - 3.5px)" r="3"></circle>
                      <circle cx="3.5" cy="19.5" r="3"></circle>
                      <circle cx="3.5" cy="calc(100% - 19.5px)" r="3"></circle>
                      <circle cx="calc(100% - 3.5px)" cy="19.5" r="3"></circle>
                      <circle cx="calc(100% - 3.5px)" cy="calc(100% - 19.5px)" r="3"></circle>
                    </svg>
                    <div class="anchor-content">
                      <div class="frame" style="--frame-ratio:4/3; --frame-pos:center;">
                        <img src={post.image} alt={post.title} transition:name={`blog-img-${post.slug}`} loading={index < 2 ? 'eager' : 'lazy'} decoding="async" width="800" height="600" />
                      </div>
                    </div>
                  </div>

                  <!-- Content -->
                  <div class="stack content" data-gap="xs">
                    {post.tags && post.tags.length > 0 && (
                      <div class="BlogListItem__tags">
                        {post.tags.map((tag) => {
                          const tagColor = tag === 'UI / UX' || tag === 'Design System' ? 'var(--color-blue, #0d99ff)' :
                                           tag === 'Branding' || tag === 'Visual Identity' ? 'var(--color-pink, #ff24bd)' :
                                           tag === 'High-Performing Website' ? 'var(--color-green, #b9ff36)' :
                                           tag === 'Web/Email Graphics' ? 'var(--color-yellow, #ffcd29)' :
                                           'var(--color-foreground-secondary)';
                          return (
                            <span class="Tag" style={`--tag-color: ${tagColor}`}>{tag}</span>
                          );
                        })}
                      </div>
                    )}
                    
                    <h2 class="heading" data-font-size="3" data-weight="regular" data-trim="normal" data-color="foreground">
                      {post.title}
                    </h2>
                    
                    {post.subtitle && (
                      <p class="subtitle">{post.subtitle}</p>
                    )}
                    
                    <div class="prose prose--md excerpt">
                      <p>{post.excerpt}</p>
                    </div>
                    
                    <div class="meta">
                      <span class="author">{post.author}</span>
                      <span class="separator" aria-hidden="true">&middot;</span>
                      <time>{post.date}</time>
                    </div>

                    <span class="btn size-md secondary mt-md">
                      <span class="btn-content">Read more</span>
                    </span>
                  </div>
                </div>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <CTA />
  </main>

  <Footer />
</Layout>

<script>
  function unlockScroll() {
    document.documentElement.style.overflow = '';
  }
  document.addEventListener('astro:page-load', unlockScroll);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    unlockScroll();
  } else {
    document.addEventListener('astro:page-load', unlockScroll);
  }
</script>

<style lang="scss">
  main {
    position: relative;
    z-index: 1;
  }

  .BlogHeader {
    padding-top: calc(var(--space-3xl) + 5rem);
    padding-bottom: var(--space-lg);
    background-color: var(--color-bg);
  }

  .BlogList {
    background-color: var(--color-bg);
    padding-bottom: var(--space-2xl);
  }

  // ── Blog Post Item ──
  .BlogListItem {
    border-top: 1px solid var(--color-border);

    &:last-child {
      border-bottom: 1px solid var(--color-border);
    }
  }

  .link {
    text-decoration: none;
    color: inherit;
    display: block;
    padding: var(--space-lg) 0;
    transition: background-color 0.3s var(--ease, ease);

    &:hover,
    &:focus-visible {
      img {
        transform: scale(1.05);
      }
    }
  }

  .sidebar {
    &[data-side="left"] > :first-child {
      flex-basis: var(--sidebar-width, 20rem);
    }
    
    &[data-side="left"] > :last-child {
      flex-grow: 999;
      flex-basis: var(--content-min, 50%);
    }
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--ease, ease);
  }

  .content {
    padding-block: var(--space-sm);
    flex-grow: 1;
  }

  .BlogListItem__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-bottom: var(--space-xs);
  }

  .Tag {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    font-family: var(--font-family-alt);
    font-size: var(--font-size--2);
    color: var(--color-foreground-secondary);
    letter-spacing: 0.02em;

    &::before {
      content: "";
      width: 0.375rem;
      height: 0.375rem;
      border-radius: 50%;
      background: var(--tag-color, var(--color-foreground-secondary));
      display: block;
      flex-shrink: 0;
    }
  }

  .subtitle {
    color: var(--color-foreground-secondary);
    font-size: var(--font-size-0);
    line-height: 1.4;
    margin-block-start: var(--space-3xs);
    margin-block-end: var(--space-2xs);
  }

  .excerpt {
    color: var(--color-foreground-secondary);
    font-size: var(--font-size-0);
    line-height: 1.65;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-family: var(--font-family-alt);
    font-size: var(--font-size--2);
    color: var(--color-foreground-secondary);
    opacity: 0.7;
    margin-top: var(--space-xs);
  }

  .separator {
    opacity: 0.5;
  }

  .mt-md {
    margin-top: var(--space-md);
  }

  // ── Anchor Card local styles ──
  .anchor-card--rounded {
    padding: 0.75em;
    position: relative;
    display: block;
  }

  .anchor-content {
    border-radius: 0.5em;
    overflow: hidden;
    position: relative;
    height: 100%;
  }

  .anchor-border {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: visible;

    rect {
      fill: none;
      stroke: var(--color-border, #585858);
      stroke-width: 1px;
      vector-effect: non-scaling-stroke;
    }

    circle {
      fill: var(--color-bg, #060606);
      stroke: var(--color-border, #585858);
      stroke-width: 1px;
    }
  }

  .frame {
    aspect-ratio: var(--frame-ratio, 4/3);
    overflow: hidden;
    position: relative;

    > * {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }
</style>
