        </div>
      </div>

      <div class="container">
        <div
          class="stack content"
          data-gap="lg"
          data-align="center"
          id="HomeHero__content"
        >
          <h1
            class="heading"
            data-font-size="4"
            data-weight="regular"
            data-color="foreground"
            data-word-reveal="true"
            id="hero-heading"
          >
            Design services that feel in-house, not outsourced.
          </h1>

          <div
