---

<section class="section HomeCta" data-padding="xl">
  <div class="stack" data-gap="2xl">
    <div class="container" data-size="prose">
      <div class="stack text-center" data-justify="center" data-gap="lg">
        <span class="heading eyebrow">Got a project in mind?</span>
        <h2 class="heading" data-font-size="5">Give your team the firepower it deserves</h2>

        <div class="reactive-divider horizontal" x-data="reactiveDivider({ orientation: 'horizontal', unit: 'px' })">
          <div class="anchor start-anchor"><div class="anchor-circle"></div></div>
          <div class="divider-line" x-ref="dividerLine">
            <div class="width-display" x-text="formattedWidth" x-cloak>0px</div>
          </div>
          <div class="anchor end-anchor"><div class="anchor-circle"></div></div>
        </div>

        <div class="stack" data-gap="lg">
          <div class="prose">
            <p>Don't let limited resources or expertise hold you back. Level up your creative with design support that feels in-house, not outsourced. Get direct access to designers ready to bring your ideas to life.</p>
          </div>

          <div class="cluster actions" data-gap="sm" data-justify="center" data-align="center">
            <Button href="/contact" variant="primary">
              Start a project
              <span class="icon" aria-hidden="true" role="img">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right">
                  <path d="M5 12h14"></path>
                  <path d="m12 5 7 7-7 7"></path>
                </svg>
              </span>
            </Button>
          </div>

          <span class="eyebrow">Replies in 24 hours. No obligation.</span>
        </div>
      </div>
    </div>
  </div>
</section>

