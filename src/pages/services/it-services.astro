---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ServiceHero from "../../components/servicehero.astro";
import ITServicesContent from "../../components/services/ITServicesContent.astro";
import StatsBar from "../../components/StatsBar.astro";
import TechStack from "../../components/TechStack.astro";
import Testimonials from "../../components/Testimonials.astro";
import RelatedProjects from "../../components/RelatedProject.astro";
import ITServicesCTA from "../../components/services/ITServicesCTA.astro";
import { heroImages } from "../../data/services";
---

<Layout title="IT Services — Akshara Digital">
  <Header />

  <div class="bg-dots" aria-hidden="true"></div>

  <ServiceHero
    eyebrow="Our services"
    title="IT Services Built to Move Your Business Forward
"
    desc="From web apps to mobile apps to websites, we design and build digital products that work as hard as you do. Reliable, scalable, and built around your business goals"
    images={heroImages}
  />

  <StatsBar />
  <ITServicesContent />
  <TechStack />
  <RelatedProjects />
  <ITServicesCTA />
  <!-- <Testimonials /> -->
  <Footer />
</Layout>

<style>
  .bg-dots {
    position: fixed;
    inset: 0;
    background-image: radial-gradient(var(--color-border) 1px, transparent 1px);
    background-size: 24px 24px;
    opacity: 0.5;
    pointer-events: none;
    z-index: 0;
  }
</style>
