<script>
  function setupProcessTabs() {
    const scopeSections = document.querySelectorAll('.scope-section');
    scopeSections.forEach((section) => {
      const buttons = section.querySelectorAll<HTMLButtonElement>('.process-step-btn');
      const panels = section.querySelectorAll<HTMLElement>('.process-detail-panel');
      const navButtons = section.querySelectorAll<HTMLButtonElement>('.step-nav-btn');

      function setActiveStep(index: number) {
        buttons.forEach((btn, idx) => {
          const isActive = idx === index;
          btn.classList.toggle('is-active', isActive);
          btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });
        panels.forEach((panel, idx) => {
          panel.classList.toggle('is-active', idx === index);
        });
      }

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const idx = parseInt(btn.getAttribute('data-step-index') || '0', 10);
          setActiveStep(idx);
        });
      });

      navButtons.forEach((navBtn) => {
        navBtn.addEventListener('click', () => {
          const target = parseInt(navBtn.getAttribute('data-target-index') || '0', 10);
          setActiveStep(target);
        });
      });
    });
  }

  document.addEventListener('astro:page-load', setupProcessTabs);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupProcessTabs);
  } else {
    setupProcessTabs();
  }
</script>

