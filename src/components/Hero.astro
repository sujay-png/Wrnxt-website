<style lang="scss">
  .HomeHero {
    --hero-height: 100vh;
    position: relative;
    z-index: 3;
    overflow: hidden;

    /*
      Measured the live site directly: .cover there is a 3-row grid of
      1fr / auto / 1fr WITH a real var(--space-lg) gap between rows (not 0).
      That symmetric 1fr/1fr split plus the gap is what makes the hero
      section render taller than exactly 100vh, which in turn is what the
      hero-to-services scroll transition's timing is calibrated against —
      a previous "fix" here (auto third row, gap:0) was based on a mistaken
      premise and made local diverge from the real layout. Matching it
      exactly so the ring shrink/handoff timing lines up correctly.
    */
    .cover {
      display: grid;
      grid-template-rows: 1fr auto 1fr;
      justify-content: center;
      gap: 0;
      position: relative;
    }

    &__ambientCursor {
      position: absolute;
      pointer-events: none;
      will-change: transform;

      // Override global position:fixed so the cursor stays inside the hero
      .Cursor {
        position: relative;
        transform: none;
        transform-origin: center;
      }

      &--topLeft {
        inset-block-start: 15vh;
        inset-inline-start: 12vh;
      }

      &--bottomRight {
        inset-inline-end: 12vw;
        inset-block-end: 15vw;
      }
    }

    .content {
      inline-size: fit-content;
      margin-inline: auto;
      position: relative;
      text-align: center;
      z-index: 10;

      & > * {
        position: relative;
      }

      &::before {
        --_offset: 3%;
        content: "";
        position: absolute;
        inset-block-start: calc(var(--_offset) * -2);
        inset-inline-start: calc(var(--_offset) * 1);
        inset-inline-end: calc(var(--_offset) * 1);
        inset-block-end: calc(var(--_offset) * -2);
        background: radial-gradient(
          circle,
          var(--color-bg) 60%,
          transparent 100%
        );
        border-radius: 50%;
        filter: blur(8px);
        z-index: 0;
      }

      @media (max-width: 767px) {
        &::before {
          background: var(--color-bg);
          filter: none;
        }
      }
    }

    .heading {
      max-width: var(--measure-xs);
      z-index: 2;
    }

    &__bottom {
      position: absolute;
      bottom: 0;
      left: 0;
      display: flex;
      align-items: flex-end;
      width: 100vw;
      overflow: hidden;
    }

    .marquee {
      padding-block: var(--space-lg);

      li {
        position: relative;

        & > * {
          position: relative;
        }

        &::before {
          --_offset: -10%;
          content: "";
          position: absolute;
          inset-block-start: calc(var(--_offset) * -1);
          inset-inline-start: calc(var(--_offset) * -1);
          inset-inline-end: calc(var(--_offset) * -1);
          inset-block-end: calc(var(--_offset) * -1);
          background: radial-gradient(
            circle,
            var(--color-bg) 50%,
            transparent 100%
          );
          border-radius: var(--radius-full);
          z-index: 0;
        }
      }

      &__track {
        gap: var(--space-2xl);
      }

      &__item img {
        position: relative;
        z-index: 1;
        transition: opacity 0.3s var(--ease);

        &:hover {
          opacity: 1;
        }
      }
    }
  }
</style>
