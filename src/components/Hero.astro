              fill="var(--cursor-color)"></path>
            <defs>
              <filter
                id="filter0_d_hero_2"
                x="0"
                y="0"
                width="20"
                height="20"
                filterUnits="userSpaceOnUse"
                color-interpolation-filters="sRGB"
              >
                <feFlood flood-opacity="0" result="BackgroundImageFix"
                ></feFlood>
                <feColorMatrix
                  in="SourceAlpha"
                  type="matrix"
