---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import ServiceHero from "../../components/services/ServiceHero.astro";
import ITServicesContent from "../../components/services/ITServicesContent.astro";
import StatsBar from "../../components/services/StatsBar.astro";
import TechStack from "../../components/services/TechStack.astro";
import RelatedProjects from "../../components/services/RelatedProject.astro";
import ServiceCTA from "../../components/services/ServiceCTA.astro";
import { heroImages } from "../../data/itServices";
---

<Layout title="IT Services — Akshara Digital">
  <Header />

  <div class="bg-dots" aria-hidden="true"></div>

  <ServiceHero
    eyebrow="Our services"
    title="IT Services Built to Move Your Business Forward
"
    desc="From web apps to mobile apps to websites, we design and build digital products that work as hard as you do. Reliable, scalable, and built around your business goals"
    images={heroImages}
  />

  <StatsBar />
  <ITServicesContent />
  <TechStack />
  <RelatedProjects />
  <ServiceCTA title="Let's Build Your Next IT Solution" description="Tell us what you're trying to solve, and we'll show you exactly how we'd approach it — no generic pitch, just a plan built around your business." />
  <Footer />
</Layout>

<style>
  .bg-dots {
    position: fixed;
    inset: 0;
    background-image: radial-gradient(var(--color-border) 1px, transparent 1px);
    background-size: 24px 24px;
    opacity: 0.12;
    pointer-events: none;
    z-index: 0;
  }
</style>
