---
import { ClientRouter } from 'astro:transitions';
import "../styles/globals.scss";
import "lenis/dist/lenis.css";

interface Props {
	title?: string;
	description?: string;
}

const { 
  title = "Web and brand design agency • Creative Digital Agency • Salo",
  description = "Affordable & Quality IT Solutions Guaranteed. We provide logical & beautiful design capabilities with value by seamlessly integrating as your creative team."
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
    
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
		<link rel="shortcut icon" href="/favicon/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="Salo Creative" />
		<meta name="generator" content={Astro.generator} />
		
		<title>{title}</title>
		<meta name="description" content={description} />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://salo.uk/" />
		<meta property="og:title" content="Web and brand design agency • Creative Digital Agency" />
		<meta property="og:description" content={description} />
		
		<!-- Twitter -->
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content="Web and brand design agency • Creative Digital Agency" />
		<meta name="twitter:description" content={description} />
    
   <script is:inline>
  const isMobile = window.matchMedia(
    "(max-width: 768px)"
  ).matches;

  if (!isMobile) {
    document.documentElement.style.overflow = "hidden";
  } else {
    document.documentElement.style.overflow = "auto";
  }

  window.addEventListener("pageshow", function (event) {
    if (event.persisted) {
      document.documentElement.style.overflow =
        isMobile ? "auto" : "hidden";
    }
  });
</script>
    <ClientRouter />
	</head>
	<body data-color-scheme="dark">
		<slot />

  <script>
  import Alpine from "alpinejs";
  import Lenis from "lenis";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import gsap from "gsap";

  declare global {
    interface Window {
      __alpineInitialized?: boolean;
      __lenisInitialized?: boolean;
      __lenis?: any;
      Alpine?: any;
    }
  }

  gsap.registerPlugin(ScrollTrigger);

  // Alpine
  if (!window.__alpineInitialized) {
    window.__alpineInitialized = true;

    Alpine.data("buttonHover", () => ({
      isHovering: false,
      mouseX: 0,
      mouseY: 0,
      bgX: 75,
      bgY: 75,
      raf: null as number | null,

      handleMouseMove(e: MouseEvent) {
        if (!this.isHovering) return;

        const target = e.currentTarget as HTMLElement;
        const rect = target.getBoundingClientRect();

        this.mouseX =
          ((e.clientX - rect.left) / rect.width) * 100;

        this.mouseY =
          ((e.clientY - rect.top) / rect.height) * 100;

        if (this.raf) cancelAnimationFrame(this.raf);

        this.raf = requestAnimationFrame(() => {
          this.bgX = this.mouseX;
          this.bgY = this.mouseY;
        });
      },

      handleMouseEnter() {
        this.isHovering = true;
      },

      handleMouseLeave() {
        this.isHovering = false;
      },
    }));

    window.Alpine = Alpine;
    Alpine.start();
  }

  // Mobile check
  const isMobile = window.matchMedia("(max-width: 768px)").matches;

  // Enable Lenis only on desktop
  if (!isMobile && !window.__lenisInitialized) {
    window.__lenisInitialized = true;

    const lenis = new Lenis({
      duration: 1.2,
      easing: (t) =>
        Math.min(1, 1.001 - Math.pow(2, -10 * t)),
    });

    window.__lenis = lenis;

    lenis.on("scroll", ScrollTrigger.update);

    gsap.ticker.add((time) => {
      lenis.raf(time * 1000);
    });

    gsap.ticker.lagSmoothing(0);
  }

  // Restore normal mobile scrolling
  if (isMobile) {
    document.documentElement.style.overflow = "auto";
    document.body.style.overflow = "auto";
    document.documentElement.style.scrollBehavior = "auto";
  }

  document.addEventListener("astro:after-swap", () => {
    if (window.__lenis && !isMobile) {
      window.__lenis.scrollTo(0, {
        immediate: true,
      });
    }
  });

  document.addEventListener("astro:page-load", () => {
    if (window.Alpine) {
      window.Alpine.discover();
    }

    if (window.__lenis && !isMobile) {
      window.__lenis.scrollTo(0, {
        immediate: true,
      });
    }

    document.documentElement.style.overflow = "auto";
    document.body.style.overflow = "auto";

    ScrollTrigger.refresh();

    window.dispatchEvent(
      new CustomEvent("lenis:ready")
    );
  });
</script>
	</body>
</html>
