---
const cultureImages = [
  {
    src: "/images/Group mine .jpg.jpeg",
    alt: "A group of seven colleagues smiling for a photo in front of a decorative wall with bookshelf motifs.",
    ratio: "1090 / 680",
    rotate: -4,
  },
  {
    src: "/images/WhatsApp Image 2026-07-08 at 3.14.36 PM.jpeg",
    alt: "A person in a red fleece standing in a forest, aiming a recurve bow at two archery targets.",
    ratio: "1 / 1",
    rotate: -8,
  },
  {
    src: "/images/IMG_1146.jpeg",
    alt: "Four men standing outside in front of a chain-link fence.",
    ratio: "680 / 934",
    rotate: -6,
  },
  {
    src: "/images/IMG_1006.jpeg",
    alt: "Three smiling young men taking a selfie in a stadium.",
    ratio: "932 / 680",
    rotate: 4,
  },
  {
    src: "/images/image3.jpeg",
    alt: "A smiling man standing in front of a Formula 1 safety car.",
    ratio: "444 / 922",
    rotate: 7,
  },
  {
    src: "/images/Group 111.jpg.jpeg",
    alt: "Group of people posing for a photo at South Coast Karting.",
    ratio: "1060 / 680",
    rotate: -5,
  },
  {
    src: "/images/Alisha 2.png",
    alt: "A young woman and man smiling in a university cafe.",
    ratio: "1 / 1",
    rotate: -8,
  },
  {
    src: "/images/WhatsApp Image 2026-07-08 at 2.54.04 PM.jpeg",
    alt: "A group of five colleagues posing for a selfie during sunset.",
    ratio: "752 / 558",
    rotate: 6,
  },
  {
    src: "/images/WhatsApp Image 2026-07-08 at 2.54.04 PM (1).jpeg",
    alt: "Four people smiling for a selfie outdoors.",
    ratio: "1 / 1",
    rotate: 3,
  },
];
---

<section class="section AboutCulture" data-padding="xl">
  <div class="AboutCulture__collage">
    <div class="AboutCulture__photos">
      {
        cultureImages.map((img, idx) => (
          <article
            class={`anchor-card anchor-card--rounded AboutCulture__item AboutCulture__item--${idx + 1}`}
            style={`--rotate:${img.rotate}deg; --image-ratio:${img.ratio};`}
          >
            <svg
              class="anchor-border"
              width="100%"
              height="100%"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <rect
                x="3.5"
                y="3.5"
                width="calc(100% - 7px)"
                height="calc(100% - 7px)"
                rx="16"
                ry="16"
              />
              <circle cx="19.5" cy="3.5" r="3" />
              <circle cx="calc(100% - 19.5px)" cy="3.5" r="3" />
              <circle cx="19.5" cy="calc(100% - 3.5px)" r="3" />
              <circle
                cx="calc(100% - 19.5px)"
                cy="calc(100% - 3.5px)"
                r="3"
              />
            </svg>

            <div class="anchor-content">
              <div class="frame">
                <img
                  src={img.src}
                  alt={img.alt}
                  loading="lazy"
                  decoding="async"
                  width="932"
                  height="680"
                />
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div class="container AboutCulture__content" data-size="prose">
      <div
        class="stack AboutCulture__text"
        data-gap="lg"
        data-align="center"
      >
        <span class="heading eyebrow">Our culture</span>

        <h2 class="heading" data-font-size="4">
          We're a fully remote team, but always connected.
        </h2>

        <div class="prose">
          <p>
            Regular socials and events sit at the heart of what we do, helping
            us stay close and collaborative. Great outcomes come from seamless
            teamwork, which is why our culture matters so much to us.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  .AboutCulture {
    position: relative;
    overflow: clip;
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-bg);
  }

  .AboutCulture__collage {
    position: relative;
    min-height: 280rem;
  }

  .AboutCulture__content {
    height: 100%;
  }

  .AboutCulture__text {
    position: sticky;
    top: 28vh;
    z-index: 1;
    max-width: 42rem;
    margin-inline: auto;
    text-align: center;
    pointer-events: none;

    .btn,
    a {
      pointer-events: auto;
    }

    h2 {
      text-wrap: balance;
    }
  }

  .AboutCulture__photos {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .AboutCulture__item {
    position: absolute;
    width: 14%;
    overflow: hidden;
    border-radius: 16px;
    transform: rotate(var(--rotate, 0deg));
    box-shadow: 0 1.5rem 3rem -1rem rgba(0, 0, 0, 0.45);

    .anchor-content {
      width: 100%;
      height: 100%;
    }

    .frame {
      width: 100%;
      aspect-ratio: var(--image-ratio);
      overflow: hidden;
      border-radius: inherit;
    }

    img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    &--1 {
      top: 1%;
      left: 8%;
      width: 22%;
    }

    &--2 {
      top: 10%;
      left: 68%;
      width: 13%;
    }

    &--3 {
      top: 23%;
      left: 34%;
      width: 16%;
    }

    &--4 {
      top: 34%;
      left: 56%;
      width: 24%;
    }

    &--5 {
      top: 43%;
      left: 10%;
      width: 12%;
    }

    &--6 {
      top: 55%;
      left: 64%;
      width: 25%;
    }

    &--7 {
      top: 65%;
      left: 38%;
      width: 16%;
    }

    &--8 {
      top: 74%;
      left: 6%;
      width: 21%;
    }

    &--9 {
      top: 83%;
      left: 60%;
      width: 14%;
    }
  }

  /* Tablet */
  @media (max-width: 1023px) {
    .AboutCulture {
      overflow: hidden;
    }

    .AboutCulture__collage {
      min-height: 0;
      display: flex;
      flex-direction: column;
      gap: clamp(2rem, 6vw, 4rem);
      padding-block: clamp(3rem, 8vw, 5rem);
    }

    .AboutCulture__content {
      order: -1;
      height: auto;
    }

    .AboutCulture__text {
      position: static;
      max-width: 38rem;
      padding-inline: 1rem;
      pointer-events: auto;
    }

    .AboutCulture__photos {
      position: static;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(0.9rem, 2vw, 1.5rem);
      padding-inline: clamp(1rem, 4vw, 2rem);
    }

    .AboutCulture__item {
      position: relative;
      inset: auto;
      width: 100%;
      min-width: 0;
      transform: none;
      box-shadow: 0 1rem 2rem -1rem rgba(0, 0, 0, 0.4);

      .frame {
        aspect-ratio: 4 / 3;
      }

      &--2 .frame,
      &--3 .frame,
      &--5 .frame {
        aspect-ratio: 3 / 4;
      }

      &--1,
      &--6,
      &--8 {
        grid-column: span 2;

        .frame {
          aspect-ratio: 16 / 9;
        }
      }
    }
  }

  /* Mobile */
  @media (max-width: 599px) {
    .AboutCulture__collage {
      gap: 2rem;
      padding-block: 3rem;
    }

    .AboutCulture__text {
      padding-inline: 1rem;

      h2 {
        font-size: clamp(2rem, 9vw, 3rem);
        line-height: 1.05;
      }

      .prose {
        font-size: 0.95rem;
        line-height: 1.7;
      }
    }

    .AboutCulture__photos {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding-inline: 1rem;
    }

    .AboutCulture__item,
    .AboutCulture__item--1,
    .AboutCulture__item--6,
    .AboutCulture__item--8 {
      grid-column: auto;
    }

    .AboutCulture__item {
      .frame {
        aspect-ratio: 4 / 3;
      }

      &--2 .frame,
      &--3 .frame,
      &--5 .frame {
        aspect-ratio: 3 / 4;
      }

      &--1 .frame,
      &--4 .frame,
      &--6 .frame,
      &--8 .frame {
        aspect-ratio: 16 / 10;
      }
    }
  }

  /* Very small mobile */
  @media (max-width: 380px) {
    .AboutCulture__photos {
      padding-inline: 0.75rem;
    }

    .AboutCulture__text {
      padding-inline: 0.75rem;
    }

    .AboutCulture__item {
      border-radius: 12px;
    }
  }
</style>