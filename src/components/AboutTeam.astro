---

<section
  class="section AboutTeamGrid"
  id="team"
  data-padding="xl"
  x-data={`teamSpotlight(${JSON.stringify(team)})`}
>
  <div class="container">
    <h2 class="heading sr-only">Team members</h2>

    <div class="sidebar AboutTeamGrid__layout" data-gap="md-2xl">
      <div class="AboutTeamGrid__grid">
        {team.map((person, idx) => (
          <button
            type="button"
            class="AboutTeamGrid__card"
            :class={`{ 'is-active': active === ${idx} }`}
            @click={`select(${idx})`}
          >
            <div class="anchor-card anchor-card--rounded AboutTeamGrid__photo">
              <svg class="anchor-border" width="100%" height="100%" preserveAspectRatio="none">
                <rect x="3.5" y="3.5" width="calc(100% - 7px)" height="calc(100% - 7px)" rx="16" ry="16"></rect>
                <circle cx="19.5" cy="3.5" r="3"></circle>
                <circle cx="calc(100% - 19.5px)" cy="3.5" r="3"></circle>
                <circle cx="19.5" cy="calc(100% - 3.5px)" r="3"></circle>
                <circle cx="calc(100% - 19.5px)" cy="calc(100% - 3.5px)" r="3"></circle>
              </svg>
              <div class="anchor-content">
                <div class="frame" style="--frame-ratio:1/1;">
                  <img src={person.photo} alt={`Portrait of ${person.name}.`} loading="lazy" decoding="async" width="400" height="400" />
                </div>
              </div>
            </div>
            <div class="stack" data-gap="3xs">
              <h3 class="heading" data-font-size="0">{person.name}</h3>
              <span class="eyebrow">{person.role}</span>
            </div>
          </button>
        ))}
      </div>

      <div class="stack AboutTeamGrid__spotlight" data-gap="lg" x-ref="spotlight" :class="{ 'is-switching': switching }">
        <div class="stack" data-gap="3xs">
          <h3 class="heading" data-font-size="3" x-text="current.name">{team[0].name}</h3>
          <span class="eyebrow" x-text="current.role">{team[0].role}</span>
        </div>

        <div class="reactive-divider horizontal" x-data="reactiveDivider({ orientation: 'horizontal', unit: 'px' })">
          <div class="anchor start-anchor"><div class="anchor-circle"></div></div>
          <div class="divider-line" x-ref="dividerLine">
            <div class="width-display" x-text="formattedWidth" x-cloak>0px</div>
          </div>
          <div class="anchor end-anchor"><div class="anchor-circle"></div></div>
        </div>

        <div class="prose" x-text="current.bio">
          <p>{team[0]}</p>
        </div>

        <div class="cluster actions" data-gap="sm" data-justify="start" data-align="center">
          <a href={team[0].linkedin} target="_blank" rel="noopener noreferrer" class="btn size-md secondary" :href="current.linkedin">
            <span class="btn-content">
              Connect on LinkedIn
              <span class="icon" aria-hidden="true" role="img">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7 7h10v10"></path>
                  <path d="M7 17 17 7"></path>
                </svg>
              </span>
            </span>
          </a>
        </div>

        <div class="AboutTeamGrid__spotlightPhotos">
          <template x-for="(photo, i) in current.photos" :key="i">
            <div class="anchor-card anchor-card--rounded AboutTeamGrid__spotlightPhoto">
              <svg class="anchor-border" width="100%" height="100%" preserveAspectRatio="none">
                <rect x="3.5" y="3.5" width="calc(100% - 7px)" height="calc(100% - 7px)" rx="16" ry="16"></rect>
                <circle cx="19.5" cy="3.5" r="3"></circle>
                <circle cx="calc(100% - 19.5px)" cy="3.5" r="3"></circle>
                <circle cx="19.5" cy="calc(100% - 3.5px)" r="3"></circle>
                <circle cx="calc(100% - 19.5px)" cy="calc(100% - 3.5px)" r="3"></circle>
              </svg>
              <div class="anchor-content">
                <div class="frame" style="--frame-ratio:3/4;">
                  <img :src="photo" :alt="`${current.name} photo.`" loading="lazy" decoding="async" width="720" height="960" />
                </div>
              </div>
            </div>
          </template>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import Alpine from 'alpinejs';

  if (!window.__teamSpotlightAlpineRegistered) {
    window.__teamSpotlightAlpineRegistered = true;

    document.addEventListener('alpine:init', () => {
      Alpine.data('teamSpotlight', (team) => ({
        team,
        active: 0,
        switching: false,
        get current() {
          return this.team[this.active];
        },
        select(idx) {
          if (idx === this.active) return;
          // A plain CSS-transitioned class (toggled via the `switching` flag below, see the
          // .AboutTeamGrid__spotlight.is-switching rule) instead of a GSAP tween here — GSAP's
          // onComplete callback on this opacity/filter combo wasn't reliably firing, which left
          // the active-state update (previously tied to onComplete) never running. Updating
          // `active` on a plain setTimeout instead guarantees the swap always happens even if
          // the cosmetic fade is interrupted.
          this.switching = true;
          setTimeout(() => {
            this.active = idx;
            this.switching = false;
          }, 220);

          // Keep the spotlight panel comfortably in view when picking someone from further
          // down the grid on smaller viewports where the two columns stack.
          const panel = document.querySelector('.AboutTeamGrid__spotlight');
          if (panel && window.matchMedia('(max-width: 1023px)').matches) {
            panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      }));
    });
  }
</script>

<style lang="scss">
  .AboutTeamGrid {
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-bg);
  }

  .AboutTeamGrid__layout {
    --sidebar-width: clamp(22rem, 44vw, 44rem);
    align-items: start;

    @media (max-width: 1023px) {
      flex-direction: column;
    }
  }

  .AboutTeamGrid__grid {
    display: grid;
    /* force-recompile */
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
    flex-basis: var(--content-min, 50%);

    @media (max-width: 1023px) {
      width: 100%;
    }

    @media (max-width: 479px) {
      grid-template-columns: 1fr;
    }
  }

  .AboutTeamGrid__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    text-decoration: none;
    color: inherit;
    background: none;
    border: none;
    padding: 0;
    text-align: left;
    cursor: pointer;
    font: inherit;
    opacity: 0.55;
    transition: opacity 0.3s var(--ease);

    &:hover,
    &.is-active {
      opacity: 1;
    }

    &.is-active .AboutTeamGrid__photo {
      box-shadow: 0 0 0 2px var(--color-foreground);
      border-radius: var(--radius-md);
    }
  }

  .AboutTeamGrid__photo {
    width: 100%;

    .frame {
      transition: transform 0.4s var(--ease-out-cubic);
    }
  }

  .AboutTeamGrid__card:hover .AboutTeamGrid__photo .frame {
    transform: scale(1.04);
  }

  .AboutTeamGrid__spotlight {
    flex-basis: var(--sidebar-width);
    position: sticky;
    top: var(--space-2xl);
    opacity: 1;
    filter: blur(0px);
    transition: opacity 0.22s ease, filter 0.22s ease;

    &.is-switching {
      opacity: 0;
      filter: blur(8px);
    }

    @media (max-width: 1023px) {
      position: relative;
      top: auto;
      width: 100%;
    }
  }

  .AboutTeamGrid__spotlightPhotos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-sm);

    @media (max-width: 479px) {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
