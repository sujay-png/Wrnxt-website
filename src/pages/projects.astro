---
import Layout from "../layouts/Layout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import CTA from "../components/CTA.astro";

interface Project {
  id: string;
  client: string;
  eyebrow: string;
  title: string;
  category: string;
  tagColor?: string;
  desc: string;
  primaryBtnText: string;
 
  image: string;
  imageAlt: string;
  logo?: string;
  href: string;
  isExternal?: boolean;
  liveUrl?: string;
}

const projects: Project[] = [
  {
    id: "abbeygate-england",
    client: "Abbeygate England / PUP Exports",
    eyebrow: "Notebooks",
    title: "Your Brand, Our Craftsmanship",
    category: "Corporate Gifting & Bespoke Leather",
    tagColor: "var(--color-purple, #a855f7)",
    desc: "Elevate your corporate gifting and bespoke merchandise with our expertly customised leather goods, executive notebooks, diaries, and branded accessories.",
    primaryBtnText: "View Case Study",
   
    image: "/images/abbeygate-hero.png",
    imageAlt: "Abbeygate England bespoke diaries and notebooks flat-lay",
    logo: "/images/Pup_Logo.jpg",
    href: "/projects/abbeygate-england",
    isExternal: false,
    liveUrl: "https://pupexports.com/",
  },
  {
    id: "electro-core-systems",
    client: "Electro Core Systems",
    eyebrow: "Computer Networks & Security Solutions",
    title: "Empowering Communication. Connecting the Future.",
    category: "High-Performing Website & IoT",
    tagColor: "var(--color-blue, #0d99ff)",
    desc: "At Electro Core Systems, we believe communication is more than just connection — it’s the pulse of every successful organization. Specialized IP telephony, structured networking, and smart enterprise security.",
    primaryBtnText: "View Case Study",
  
    image: "/images/electrocore-hero.png",
    imageAlt: "Electro Core Systems Computer Networks and Security Solutions Showcase",
    logo: "/images/Electrocore_systems.jpg",
    href: "/projects/electro-core-systems",
    isExternal: false,
    liveUrl: "https://electrocoresystems.in/about-us/",
  },
  {
    id: "udbhav-developers",
    client: "Udbhav Developers",
    eyebrow: "Exclusive Club House Generations",
    title: "Exclusive Club House Generations.",
    category: "Architectural & Real Estate Excellence",
    tagColor: "var(--color-yellow, #ffcd29)",
    desc: "At Udbhav Developers, we believe living spaces are more than just homes — they are the canvas of your aspirations. Crafting iconic clubhouse communities, premium lifestyle spaces, and architectural excellence.",
    primaryBtnText: "View Case Study",
  
    image: "/images/udbhav-hero.png",
    imageAlt: "Udbhav Developers Exclusive Club House Generations Showcase",
    logo: "/images/udbhav.jpeg",
    href: "/projects/udbhav-developers",
    isExternal: false,
    liveUrl: "http://udbhavdevelopers.com/",
  },
  {
    id: "the-laptop-bazar",
    client: "The Laptop Bazar",
    eyebrow: "Tech Hardware & Retail",
    title: "Next-Gen Hardware & E-Commerce Platform",
    category: "E-Commerce & Hardware Solutions",
    tagColor: "var(--color-yellow, #ffcd29)",
    desc: "A comprehensive digital marketplace and hardware service hub delivering premium laptops, refurbished enterprise tech, and certified accessories with seamless shopping journeys.",
    primaryBtnText: "View Case Study",
  
    image: "/images/laptopbazzar.jpeg",
    imageAlt: "The Laptop Bazar digital showcase",
    href: "/projects/the-laptop-bazar",
    isExternal: false,
    liveUrl: "https://thelaptopbazar.com/",
  },
  {
    id: "roswell",
    client: "Roswell NYC",
    eyebrow: "UI / UX & Shopify Plus",
    title: "A Bold New Identity for a Shopify Partner",
    category: "UI / UX Design & Ecommerce",
    tagColor: "var(--color-green, #b9ff36)",
    desc: "The new website needed to reflect Roswell’s bold, confident identity while letting their work take center stage. Built with smooth interactions and bespoke showcase components.",
    primaryBtnText: "View Case Study",
   
    image: "/images/sanjgreen.png",
    imageAlt: "Roswell website homepage design mockup",
    logo: "https://media.salo.uk/salo-website-prod/roswell.svg",
    href: "/projects/roswell",
    isExternal: false,
    liveUrl: "https://roswellnyc.com/",
  },
  {
    id: "venture-chess-academy",
    client: "Venture Chess Academy",
    eyebrow: "EdTech & Interactive Web",
    title: "Mastering the Board — Strategic Coaching Hub",
    category: "Web Platform & Sports Portal",
    tagColor: "var(--color-blue, #0d99ff)",
    desc: "An engaging digital learning platform for chess enthusiasts and competitive players, offering interactive course management, student rating systems, and live tournament registrations.",
    primaryBtnText: "View Case Study",
    
    image: "/images/venturechessacademy.png",
    imageAlt: "Venture Chess Academy platform mockup",
    href: "/projects/venture-chess-academy",
    isExternal: false,
    liveUrl: "http://venturechessacademy.com/",
  },
  {
    id: "one-more-rep-gym",
    client: "One More Rep Gym",
    eyebrow: "Fitness & Community",
    title: "High-Impact Fitness & Training Community",
    category: "Branding & Web Presence",
    tagColor: "var(--color-pink, #ff24bd)",
    desc: "A high-energy, modern digital experience designed to inspire prospective athletes, showcase state-of-the-art gym facilities, publish live class schedules, and drive conversions effortlessly.",
    primaryBtnText: "View Case Study",
   
    image: "/images/onemorerep.png",
    imageAlt: "One More Rep Gym website showcase",
    logo: "/images/one_more_rep.svg",
    href: "/projects/one-more-rep-gym",
    isExternal: false,
    liveUrl: "http://onemorerepgym.in/",
  },
];
---

<Layout title="Projects • Akshara Digital" description="Explore our portfolio of high-performing websites, digital platforms, and brand experiences crafted with precision.">
  <Header />

  <main 
    class="page--projects" 
    x-data={`{
      active: 0,
      total: ${projects.length},
      next() {
        this.active = (this.active + 1) % this.total;
      },
      prev() {
        this.active = (this.active - 1 + this.total) % this.total;
      },
      goTo(idx) {
        this.active = idx;
      }
    }`}
    @keydown.window.arrow-right="next()"
    @keydown.window.arrow-left="prev()"
  >
    
    <!-- Hero Showcase Slider Section (Matching Abbeygate England Luxury Design) -->
    <section class="section ProjectsSliderSection">
      <div class="container">
        
        <!-- The Slider Card Frame -->
        <div class="hero-showcase-card">
          
          {projects.map((proj, idx) => (
            <div 
              class="hero-slide"
              x-show={`active === ${idx}`}
              x-cloak={idx !== 0 ? "" : undefined}
              style={idx !== 0 ? "display: none;" : ""}
              x-transition:enter="slide-enter"
              x-transition:enter-start="slide-enter-start"
              x-transition:enter-end="slide-enter-end"
              x-transition:leave="slide-leave"
              x-transition:leave-start="slide-leave-start"
              x-transition:leave-end="slide-leave-end"
            >
              <div class="hero-slide-grid">
                
                <!-- Left Column: Content -->
                <div class="hero-slide-content">
                  <div class="eyebrow-text">{proj.eyebrow}</div>
                  
                  <h1 class="hero-slide-title">
                    {proj.title}
                  </h1>
                  
                  <p class="hero-slide-desc">
                    {proj.desc}
                  </p>
                  
                  <div class="hero-slide-buttons">
                    <a
                      href={proj.href}
                      class="btn-solid"
                    >
                      {proj.primaryBtnText}
                    </a>
                    
                    {proj.liveUrl && (
                      <a
                        href={proj.liveUrl}
                        class="btn-outline"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        Visit Live Site &nearr;
                      </a>
                    )}
                  </div>
                </div>

                <!-- Right Column: Full Wide Image -->
                <div class="hero-slide-image-wrapper">
                  <a
                    href={proj.href}
                    class="image-link"
                    aria-label={`View ${proj.title}`}
                  >
                    <img
                      src={proj.image}
                      alt={proj.imageAlt}
                      class="hero-slide-img"
                      loading="eager"
                      decoding="async"
                    />
                  </a>
                </div>

              </div>
            </div>
          ))}

          <!-- Bottom Right Slider Navigation Controls -->
          <div class="slider-controls">
            <!-- Dots Indicator -->
            <div class="slider-dots">
              {projects.map((_, dotIdx) => (
                <button
                  type="button"
                  class="slider-dot"
                  :class={`{ 'active': active === ${dotIdx} }`}
                  @click={`goTo(${dotIdx})`}
                  aria-label={`Go to slide ${dotIdx + 1}`}
                ></button>
              ))}
            </div>

            <!-- Arrow Buttons -->
            <div class="slider-arrows">
              <button
                type="button"
                class="arrow-btn"
                @click="prev()"
                aria-label="Previous project"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m15 18-6-6 6-6"/>
                </svg>
              </button>

              <button
                type="button"
                class="arrow-btn"
                @click="next()"
                aria-label="Next project"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m9 18 6-6-6-6"/>
                </svg>
              </button>
            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- All Projects Directory Grid Section -->
    <section class="section ProjectsGridSection">
      <div class="container">
        <div class="section-header">
        
          <h2 class="section-title">All Projects</h2>
          <p class="section-desc">Click any project to preview it in the showcase slider above, or view its dedicated case study.</p>
        </div>

        <div class="projects-thumbnail-grid">
          {projects.map((proj, idx) => (
            <div 
              class="project-thumb-card" 
              :class={`{ 'active-thumb': active === ${idx} }`}
              @click={`goTo(${idx}); window.scrollTo({ top: 0, behavior: 'smooth' })`}
            >
              <div class="thumb-image-box">
                <img src={proj.image} alt={proj.imageAlt} loading="lazy" decoding="async" />
              </div>
              <div class="thumb-meta">
                <div class="thumb-eyebrow">{proj.eyebrow}</div>
                <h3 class="thumb-title">{proj.client}</h3>
                <div class="thumb-actions" style="display: flex; align-items: center; justify-content: space-between; margin-top: auto; padding-top: 0.5rem;">
                  <span class="thumb-cta">Showcase &uarr;</span>
                  <a href={proj.href} class="thumb-case-study" style="font-size: 0.85rem; font-weight: 600; color: var(--color-pink); text-decoration: none;" @click.stop>Case Study &rarr;</a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <CTA />
  </main>

  <Footer />
</Layout>

<script>
  import Alpine from 'alpinejs';

  function projectsHeroSlider(totalCount = 7) {
    return {
      active: 0,
      total: totalCount,
      timer: null,

      init() {
        // Keyboard arrow support
        window.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight') this.next();
          if (e.key === 'ArrowLeft') this.prev();
        });
      },

      next() {
        this.active = (this.active + 1) % this.total;
      },

      prev() {
        this.active = (this.active - 1 + this.total) % this.total;
      },

      goTo(idx: number) {
        this.active = idx;
      }
    };
  }

  // Register with window
  if (typeof window !== 'undefined') {
    (window as any).projectsHeroSlider = projectsHeroSlider;
  }

  function unlockScroll() {
    document.documentElement.style.overflow = "";
  }
  document.addEventListener("astro:page-load", unlockScroll);
  if (
    document.readyState === "complete" ||
    document.readyState === "interactive"
  ) {
    unlockScroll();
  } else {
    document.addEventListener("astro:page-load", unlockScroll);
  }
</script>

<style lang="scss">
  [x-cloak] {
    display: none !important;
  }

  main.page--projects {
    position: relative;
    z-index: 1;
    background-color: var(--color-bg, #0b0c0e);
    color: var(--color-foreground, #f5f5f3);
    min-height: 100vh;
  }

  // ── Hero Showcase Slider Section (Exact Abbeygate England Style) ──
  .ProjectsSliderSection {
    padding-top: calc(var(--space-3xl) + 4.5rem);
    padding-bottom: var(--space-2xl);
  }

  .hero-showcase-card {
    background: #f7f5f0; // Luxury warm cream tone matching screenshot
    color: #1a1a1a;
    border-radius: 1.5rem;
    overflow: hidden;
    position: relative;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
    min-height: 580px;
    display: flex;
    align-items: stretch;

    @media (max-width: 991px) {
      min-height: auto;
    }
  }

  .hero-slide {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: stretch;
  }

  .hero-slide-grid {
    display: grid;
    grid-template-columns: 44% 56%;
    width: 100%;
    align-items: center;

    @media (max-width: 991px) {
      grid-template-columns: 1fr;
    }
  }

  // 1. Left Column: Content
  .hero-slide-content {
    padding: clamp(3rem, 4vw, 5rem) clamp(2rem, 3.5vw, 4.5rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    z-index: 2;

    @media (max-width: 991px) {
      padding: 2.5rem 2rem 1.5rem;
      order: 2;
    }
  }

  .eyebrow-text {
    font-size: 1.05rem;
    font-weight: 500;
    color: #55524c;
    margin-bottom: 0.75rem;
    letter-spacing: 0.01em;
  }

  .hero-slide-title {
    font-family: var(--font-family-heading, "Fraunces", Georgia, serif);
    font-size: clamp(2rem, 3.2vw, 3.25rem);
    font-weight: 700;
    line-height: 1.16;
    color: #1c1a17;
    margin: 0 0 1.25rem 0;
    letter-spacing: -0.02em;
  }

  .hero-slide-desc {
    font-size: clamp(1rem, 1.1vw, 1.15rem);
    color: #48443e;
    line-height: 1.62;
    max-width: 44ch;
    margin: 0 0 2.25rem 0;
  }

  .hero-slide-buttons {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;

    .btn-solid {
      background: #3d233c; // Elegant deep plum matching Abbeygate screenshot
      color: #ffffff;
      padding: 13px 28px;
      border-radius: 4px;
      font-weight: 600;
      font-size: 0.95rem;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: background 0.2s ease, transform 0.2s ease;

      &:hover {
        background: #2b172a;
        transform: translateY(-1px);
      }
    }

    .btn-outline {
      background: transparent;
      color: #3d233c;
      border: 1.5px solid #3d233c;
      padding: 12px 28px;
      border-radius: 4px;
      font-weight: 600;
      font-size: 0.95rem;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s ease;

      &:hover {
        background: rgba(61, 35, 60, 0.08);
        transform: translateY(-1px);
      }
    }
  }

  // 2. Right Column: Full Wide Image
  .hero-slide-image-wrapper {
    width: 100%;
    height: 100%;
    min-height: 520px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 2.5rem 2rem 1rem;
    overflow: hidden;

    @media (max-width: 991px) {
      min-height: 320px;
      padding: 2rem 2rem 0;
      order: 1;
    }

    .image-link {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 100%;
      text-decoration: none;
    }

    .hero-slide-img {
      width: 100%;
      max-width: 100%;
      max-height: 480px;
      height: auto;
      object-fit: contain;
      object-position: center;
      display: block;
      border-radius: 12px;
      box-shadow: 0 16px 36px -8px rgba(0, 0, 0, 0.16), 0 0 0 1px rgba(0, 0, 0, 0.05);
      transition: transform 0.4s ease;

      @media (max-width: 991px) {
        max-height: 320px;
        object-position: center;
      }

      &:hover {
        transform: scale(1.02);
      }
    }
  }

  // 3. Slider Controls (Bottom Right like screenshot)
  .slider-controls {
    position: absolute;
    right: clamp(1.5rem, 3vw, 3rem);
    bottom: clamp(1.25rem, 2.5vw, 2.25rem);
    display: flex;
    align-items: center;
    gap: 1.5rem;
    z-index: 10;

    @media (max-width: 991px) {
      position: static;
      justify-content: space-between;
      padding: 0 2rem 2rem;
      width: 100%;
      order: 3;
    }
  }

  .slider-dots {
    display: flex;
    align-items: center;
    gap: 0.5rem;

    .slider-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: rgba(61, 35, 60, 0.25);
      border: none;
      padding: 0;
      cursor: pointer;
      transition: all 0.25s ease;

      &.active {
        width: 24px;
        border-radius: 999px;
        background: #3d233c;
      }

      &:hover:not(.active) {
        background: rgba(61, 35, 60, 0.5);
      }
    }
  }

  .slider-arrows {
    display: flex;
    align-items: center;
    gap: 0.5rem;

    .arrow-btn {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: 1px solid rgba(61, 35, 60, 0.25);
      background: rgba(255, 255, 255, 0.7);
      backdrop-filter: blur(4px);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #3d233c;
      cursor: pointer;
      transition: all 0.2s ease;

      &:hover {
        background: #3d233c;
        color: #ffffff;
        border-color: #3d233c;
      }
    }
  }

  // Transitions
  .slide-enter {
    transition: opacity 0.4s ease-out, transform 0.4s ease-out;
  }
  .slide-enter-start {
    opacity: 0;
    transform: translateX(16px);
  }
  .slide-enter-end {
    opacity: 1;
    transform: translateX(0);
  }
  .slide-leave {
    transition: opacity 0.25s ease-in, transform 0.25s ease-in;
    position: absolute;
    inset: 0;
  }
  .slide-leave-start {
    opacity: 1;
  }
  .slide-leave-end {
    opacity: 0;
  }

  // ── All Projects Directory Grid ──
  .ProjectsGridSection {
    padding-top: var(--space-xl);
    // padding-bottom: var(--space-4xl);
  }

  .section-header {
    margin-bottom: var(--space-2xl);

    .section-eyebrow {
      text-transform: uppercase;
      font-size: 0.75rem;
      letter-spacing: 0.12em;
      font-weight: 700;
      color: var(--accent-start, #e2792e);
      margin-bottom: 0.5rem;
      display: block;
    }

    .section-title {
      font-size: clamp(1.75rem, 2.5vw, 2.4rem);
      font-weight: 300;
      margin: 0 0 0.5rem 0;
      color: var(--color-foreground, #f5f5f3);
    }

    .section-desc {
      color: var(--color-muted, #a8a7a1);
      font-size: 1rem;
      max-width: 60ch;
      margin: 0;
    }
  }

  .projects-thumbnail-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);

    @media (max-width: 991px) {
      grid-template-columns: repeat(2, 1fr);
    }

    @media (max-width: 600px) {
      grid-template-columns: 1fr;
    }
  }

  .project-thumb-card {
    background: #141518;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 1.25rem;
    overflow: hidden;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;

    &:hover {
      border-color: rgba(255, 255, 255, 0.25);
      transform: translateY(-4px);
      box-shadow: 0 16px 32px rgba(0, 0, 0, 0.4);
    }

    &.active-thumb {
      border-color: var(--accent-start, #e2792e);
      box-shadow: 0 0 0 2px rgba(226, 121, 46, 0.3);
    }

    .thumb-image-box {
      width: 100%;
      height: 200px;
      background: #0f1012;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.25rem;
      overflow: hidden;

      img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        transition: transform 0.3s ease;
      }
    }

    &:hover .thumb-image-box img {
      transform: scale(1.05);
    }

    .thumb-meta {
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      flex-grow: 1;

      .thumb-eyebrow {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--accent-start, #e22e2e);
        font-weight: 600;
        margin-bottom: 0.25rem;
      }

      .thumb-title {
        font-size: 1.15rem;
        font-weight: 500;
        color: var(--color-foreground, #f5f5f3);
        margin: 0 0 0.75rem 0;
      }

      .thumb-cta {
        margin-top: auto;
        font-size: 0.85rem;
        font-weight: 600;
        color: #a8a7a1;
        transition: color 0.2s ease;
      }
    }

    &:hover .thumb-cta {
      color: #ffffff;
    }
  }
</style>
