---
import Button from './ui/Button.astro';
export interface ProjectCard {
  variant: "content" | "image";
  id: string;
  data: Record<string, any>;
}

const projects: ProjectCard[] = [
  {
    variant: "content",
    id: "electro-core-systems",
    data: {
      href: "https://electrocoresystems.in/about-us/",
      logo: "/images/Electrocore_systems.jpg",
      logoAlt: "Electro Core Systems logo.",
      image: "/images/hardware23.jpg",
      imageAlt: "Seamless Integration graphic.",
      tag: "Empowering Communication. Connecting the Future",
      heading: "At Electro Core Systems, we believe communication is more than just connection",
      body: "We specialize in IP and VoIP-based communication solutions that simplify how people and devices interact. Our offerings range from IP telephony and unified communication systems to networking, video surveillance, and smart automation — creating an end-to-end connected experience for every user.",
    },
  },
  {
    variant: "content",
    id: "desk-essentials",
    data: {
      href: "#",
      image: "/images/hardware21.jpg",
      imageAlt: "Desk essentials kit.",
      tag: "Corporate Gifting",
      heading: "Building a Branded Desk Essentials Kit for Employees",
      body: "Every company wants new hires to feel welcomed and every employee to feel remembered — but a single email or a one-time gift card rarely does that job well. A branded desk essentials kit solves this differently: it puts your brand into daily use, not just a passing moment.",
    },
  },
  {
    variant: "content",
    id: "premium-diaries",
    data: {
      href: "#",
      image: "/images/hardware22.jpg",
      imageAlt: "Premium diaries.",
      tag: "Featured Products",
      heading: "Featured Premium Diaries",
      body: "A diary is the one gift that stays on your client's desk every single day of the year. Ours go further — fully customisable with your logo, colours, slogan, or imagery, each one becomes a branded keepsake worth holding onto. Choose your cover, personalise the pages, and let us craft a diary that truly reflects who you are.",
    },
  },
  {
    variant: "content",
    id: "pup-exports",
    data: {
      href: "https://pupexports.com/",
      logo: "/images/Pup_Logo.jpg",
      logoAlt: "PUP Exports logo.",
      image: "/images/hardware23.jpg",
      imageAlt: "Seamless Integration graphic.",
      tag: "PUP Exports Pvt Ltd",
      heading: "Let's Create Something Worth Keeping",
      body: "Whether you're looking for beautifully crafted customised diaries for your next corporate campaign, a curated set of leather gifts for a client event, or a fully bespoke range of vegan leather gifts that carry your brand with quiet confidence, we're ready to help.",
    },
  },
];
---

<section class="related">
  <div class="related__head">
    <h2 class="related__title">Related projects</h2>
    <div class="related__nav" data-reel-nav data-reel-id="track">
      <button class="nav-btn" data-dir="-1" aria-label="Previous project">
        <svg width="18" height="14" viewBox="0 0 18 14" fill="none">
          <path d="M17 7H1M1 7L7 1M1 7L7 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <div class="progress-bar">
        <div class="progress-fill" id="progressFill"></div>
      </div>
      <button class="nav-btn" data-dir="1" aria-label="Next project">
        <svg width="18" height="14" viewBox="0 0 18 14" fill="none">
          <path d="M1 7H17M17 7L11 1M17 7L11 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </div>

  <ul class="related__track" id="track">
    {projects.map((p) => (
      <li class={`card card--${p.variant}`} data-id={p.id}>
        {p.variant === "content" && (
          <div class="ShowcaseCard stack" data-gap="md">
            <a href={p.data.href} class="image" style="display:block; text-decoration:none; color:inherit;">
              <div class="frame" style="--frame-ratio: 3/2;">
                <img src={p.data.image} alt={p.data.imageAlt} style="border-radius: calc(var(--radius-md) - 2px); object-fit: cover; object-position: top;" loading="lazy" decoding="async" />
              </div>
            </a>
            
            <div class="stack content" data-gap="sm" style="flex-grow: 1;">
              <div class="card__logo-tile" style={!p.data.logo ? "visibility: hidden;" : ""}>
                {p.data.logo && (
                  <img src={p.data.logo} alt={p.data.logoAlt} loading="lazy" decoding="async" width="120" height="90" />
                )}
              </div>
              <span class="Tag" style={`--tag-color: var(--color-purple)`}>{p.data.tag}</span>
              <h3 class="heading" data-font-size="1"><a href={p.data.href} style="text-decoration:none; color:inherit;">{p.data.heading}</a></h3>
              <div class="prose card__body_text">
                <p>{p.data.body}</p>
              </div>
              <Button href={p.data.href} variant="secondary" style="align-self: flex-start; margin-top: auto; margin-bottom: 0;">
View Project <span class="icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span>
</Button>
            </div>
          </div>
        )}

        {p.variant === "image" && (
          <a href={p.data.href} class="card__frame">
            <img src={p.data.image} alt={p.data.imageAlt} loading="lazy" decoding="async" width="500" height="1086" />
            <span class="card__frame-overlay">
              <span class="card__frame-cta">
                View Project
                <svg width="14" height="10" viewBox="0 0 14 10" fill="none">
                  <path d="M1 5H13M13 5L9 1M13 5L9 9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </span>
          </a>
        )}
      </li>
    ))}
  </ul>
</section>

<script>
  const track = document.getElementById("track") as HTMLUListElement | null;
  const fill = document.getElementById("progressFill") as HTMLDivElement | null;
  const buttons = document.querySelectorAll<HTMLButtonElement>(".nav-btn");

  function updateProgress() {
    if (!track || !fill) return;
    const max = track.scrollWidth - track.clientWidth;
    const pct = max > 0 ? (track.scrollLeft / max) * 100 : 0;
    fill.style.width = `${pct}%`;
  }

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      if (!track) return;
      const dir = Number(btn.dataset.dir);
      const cardWidth = track.querySelector(".card")?.clientWidth ?? 320;
      track.scrollBy({ left: dir * (cardWidth + 24), behavior: "smooth" });
    });
  });

  track?.addEventListener("scroll", updateProgress, { passive: true });
  updateProgress();
</script>

<style>
  .related {
    background: #0d0d0d;
    color: #f5f5f3;
    padding: clamp(2.5rem, 5vw, 5rem) clamp(1.25rem, 4vw, 4rem);
    overflow: hidden;
  }

  .related__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
  }

  .related__title {
    font-family: var(--font-family-heading);
    font-weight: 300;
    font-size: clamp(1.9rem, 3.4vw, 2.9rem);
    letter-spacing: -0.01em;
    margin: 0;
    color: #f2f0ec;
  }

  .related__nav {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-shrink: 0;
  }

  .nav-btn {
    width: 42px;
    height: 42px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: transparent;
    color: #e9e7e2;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease;
    flex-shrink: 0;
  }
  .nav-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.3);
  }
  .nav-btn:focus-visible {
    outline: 2px solid #e9e7e2;
    outline-offset: 2px;
  }

  .progress-bar {
    width: 84px;
    height: 3px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    overflow: hidden;
  }
  .progress-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #e2792e, #f2c14e);
    box-shadow: 0 0 8px rgba(226, 121, 46, 0.6);
    transition: width 0.15s ease;
  }

  .related__track {
    display: flex;
    gap: 24px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 0 0 0.5rem;
    margin: 0;
    list-style: none;
    scrollbar-width: none;
  }
  .related__track::-webkit-scrollbar {
    display: none;
  }

  .card {
    scroll-snap-align: start;
    flex: 0 0 auto;
    width: 335px;
    border-radius: 20px;
    position: relative;
    overflow: hidden;
  }

  /* ---------- Content card (image + logo tile + copy) ---------- */
  .card--content {
    background: transparent;
    border: none;
  }

  .ShowcaseCard {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    height: 100%;
  }

  .card__logo-tile {
    width: 96px;
    height: 72px;
    border-radius: 8px;
    background: #202224;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px;
    margin-bottom: var(--space-xs);
  }
  .card__logo-tile img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .card__body_text p {
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--color-foreground-secondary);
    margin: 0;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card__logo-tile {
    width: 96px;
    height: 72px;
    border-radius: 8px;
    background: #202224;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px;
    margin-bottom: 16px;
  }
  .card__logo-tile img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .card__tag {
    display: inline-block;
    text-transform: uppercase;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    font-weight: 600;
    color: #c9a6ff;
    background: rgba(201, 166, 255, 0.1);
    border-radius: 999px;
    padding: 5px 12px;
    margin-bottom: 14px;
  }

  .card__heading {
    font-size: 1.15rem;
    line-height: 1.32;
    font-weight: 600;
    margin: 0 0 12px;
    color: #f5f4f0;
  }

  .card__body {
    font-size: 0.88rem;
    line-height: 1.55;
    color: #a8a7a1;
    margin: 0;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card__cta {
    margin-top: 20px;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #232527;
    color: #f5f4f0;
    border-radius: 8px;
    padding: 11px 16px;
    font-size: 0.86rem;
    font-weight: 600;
    transition: background 0.2s ease;
  }
  .card__link:hover .card__cta {
    background: #2d2f31;
  }

  /* ---------- Image-only card (phone-style frame) ---------- */
  .card--image {
    height: 100%;
    min-height: 480px;
    background: #17181a;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .card__frame {
    display: block;
    position: relative;
    height: 100%;
    width: 100%;
  }
  .card__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .card__frame-overlay {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    justify-content: flex-start;
    padding: 18px;
    background: linear-gradient(180deg, rgba(13, 13, 13, 0) 0%, rgba(13, 13, 13, 0.75) 100%);
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .card__frame:hover .card__frame-overlay,
  .card__frame:focus-visible .card__frame-overlay {
    opacity: 1;
  }

  .card__frame-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #f5f4f0;
    color: #17181a;
    border-radius: 8px;
    padding: 11px 16px;
    font-size: 0.86rem;
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .card {
      width: 78vw;
    }
    .card--image {
      height: 480px;
    }
    .related__nav {
      /* Show nav on mobile as requested */
      display: flex;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const track = document.getElementById('track') as HTMLElement;
    const nav = document.querySelector('[data-reel-nav]') as HTMLElement;
    if (!track || !nav) return;

    const prevBtn = nav.querySelector('[data-dir="-1"]') as HTMLElement | null;
    const nextBtn = nav.querySelector('[data-dir="1"]') as HTMLElement | null;
    const progressFill = document.getElementById('progressFill');

    function updateProgress() {
      const maxScroll = track.scrollWidth - track.clientWidth;
      const progress = maxScroll > 0 ? (track.scrollLeft / maxScroll) * 100 : 0;
      if (progressFill) progressFill.style.width = `${progress}%`;
      
      if (prevBtn) prevBtn.style.opacity = track.scrollLeft <= 5 ? "0.5" : "1";
      if (nextBtn) nextBtn.style.opacity = track.scrollLeft >= maxScroll - 5 ? "0.5" : "1";
    }

    track.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress);
    updateProgress();

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        track.scrollBy({ left: -track.clientWidth * 0.8, behavior: 'smooth' });
      });
    }
    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        track.scrollBy({ left: track.clientWidth * 0.8, behavior: 'smooth' });
      });
    }
  });
</script>