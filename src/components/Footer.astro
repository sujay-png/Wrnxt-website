---
const accreditations = [
  {
    name: "Agency Hackers",
    url: "https://salo.uk/_astro/accreditation-agency-hackers.CskRe8_T.png",
  },
  {
    name: "BIMA",
    url: "https://salo.uk/_astro/accreditation-bima.DOjLsDfZ.png",
  },
  { name: "Net", url: "https://salo.uk/_astro/accreditation-net.De0nr0fC.png" },
  {
    name: "Alliance of Independent Agencies",
    url: "https://salo.uk/_astro/accreditation-aia.B3ALZq9Y.png",
  },
];
---

<footer class="section footer" data-pt="lg">
  <div class="container" data-size="full">
    <div class="stack footer__main-stack" data-gap="3xl">
      <!-- Top Section: Logo & Direct Contacts -->
      <div class="footer__top">
        <div class="start">
          <a href="/" title="Go home.">
            <img
              class="footer__topLogo akshara-logo"
              src="/images/akshara-digital-logo.png"
              alt="Akshara Digital Logo"
            />
          </a>
          <span class="eyebrow"
            >Affordable & Quality IT Solutions Guaranteed</span
          >
        </div>

        <div class="end footer__contact">
          <a href="mailto:md@aksharadigital.com">md@aksharadigital.com</a>
          <a href="tel:+91 8123455500">+91 8123455500</a>
        </div>
      </div>

      <!-- Middle Section: Link Lists & Accreditations -->
      <div class="stack footer__middle" data-gap="xl">
        <div
          class="cluster"
          data-gap="lg"
          data-justify="between"
          data-align="start"
        >
          <div class="grid start" data-gap="xl" style="--grid-min:15rem;">
            <div class="column">
              <ul class="stack footer-menu" data-gap="xs">
                <li class="eyebrow">Our services</li>
                <li class="footer-menu-item">
                  <a class="footer-menu-link" href="/services/it-services"
                    >IT Service</a
                  >
                </li>
                <li class="footer-menu-item">
                  <a class="footer-menu-link" href="/services/website"
                    >Media House</a
                  >
                </li>
                <li class="footer-menu-item">
                  <a class="footer-menu-link" href="/services/branding"
                    >Markerting</a
                  >
                </li>
                <li class="footer-menu-item">
                  <a class="footer-menu-link" href="/services/flexi-design
                  "
                    >Hardware</a
                  >
                </li>
              </ul>
            </div>

            <nav class="column">
              <ul class="stack footer-menu" data-gap="xs">
                <li class="eyebrow">Useful links</li>
                <li class="footer-menu-item">
                  <a class="footer-menu-link" href="/projects/"
                    >Latest case studies</a
                  >
                </li>
                <li class="footer-menu-item">
                  <a class="footer-menu-link" href="/contact">Contact us</a>
                </li>
              </ul>
            </nav>

            <address class="column" style="font-style: normal;">
              <ul class="stack footer-menu" data-gap="xs">
                <li class="eyebrow">Address</li>
                <li class="footer-menu-item" style="font-size: var(--font-size--1); line-height: 1.7; opacity: 0.9;">
                  First Floor, 2-32/20(A),<br/>
                  Ganesh Nagar Rd, Jeppinamogaru,<br/>
                  Mangaluru, Karnataka 575007
                </li>
              </ul>
            </address>
          </div>

          <div class="end" style="width: 100%; max-width: 400px;">
            <div class="anchor-card anchor-card--rounded">
              <svg class="anchor-border" width="100%" height="100%" preserveAspectRatio="none">
                <rect x="3.5" y="3.5" width="calc(100% - 7px)" height="calc(100% - 7px)" rx="16" ry="16"></rect>
                <circle cx="19.5" cy="3.5" r="3"></circle>
                <circle cx="calc(100% - 19.5px)" cy="3.5" r="3"></circle>
                <circle cx="19.5" cy="calc(100% - 3.5px)" r="3"></circle>
                <circle cx="calc(100% - 19.5px)" cy="calc(100% - 3.5px)" r="3"></circle>
              </svg>
              <div class="anchor-content" style="padding: 6px; border-radius: 16px; height: 250px;">
                <iframe 
                  src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3889.8782942634734!2d74.8678111!3d12.8511365!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3ba35b29e497a84d%3A0x548ffac43130be9f!2sAkshara%20Digital%20India%20Private%20Limited!5e0!3m2!1sen!2sin!4v1790838525192!5m2!1sen!2sin" 
                  width="100%" 
                  height="100%" 
                  style="border:0; border-radius: 12px; filter: invert(90%) hue-rotate(180deg);" 
                  allowfullscreen="" 
                  loading="lazy" 
                  referrerpolicy="strict-origin-when-cross-origin">
                </iframe>
              </div>
            </div>
          </div>        </div>

        <!-- Copyright Row -->
        <div class="copyright">
          <div
            class="cluster"
            data-gap-x="lg"
            data-gap-y="sm"
            data-justify="start"
            data-align="center"
          >
            <span>© 2026 Akshara Digital. All rights reserved.</span>
            <a href="/environmental-sustainability/"
              >Environmental Sustainability</a
            >
            <a href="/privacy">Privacy Policy</a>
            <a href="/ai-policy">AI Policy</a>
          </div>
        </div>
        <!-- Section Divider -->
        <div
          class="reactive-divider horizontal"
          x-data="reactiveDivider({ orientation: 'horizontal', unit: 'px' })"
        >
          <div class="anchor start-anchor"><div class="anchor-circle"></div></div>
          <div class="divider-line" x-ref="dividerLine">
            <div class="width-display">ESTD 2022</div>
          </div>
          <div class="anchor end-anchor"><div class="anchor-circle"></div></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Cropped Logo watermark moved outside container so S is not cut off by padding -->
  <!-- <div class="footer__bottom" id="footer-bottom-logo">
  <svg class="footer__bottomLogo akshara-logo" viewBox="0 0 800 100" xmlns="http://www.w3.org/2000/svg" aria-label="Akshara Digital Logo.">
    <text x="0" y="80" font-family="var(--font-family-alt)" font-weight="700" font-size="100" fill="white">Akshara Digital</text>
  </svg>
</div> -->
</footer>

<style lang="scss">
  .footer {
    position: relative;
    z-index: 2;
    border-top: 1px solid var(--color-border);
    background-color: var(--color-bg);
    color: var(--color-foreground-secondary);
    padding-block-start: var(--space-xl);

    /*
      SPACING FIX: The container uses data-size="full" which removes padding-inline.
      We restore it directly on the footer's inner stack so all content is
      properly inset from the viewport edges — matching salo.uk's layout.
    */
    > .container > .stack {
      padding-inline: var(--container-padding, var(--space-md-2xl));
    }

    &__main-stack {
      @media (max-width: 767px) {
        gap: var(--space-xl) !important;
      }
    }

    a {
      transition: color 0.3s var(--ease);

      &:hover {
        color: var(--color-foreground);
      }
    }

    &__top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: var(--space-lg);
      border-bottom: 1px solid var(--color-border);
      padding-bottom: var(--space-md);

      @media (max-width: 1023px) {
        align-items: flex-end;
      }

      @media (max-width: 767px) {
        flex-direction: column;
        align-items: flex-start;
      }

      .start {
        display: flex;
        align-items: center;
        gap: var(--space-md);

        @media (max-width: 1023px) {
          flex-direction: column;
          align-items: flex-start;
          gap: var(--space-xs);
        }
      }
    }

    &__topLogo {
      height: 120px;
      width: auto;
      object-fit: contain;
      display: block;
    }

    &__contact {
      text-align: right;
      display: flex;
      flex-direction: column;
      gap: var(--space-4xs);
      font-family: var(--font-family-alt);
      font-size: var(--font-size-0);

      @media (max-width: 767px) {
        text-align: left;
        margin-top: var(--space-xs);
      }
    }

    &__middle {
      flex-grow: 1;
      padding-top: var(--space-md);

      .start {
        flex-grow: 1;
      }
    }

    .footer-menu {
      list-style: none;
      padding: 0;

      .eyebrow {
        font-size: var(--font-size--2);
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: var(--letter-spacing-looser);
        margin-bottom: var(--space-sm);
      }
    }

    .footer-menu-link {
      padding-block: 4px; // Reduced from var(--space-xs) to tighten vertical gap
      display: inline-block;
      position: relative;
      font-family: var(--font-family-body);
      font-size: var(--font-size--1);

      &::after {
        content: "";
        position: absolute;
        bottom: calc(var(--space-xs) - 2px);
        left: 0;
        width: 100%;
        height: 1px;
        background-color: currentColor;
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.3s ease;
      }

      &:hover::after {
        transform: scaleX(1);
        transform-origin: left;
      }

      &:not(:hover)::after {
        transform: scaleX(0);
        transform-origin: right;
      }
    }

    .copyright {
      font-size: var(--font-size--1);
      opacity: 0.8;
      border-top: 1px solid var(--color-border);
      padding-top: var(--space-md);

      .cluster {
        display: flex !important;
        flex-wrap: wrap !important;
        align-items: center !important;
        gap: 1.5rem !important;
      }

      a {
        color: inherit;
        text-decoration: none;
      }
    }

    &__bottom {
      overflow: hidden;
      padding-block-start: 4vh;
      margin-block-start: -4vh;
      width: 100%;
      display: flex;
      justify-content: center;
      align-items: center;
      box-sizing: border-box;
    }

    &__bottomLogo {
      width: 50%;
      max-width: 50%;
      margin: 0 auto;
      height: auto;
      margin-bottom: -3svh;
      display: block;
      will-change: transform;
      opacity: 0.88;

      path {
        fill: #ffffff !important;
      }
    }
  }
</style>
