---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ServiceHero from '../../components/servicehero.astro';
import ServiceCards from '../../components/servicescard.astro';
import StatsBar from '../../components/StatsBar.astro';
import TechStack from '../../components/TechStack.astro';
import Testimonials from '../../components/Testimonials.astro';
import { heroImages, services } from '../../data/services';
---

<Layout title="IT Services — WRNXT">
  <Header />

  <div class="bg-dots" aria-hidden="true"></div>

 <ServiceHero
  eyebrow="Our services"
  title="Smarter IT.
Stronger Business."
  desc="Your on-demand technology department. Clear your IT backlog and keep your systems running with our flexible, scalable support model. No long-term lock-in, only pay for what you need."
  ctaPrimary={{ label: "Packages & pricing", href: "/pricing" }}
  ctaSecondary={{ label: "How it works", href: "/how-it-works" }}
  images={heroImages}
/>

  <StatsBar />
  <ServiceCards services={services} />
  <TechStack />
  <Testimonials />
  <Footer />
</Layout>

<style>
  .bg-dots {
    position: fixed;
    inset: 0;
    background-image: radial-gradient(var(--color-border) 1px, transparent 1px);
    background-size: 24px 24px;
    opacity: 0.5;
    pointer-events: none;
    z-index: 0;
  }
</style>