            <p>Senior design expertise, embedded in your team.</p>
          </div>

          <div
            class="cluster actions"
            data-gap="sm"
            data-justify="start"
            data-align="center"
            data-reveal="true"
            data-reveal-delay="1.6"
            id="hero-actions"
          >
            <a
              href="/contact"
              class="btn size-md primary"
              x-data="buttonHover"
              @mousemove="handleMouseMove($event)"
              @mouseenter="handleMouseEnter()"
