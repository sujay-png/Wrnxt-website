---
const teamAvatars = [
   { name: "image1", url: "/images/image1.svg" },
  { name: "Bharth", url: "/images/Bharath.svg" },
  { name: "image2", url: "/images/image2.svg" },
  { name: "iraspa", url: "/images/iraspa.svg" },
  { name: "Sakrt", url: "/images/Sakrt.svg" },
  { name: "Sangam", url: "/images/sangam.svg" },
  { name: "Sanjeevini", url: "/images/Sanjeeveni.svg" },
  { name: "Vastu", url: "/images/Vastu.svg" },
];
---

<section class="section HomePartner" data-padding="xl">
  <div class="container">
    <div class="anchor-card anchor-card--rounded HomePartner__image">
      <svg class="anchor-border" width="100%" height="100%" preserveAspectRatio="none">
        <rect x="3.5" y="3.5" width="calc(100% - 7px)" height="calc(100% - 7px)" rx="16" ry="16"></rect>
        <circle cx="19.5" cy="3.5" r="3"></circle>
        <circle cx="calc(100% - 19.5px)" cy="3.5" r="3"></circle>
        <circle cx="19.5" cy="calc(100% - 3.5px)" r="3"></circle>
        <circle cx="calc(100% - 19.5px)" cy="calc(100% - 3.5px)" r="3"></circle>
      </svg>
      <div class="anchor-content">
        <div class="frame" style="--frame-ratio:4/3; --frame-pos:center;">
          <img src="https://media.salo.uk/salo-website-prod/Candid Team Photo 1.jpg" alt="A candid photo of the team working." loading="lazy" decoding="async" width="1800" height="1358" />
        </div>
      </div>
    </div>
    
    <div class="stack HomePartner__content" data-gap="lg">
      <h2 class="heading eyebrow">For agencies</h2>
      <span class="heading" data-font-size="5">Scale your team instantly. Zero overheads.</span>
      
      <div class="reactive-divider horizontal" x-data="reactiveDivider({ orientation: 'horizontal', unit: 'px' })">
        <div class="anchor start-anchor"><div class="anchor-circle"></div></div>
        <div class="divider-line" x-ref="dividerLine">
          <div class="width-display" x-text="formattedWidth" x-cloak>0px</div>
        </div>
        <div class="anchor end-anchor"><div class="anchor-circle"></div></div>
      </div>
      
      <div class="prose">
        <p>Our talent, your brand. We help you say "yes" to big projects without adding permanent payroll. Get white-label, development-ready execution that integrates seamlessly into your workflow.</p>
      </div>
      
      <div class="cluster actions" data-gap="sm" data-justify="start" data-align="center">
        <a href="/services/flexi-design" class="btn size-md secondary">
          <span class="btn-content">
            Partner with us
            <span class="icon" aria-hidden="true" role="img">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right">
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
            </span>
          </span>
        </a>
      </div>
    </div>
  </div>
</section>

<section class="section HomeWheel">
  <div class="container" data-size="full">
    <svg class="HomeWheel__motionPathSvg" viewBox="-400 0 1800 500" preserveAspectRatio="none">
      <path class="HomeWheel__motionPath" d="M-400,150 C200,450 800,450 1400,150" fill="none" stroke="none"></path>
    </svg>
    
    <div class="HomeWheel__contentWrapper">
      <div class="stack HomeWheel__contentBlock" data-gap="md" data-align="center" data-justify="center" data-block="1">
        <div class="AvatarWidget gradient-border">
          <div class="inner">
            <div class="AvatarStack" style="--avatar-size:2rem; --avatar-overlap:4px;">
              {teamAvatars.map((member, idx) => (
                <div class="Avatar gradient-border" style={`z-index:${idx}`}>
                  <div class="frame inner" style="--frame-ratio:1/1;">
                    <img src={member.url} alt={member.name} loading="lazy" width="64" height="64" />
                  </div>
                </div>
              ))}
              <div class="Avatar add gradient-border" style="z-index:8">
                <div class="center inner" data-align="center" data-justify="center">
                  <span class="icon" style="--icon-size:1em;" aria-hidden="true" role="img">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus">
                      <path d="M5 12h14"></path>
                      <path d="M12 5v14"></path>
                    </svg>
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <h3 class="heading" data-font-size="4">Direct access to expert talent</h3>
        <div class="prose prose--md">
          <p>You don't deal with account managers; you speak directly to the creatives solving your problem. With every project guided by senior leadership, you get the firepower of a full agency team without the administrative bloat.</p>
        </div>
        
        <div class="cluster actions" data-gap="sm" data-justify="center" data-align="center">
          <a href="/about#team" class="btn size-md secondary">
            <span class="btn-content">
              Meet the makers
              <span class="icon" aria-hidden="true" role="img">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right">
                  <path d="M5 12h14"></path>
                  <path d="m12 5 7 7-7 7"></path>
                </svg>
              </span>
            </span>
          </a>
        </div>
      </div>

      <div class="stack HomeWheel__contentBlock" data-gap="md" data-align="center" data-justify="center" data-block="2">
        <div class="FigmaToolWidget gradient-border">
          <div class="cluster inner" data-gap="xs" data-justify="start" data-align="center">
            <div class="icon gradient-border">
              <div class="inner">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 3 7.07 16.97 2.51-7.39 7.39-2.51L3 3z"/></svg>
              </div>
            </div>
            <div class="icon gradient-border">
              <div class="inner">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18M3 15h18M9 3v18M15 3v18"/></svg>
              </div>
            </div>
            <div class="icon gradient-border">
              <div class="inner">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10H7z"/><path d="M12 2v5M12 17v5M2 12h5M17 12h5"/></svg>
              </div>
            </div>
          </div>
        </div>
        
        <h3 class="heading" data-font-size="4">Less Downtime. More Action.</h3>
        <div class="prose prose--md">
          <p>Stop wasting your time juggling freelancers. We are a multidisciplinary on-tap team that works as a single unit. We share context, files, and skills, so you get seamless creative experiences with zero hassle.</p>
        </div>
        
        <div class="cluster actions" data-gap="sm" data-justify="center" data-align="center">
          <a href="#" class="btn size-md secondary">
            <span class="btn-content">
              Our process
              <span class="icon" aria-hidden="true" role="img">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right">
                  <path d="M5 12h14"></path>
                  <path d="m12 5 7 7-7 7"></path>
                </svg>
              </span>
            </span>
          </a>
        </div>
      </div>

      <div class="stack HomeWheel__contentBlock" data-gap="md" data-align="center" data-justify="center" data-block="3">
        <a href="#" class="FigmaWidget gradient-border">
          <div class="cluster inner" data-gap="sm" data-justify="start" data-align="center">
            <div class="icon gradient-border">
              <div class="iconInner">
                <svg width="17" height="26" viewBox="0 0 17 26" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M4.25 26C1.90279 26 0 24.0972 0 21.75C0 19.4028 1.90279 17.5 4.25 17.5H8.5V21.75C8.5 24.0972 6.59721 26 4.25 26Z" fill="#0ACF83"/>
                  <path d="M0 13C0 10.6528 1.90279 8.75 4.25 8.75H8.5V17.25H4.25C1.90279 17.25 0 15.3472 0 13Z" fill="#A259FF"/>
                  <path d="M0 4.25C0 1.90279 1.90279 0 4.25 0H8.5V8.5H4.25C1.90279 8.5 0 6.59721 0 4.25Z" fill="#F24E1E"/>
                  <path d="M8.5 0H12.75C15.0972 0 17 1.90279 17 4.25C17 6.59721 15.0972 8.5 12.75 8.5H8.5V0Z" fill="#FF7262"/>
                  <path d="M12.75 8.75C15.0972 8.75 17 10.6528 17 13C17 15.3472 15.0972 17.25 12.75 17.25C10.4028 17.25 8.5 15.3472 8.5 13C8.5 10.6528 10.4028 8.75 12.75 8.75Z" fill="#1ABCFE"/>
                </svg>
              </div>
            </div>
            <span class="content">Using the best tools</span>
          </div>
        </a>
        
        <h3 class="heading" data-font-size="4">The Wrnxt Standard</h3>
        <div class="prose prose--md">
          <p>WRNXT is a leading information technology, online reputation management and digital marketing company dedicated to delivering exceptional services to clients.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  // Part 1: HomePartner Styles
  .HomePartner {
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-bg);
    padding-block: var(--space-3xl-5xl);
    
    .container {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-4xl-6xl);
      align-items: center;
      
      @media (max-width: 1023px) {
        display: flex;
        flex-direction: column-reverse;
        gap: var(--space-2xl);
      }
    }
    
    &__image, &__content {
      width: 100%;
      will-change: transform;
    }
  }

  // Part 2: HomeWheel Styles
  .HomeWheel {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-3xl-5xl);
    border-bottom: 1px solid var(--color-border);
    background-color: transparent;
    
    @media (min-width: 1024px) {
      height: 100vh;
      padding-block: 0;
    }
    
    &__motionPathSvg {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 1;
      transform: translateY(-10%);
      display: none;
      
      @media (min-width: 1024px) {
        display: block;
      }
    }
    
    &__contentWrapper {
      z-index: 5;
      
      @media (min-width: 1024px) {
        position: absolute;
        inset: 0;
        pointer-events: none;
      }
      
      @media (max-width: 1023px) {
        display: flex;
        flex-direction: column;
        gap: var(--space-3xl);
        max-width: var(--measure-lg);
        margin-inline: auto;
        padding-inline: var(--space-md);
      }
    }
    
    &__contentBlock {
      text-align: center;
      max-width: var(--measure);
      margin-inline: auto;
      
      @media (min-width: 1024px) {
        position: absolute;
        width: 30vw; 
        left: 0;
        top: 0;
        pointer-events: auto;
        will-change: transform;
      }
    }
  }

  // Internal component widgets alignment resets
  .AvatarWidget, .FigmaToolWidget, .FigmaWidget {
    margin-inline: auto; 
    margin-bottom: var(--space-xs);
  }

  .AvatarWidget {
    --border-radius: var(--radius-sm);
    display: inline-block;
    
    .inner {
      padding: var(--space-2xs);
      display: flex;
      background: var(--color-bg-alt);
    }
  }

  .AvatarStack {
    display: inline-flex;
    align-items: center;
    
    .Avatar {
      --border-radius: var(--radius-full);
      width: var(--avatar-size);
      height: var(--avatar-size);
      overflow: hidden;
      display: grid;
      place-items: center;
      background: var(--color-bg);
      
      &:not(:first-child) {
        margin-left: calc(var(--avatar-overlap) * -1);
      }
      
      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      
      &.add {
        .center {
          background: var(--color-bg-alt);
          width: 100%;
          height: 100%;
          display: grid;
          place-items: center;
          font-size: var(--font-size--2);
        }
      }
    }
  }

  .FigmaToolWidget {
    --border-radius: var(--radius-sm);
    display: inline-block;
    
    .inner {
      padding: var(--space-2xs);
      background: var(--color-bg-alt);
    }
    
    .icon {
      --border-radius: var(--radius-sm);
      display: inline-block;
      
      .inner {
        display: grid;
        place-items: center;
        width: 2.25rem;
        height: 2.25rem;
        background: var(--color-bg);
        color: var(--color-foreground-secondary);
      }
    }
  }

  .FigmaWidget {
    --border-radius: var(--radius-md);
    font-family: var(--font-family-alt);
    font-size: var(--font-size--1);
    display: inline-block;
    text-decoration: none;
    color: inherit;
    
    .inner {
      padding: var(--space-2xs) var(--space-sm) var(--space-2xs) var(--space-2xs);
      background: var(--color-bg-alt);
    }
    
    .icon {
      --border-radius: var(--radius-sm);
      width: 2.5rem;
      height: 2.5rem;
      display: grid;
      place-items: center;
      background: var(--color-bg);
    }
    
    .content {
      color: var(--color-foreground-secondary);
    }
  }
</style>