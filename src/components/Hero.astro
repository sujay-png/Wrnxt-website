      </div>
    </div>

    <div
      class="HomeHero__bottom"
      id="hero-marquee"
      data-reveal="blur"
      data-reveal-delay="2"
    >
      <div class="marquee" data-marquee-speed="24">
        <div class="marquee__track">
          <!-- <ul class="marquee__content">
            {clientLogos.map((logo) => (
              <li class="marquee__item">
                <img src={logo.url} alt={`${logo.name} Logo.`} loading="lazy" decoding="async" width="160" height="120" />
              </li>
            ))}
          </ul>
          <ul class="marquee__content" aria-hidden="true">
            {clientLogos.map((logo) => (
